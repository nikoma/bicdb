t.typed_table_missing_type|CREATE TABLE ttt4 OF nothing_tt
t.typed_table_not_composite|CREATE TYPE ttyp5 AS ENUM ('a'); CREATE TABLE ttt5 OF ttyp5
t.typed_table_row_type|CREATE TABLE ttt6_stuff (id int); CREATE TABLE ttt6 OF ttt6_stuff
t.typed_table_bad_column|CREATE TYPE ttyp7 AS (id int, name text); CREATE TABLE ttt7 OF ttyp7 (myname WITH OPTIONS NOT NULL)
t.typed_table_twice|CREATE TYPE ttyp8 AS (id int, name text); CREATE TABLE ttt8 OF ttyp8 (name WITH OPTIONS NOT NULL, name WITH OPTIONS DEFAULT '')
t.typed_table_add_column|CREATE TYPE ttyp9 AS (id int, name text); CREATE TABLE ttt9 OF ttyp9; ALTER TABLE ttt9 ADD COLUMN c text
t.typed_table_drop_column|CREATE TYPE ttyp10 AS (id int, name text); CREATE TABLE ttt10 OF ttyp10; ALTER TABLE ttt10 DROP COLUMN name
t.typed_table_rename_column|CREATE TYPE ttyp11 AS (id int, name text); CREATE TABLE ttt11 OF ttyp11; ALTER TABLE ttt11 RENAME COLUMN id TO num
t.typed_table_alter_type|CREATE TYPE ttyp12 AS (id int, name text); CREATE TABLE ttt12 OF ttyp12; ALTER TABLE ttt12 ALTER COLUMN name TYPE varchar
t.typed_table_inherit|CREATE TYPE ttyp13 AS (id int, name text); CREATE TABLE ttt13 OF ttyp13; CREATE TABLE ttt13_s (id int); ALTER TABLE ttt13 INHERIT ttt13_s
t.typed_table_drop_type_restrict|CREATE TYPE ttyp14 AS (id int, name text); CREATE TABLE ttt14 OF ttyp14; DROP TYPE ttyp14 RESTRICT
t.typed_table_drop_type_cascade|CREATE TYPE ttyp15 AS (id int, name text); CREATE TABLE ttt15 OF ttyp15; DROP TYPE ttyp15 CASCADE; SELECT count(*) FROM pg_class WHERE relname = 'ttt15'
t.typed_table_alter_composite|CREATE TYPE ttyp16 AS (id int, name text); CREATE TABLE ttt16 OF ttyp16; ALTER TYPE ttyp16 ADD ATTRIBUTE c text
t.typed_table_if_not_exists|CREATE TYPE ttyp17 AS (id int, name text); CREATE TABLE ttt17 OF ttyp17; CREATE TABLE IF NOT EXISTS ttt17 OF ttyp17; SELECT count(*) FROM ttt17
