tc_sel8|CREATE TABLE tc_sel8(t varchar);INSERT INTO tc_sel8 VALUES ('34.5');SELECT t::int8 FROM tc_sel8
tc_cast|CREATE TABLE tc_cast(t text);INSERT INTO tc_cast VALUES ('34.5');SELECT CAST(t AS integer) FROM tc_cast
tc_expr|CREATE TABLE tc_expr(t text);INSERT INTO tc_expr VALUES ('34');SELECT (t || '.5')::int4 FROM tc_expr
tc_where|CREATE TABLE tc_where(t text);INSERT INTO tc_where VALUES ('34.5');SELECT 1 FROM tc_where WHERE t::int4 = 35
tc_order|CREATE TABLE tc_order(t text);INSERT INTO tc_order VALUES ('34.5'),('1');SELECT t FROM tc_order ORDER BY t::int4
tc_join|CREATE TABLE tc_ja(t text);CREATE TABLE tc_jb(i int);INSERT INTO tc_ja VALUES ('34.5');INSERT INTO tc_jb VALUES (35);SELECT * FROM tc_ja JOIN tc_jb ON tc_ja.t::int4 = tc_jb.i
tc_view|CREATE TABLE tc_view(t text);INSERT INTO tc_view VALUES ('34.5');CREATE VIEW tc_view_v AS SELECT t::int4 AS i FROM tc_view;SELECT * FROM tc_view_v
tc_param|PREPARE tc_param(text) AS SELECT $1::int4;EXECUTE tc_param('34.5')
tc_sub|SELECT x::int4 FROM (SELECT '34.5'::text AS x) s
tc_cte|WITH c AS (SELECT '34.5'::text AS x) SELECT x::int4 FROM c
tc_values|SELECT x::int4 FROM (VALUES ('34.5')) v(x)
