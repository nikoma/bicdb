evt.bad_return|CREATE EVENT TRIGGER s_e1 ON ddl_command_start EXECUTE PROCEDURE pg_backend_pid()
evt.missing_function|CREATE EVENT TRIGGER s_e2 ON ddl_command_start EXECUTE FUNCTION s_no_such_fn()
evt.bad_event|CREATE FUNCTION s_f3() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e3 ON elephant_bootstrap EXECUTE PROCEDURE s_f3()
evt.bad_filter|CREATE FUNCTION s_f4() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e4 ON ddl_command_start WHEN food IN ('sandwich') EXECUTE PROCEDURE s_f4()
evt.bad_tag|CREATE FUNCTION s_f5() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e5 ON ddl_command_start WHEN tag IN ('create table', 'create skunkcabbage') EXECUTE PROCEDURE s_f5()
evt.global_tag|CREATE FUNCTION s_f6() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e6 ON ddl_command_start WHEN tag IN ('CREATE ROLE') EXECUTE PROCEDURE s_f6()
evt.dup_filter|CREATE FUNCTION s_f7() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e7 ON ddl_command_start WHEN tag IN ('create table') AND tag IN ('CREATE FUNCTION') EXECUTE PROCEDURE s_f7()
evt.args|CREATE FUNCTION s_f8() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'x'; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e8 ON ddl_command_start EXECUTE PROCEDURE s_f8('argument not allowed')
evt.fire|CREATE FUNCTION s_f9() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'evt: % %', tg_event, tg_tag; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e9a ON ddl_command_start EXECUTE PROCEDURE s_f9(); CREATE EVENT TRIGGER s_e9b ON ddl_command_end WHEN TAG IN ('CREATE TABLE', 'drop table', 'COMMENT', 'GRANT', 'CREATE FUNCTION', 'ALTER TABLE', 'CREATE INDEX', 'CREATE TABLE AS') EXECUTE FUNCTION s_f9(); CREATE TABLE s_t9 (a int); ALTER TABLE s_t9 ADD COLUMN b int; CREATE INDEX s_i9 ON s_t9 (a); COMMENT ON TABLE s_t9 IS 'c'; GRANT SELECT ON s_t9 TO PUBLIC; CREATE TABLE s_t9b AS SELECT 1 AS x; INSERT INTO s_t9 VALUES (1); SELECT count(*) FROM s_t9; DROP TABLE s_t9, s_t9b; SELECT evtname, evtevent, evtenabled, evttags FROM pg_event_trigger WHERE evtname LIKE 's_e9%' ORDER BY 1; DROP EVENT TRIGGER s_e9a; DROP EVENT TRIGGER s_e9b
evt.nested|CREATE FUNCTION s_f10() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'evt: % %', tg_event, tg_tag; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e10 ON ddl_command_start EXECUTE PROCEDURE s_f10(); CREATE FUNCTION s_g10() RETURNS int LANGUAGE plpgsql AS $$ BEGIN CREATE TABLE s_t10 (a int); RETURN 0; END $$; SELECT s_g10(); DO $$ BEGIN EXECUTE 'CREATE TABLE s_t10b (a int)'; END $$; DROP EVENT TRIGGER s_e10
evt.enable_disable|CREATE FUNCTION s_f11() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'evt: % %', tg_event, tg_tag; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e11 ON ddl_command_start EXECUTE PROCEDURE s_f11(); ALTER EVENT TRIGGER s_e11 DISABLE; CREATE TABLE s_t11a (a int); ALTER EVENT TRIGGER s_e11 ENABLE REPLICA; CREATE TABLE s_t11c (a int); ALTER EVENT TRIGGER s_e11 ENABLE ALWAYS; CREATE TABLE s_t11d (a int); SELECT evtenabled FROM pg_event_trigger WHERE evtname = 's_e11'; ALTER EVENT TRIGGER s_e11 ENABLE; CREATE TABLE s_t11e (a int); DROP EVENT TRIGGER s_e11
evt.end_error_rolls_back_check|CREATE FUNCTION s_f13() RETURNS event_trigger AS $$ BEGIN RAISE EXCEPTION 'no %', tg_tag; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e13 ON ddl_command_end WHEN TAG IN ('CREATE TABLE') EXECUTE PROCEDURE s_f13(); DO $$ BEGIN BEGIN CREATE TABLE s_t13 (a int); EXCEPTION WHEN OTHERS THEN RAISE NOTICE 'caught %', SQLERRM; END; END $$; SELECT count(*) FROM pg_class WHERE relname = 's_t13'; DROP EVENT TRIGGER s_e13
evt.rename_owner|DROP ROLE IF EXISTS s_er1; CREATE ROLE s_er1; CREATE FUNCTION s_f14() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e14 ON ddl_command_start EXECUTE PROCEDURE s_f14(); CREATE EVENT TRIGGER s_e14b ON ddl_command_start EXECUTE PROCEDURE s_f14(); ALTER EVENT TRIGGER s_e14 RENAME TO s_e14c; SELECT evtname FROM pg_event_trigger WHERE evtname LIKE 's_e14%' ORDER BY 1; ALTER EVENT TRIGGER s_e14c OWNER TO s_er1
evt.rename_conflict|CREATE FUNCTION s_f15() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e15 ON ddl_command_start EXECUTE PROCEDURE s_f15(); CREATE EVENT TRIGGER s_e15b ON ddl_command_start EXECUTE PROCEDURE s_f15(); ALTER EVENT TRIGGER s_e15 RENAME TO s_e15b
evt.drop_missing|DROP EVENT TRIGGER IF EXISTS s_no_evt; DROP EVENT TRIGGER s_no_evt
evt.nonsuper|DROP ROLE IF EXISTS s_er2; CREATE ROLE s_er2; CREATE FUNCTION s_f16() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; SET ROLE s_er2; CREATE EVENT TRIGGER s_e16 ON ddl_command_start EXECUTE PROCEDURE s_f16()
evt.sql_drop_refused|CREATE FUNCTION s_f17() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e17 ON sql_drop EXECUTE PROCEDURE s_f17()
evt.rewrite_oid_outside|SELECT pg_event_trigger_table_rewrite_oid()
evt.comment|CREATE FUNCTION s_f18() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e18 ON ddl_command_start EXECUTE PROCEDURE s_f18(); COMMENT ON EVENT TRIGGER s_e18 IS 'test comment'; COMMENT ON EVENT TRIGGER s_no_evt IS 'x'
evt.drop_role_owner|DROP ROLE IF EXISTS s_er3; CREATE ROLE s_er3 SUPERUSER; CREATE FUNCTION s_f19() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e19 ON ddl_command_start EXECUTE PROCEDURE s_f19(); ALTER EVENT TRIGGER s_e19 OWNER TO s_er3; DROP ROLE s_er3
evt.ddl_commands_outside|SELECT * FROM pg_event_trigger_ddl_commands()
evt.call_plain|CREATE FUNCTION s_f20() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; SELECT s_f20()
evt.rollback|BEGIN; CREATE FUNCTION s_f21() RETURNS event_trigger AS $$ BEGIN END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e21 ON ddl_command_start EXECUTE PROCEDURE s_f21(); ROLLBACK; SELECT count(*) FROM pg_event_trigger WHERE evtname = 's_e21'
evt.tags_more|CREATE FUNCTION s_f22() RETURNS event_trigger AS $$ BEGIN RAISE NOTICE 'evt: % %', tg_event, tg_tag; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e22 ON ddl_command_end EXECUTE PROCEDURE s_f22(); CREATE OR REPLACE FUNCTION s_g22() RETURNS int LANGUAGE sql AS 'SELECT 1'; CREATE VIEW s_v22 AS SELECT 1 AS x; CREATE SEQUENCE s_q22; CREATE SCHEMA s_sch22; CREATE TABLE s_sch22.s_t22 (a int); CREATE TYPE s_ty22 AS (a int); CREATE DOMAIN s_d22 AS int; DROP DOMAIN s_d22; DROP TYPE s_ty22; DROP SCHEMA s_sch22 CASCADE; DROP SEQUENCE s_q22; DROP VIEW s_v22; DROP FUNCTION s_g22(); CREATE ROLE s_er22x; DROP ROLE s_er22x; SELECT 1; DROP EVENT TRIGGER s_e22
evt.ddl_commands_inside|CREATE FUNCTION s_f23() RETURNS event_trigger AS $$ DECLARE r record; BEGIN FOR r IN SELECT * FROM pg_event_trigger_ddl_commands() LOOP RAISE NOTICE '%', r.command_tag; END LOOP; END $$ LANGUAGE plpgsql; CREATE EVENT TRIGGER s_e23 ON ddl_command_end EXECUTE PROCEDURE s_f23(); CREATE TABLE s_t23 (a int)
