+// Test-only capture: run on the historical writer before the safe default exists.
+fn capture_historical_gap(name: &str, dir: &Path, truth: serde_json::Value) {
+    let Some(root) = std::env::var_os("BICDB_CAPTURE_HISTORICAL_GAP") else { return; };
+    let root = PathBuf::from(root);
+    std::fs::create_dir_all(&root).unwrap();
+    let mut files = Vec::new();
+    for entry in std::fs::read_dir(dir).unwrap() {
+        let path = entry.unwrap().path();
+        assert!(path.is_file(), "fixture capture expects flat store files");
+        let bytes = std::fs::read(&path).unwrap();
+        files.push(serde_json::json!({"name":path.file_name().unwrap().to_str().unwrap(),
+            "bytes_hex":hex::encode(&bytes), "size":bytes.len(),
+            "sha256":hex::encode(Sha256::digest(&bytes))}));
+    }
+    files.sort_by_key(|v| v["name"].as_str().unwrap().to_owned());
+    let value = serde_json::json!({"format":1,"writer_commit":"0af1b55e3d586d4a6933098419e7ee46a7ae5a79",
+        "case":name,"truth":truth,"files":files});
+    use std::io::Write;
+    let mut out=std::fs::OpenOptions::new().write(true).create_new(true).open(root.join(format!("{name}.json"))).unwrap();
+    out.write_all(&serde_json::to_vec(&value).unwrap()).unwrap();
+}
