{
  "format": 1,
  "scope": "DECODE scalar SQL values, null equality, nonpadded character comparisons, selected conversions and lazy searches/results under fixed default NLS settings; not full NLS or numeric precedence for binary floating point",
  "cases": [
    {
      "id": "number_match",
      "sql": "SELECT DECODE(1,1,'match','fallback') FROM DUAL",
      "expected": [
        [
          "match"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "null_match",
      "sql": "SELECT DECODE(NULL,NULL,'match','fallback') FROM DUAL",
      "expected": [
        [
          "match"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "empty_match",
      "sql": "SELECT DECODE('',NULL,'match','fallback') FROM DUAL",
      "expected": [
        [
          "match"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "number_comparison",
      "sql": "SELECT DECODE('001',1,'match','fallback') FROM DUAL",
      "expected": [
        [
          "match"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "text_comparison",
      "sql": "SELECT DECODE(1,'001','match','fallback') FROM DUAL",
      "expected": [
        [
          "fallback"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "char_width",
      "sql": "SELECT DECODE(CAST('x' AS CHAR(3)),CAST('x' AS CHAR(1)),'match','fallback') FROM DUAL",
      "expected": [
        [
          "fallback"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "char_padding",
      "sql": "SELECT DECODE(CAST('x' AS CHAR(3)),'x  ','match','fallback') FROM DUAL",
      "expected": [
        [
          "match"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "lazy_default",
      "sql": "SELECT DECODE(1,1,7,CAST('bad' AS NUMBER)) FROM DUAL",
      "expected": [
        [
          {
            "number": "7"
          }
        ]
      ],
      "oracle_type": "DB_TYPE_NUMBER",
      "bicdb_type_oid": 1700
    },
    {
      "id": "null_first_result",
      "sql": "SELECT DECODE(2,1,NULL,2,7,'bad') FROM DUAL",
      "expected": [
        [
          "7"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "null_default",
      "sql": "SELECT DECODE(3,1,NULL,2,7,'bad') FROM DUAL",
      "expected": [
        [
          "bad"
        ]
      ],
      "oracle_type": "DB_TYPE_VARCHAR",
      "bicdb_type_oid": 25
    },
    {
      "id": "unselected_conversion",
