    "CREATE TABLE type_matrix_network_operations (id int4 PRIMARY KEY, address inet NOT NULL);",
    "INSERT INTO type_matrix_network_operations VALUES (1, '192.168.1.1/24'), (2, '192.168.1.0/25'), (3, '192.168.0.255/32'), (4, '192.168.1.200/24');",
