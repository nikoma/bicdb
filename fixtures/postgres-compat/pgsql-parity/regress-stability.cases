order_alias_constant|SELECT 1 AS x ORDER BY x
order_position_constant|SELECT 1 ORDER BY 1
order_rollup_alias|select 1 as one group by rollup(one) order by one nulls first
infinite_recurse|create function s1_infinite_recurse() returns int as 'select s1_infinite_recurse()' language sql;select s1_infinite_recurse()
array_fill_empty|select a, a = '{}' as is_eq, array_dims(a) from (select array_fill(42, '{}') as a) ss
array_fill_empty_lb|select a, a = '{}' as is_eq, array_dims(a) from (select array_fill(42, '{}', '{}') as a) ss
date_bin_overflow|select date_bin('15 minutes'::interval, timestamp '294276-12-30', timestamp '4000-12-20 BC')
date_bin_overflow_tz|select date_bin('15 minutes'::interval, timestamptz '294276-12-30', timestamptz '4000-12-20 BC')
date_input_too_large|SELECT pg_input_is_valid('6874898-01-01', 'date')
to_timestamp_infinity|SELECT to_timestamp(' Infinity'::float), to_timestamp('-Infinity'::float)
window_rows_huge|CREATE TEMP TABLE s4w(a int);INSERT INTO s4w VALUES (1),(2),(3);SELECT a, sum(a) over (order by a rows between 9223372036854775807 following and 1 following) FROM s4w ORDER BY a
window_groups_huge|CREATE TEMP TABLE s4g(a int);INSERT INTO s4g VALUES (1),(2),(2),(3);SELECT a, sum(a) over (order by a groups between current row and 9223372036854775807 following) FROM s4g ORDER BY a
copy_missing_relation|COPY s3_no_such_table FROM STDIN;
to_timestamp_nan|SELECT to_timestamp('NaN'::float)
to_timestamp_huge|SELECT to_timestamp(1e20)
cte_limit_infinite|WITH RECURSIVE t(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM t) SELECT * FROM t LIMIT 5
cte_limit_offset|WITH RECURSIVE t(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM t) SELECT * FROM t LIMIT 3 OFFSET 2
exists_outer_gate|CREATE TEMP TABLE s6o(id int, y int);CREATE TEMP TABLE s6i(x int);INSERT INTO s6o VALUES (1,1),(2,10),(3,NULL);INSERT INTO s6i VALUES (1),(2),(3);SELECT id FROM s6o WHERE EXISTS (SELECT 1 FROM s6i WHERE s6i.x = s6o.id AND s6o.y > 5) ORDER BY id;SELECT id FROM s6o WHERE NOT EXISTS (SELECT 1 FROM s6i WHERE s6i.x = s6o.id AND s6o.y > 5) ORDER BY id;SELECT id FROM s6o WHERE EXISTS (SELECT count(*) FROM s6i WHERE s6o.y > 1000) ORDER BY id
cte_nested_limit|CREATE TEMP TABLE s7d (id int PRIMARY KEY, parent_department int, name text);INSERT INTO s7d VALUES (0, NULL, 'ROOT'),(1, 0, 'A'),(2, 1, 'B'),(3, 2, 'C'),(4, 2, 'D'),(5, 0, 'E'),(6, 4, 'F'),(7, 5, 'G');with recursive q as (select * from s7d union all (with recursive x as (select * from s7d union all (select * from q union all select * from x)) select * from x)) select * from q limit 32
cte_nested_limit24|CREATE TEMP TABLE s7e (id int PRIMARY KEY, parent_department int, name text);INSERT INTO s7e VALUES (0, NULL, 'ROOT'),(1, 0, 'A'),(2, 1, 'B'),(3, 2, 'C'),(4, 2, 'D'),(5, 0, 'E'),(6, 4, 'F'),(7, 5, 'G');with recursive q as (select * from s7e union all (with recursive x as (select * from s7e union all (select * from x)) select * from x)) select * from q limit 24
lateral_hoist|CREATE TEMP TABLE s8l (lid int, ten int);CREATE TEMP TABLE s8r (k int, ten int, flag bool);INSERT INTO s8l VALUES (1, 10), (2, 20), (3, 30), (NULL, 40);INSERT INTO s8r VALUES (1, 1, true), (1, 2, false), (2, 5, true), (NULL, 7, true);SELECT s8l.lid, ss.x FROM s8l LEFT JOIN LATERAL (SELECT s8l.ten + s8r.ten AS x, s8r.k FROM s8r) ss ON s8l.lid = ss.k ORDER BY s8l.lid NULLS LAST, ss.x
statement_timeout_sleep|SET statement_timeout = '300ms';SELECT pg_sleep(3)
