ctas.basic|CREATE TABLE ctas_b1 AS SELECT generate_series(1,3) a; SELECT a FROM ctas_b1 ORDER BY a
ctas.column_types|CREATE TABLE ctas_t1(i int, v varchar(10), n numeric(8,2), ts timestamp(3), c char(4), b bigint, f float8, d date, bo boolean, j jsonb, arr int[]); CREATE TABLE ctas_t2 AS SELECT i, v, n, ts, c, b, f, d, bo, j, arr, i+1, 'lit' AS lit, 1.5 AS lit_num, v::varchar(3) AS v3, n::numeric(4,1) AS n4, 'x'::text AS t, NULL AS nul, b*2 AS b2 FROM ctas_t1; SELECT attname, format_type(atttypid, atttypmod), attnotnull FROM pg_attribute WHERE attrelid='ctas_t2'::regclass AND attnum>0 ORDER BY attnum
ctas.rows|CREATE TABLE ctas_r1(i int, v varchar(10), n numeric(8,2)); INSERT INTO ctas_r1 VALUES (1,'x',1.5),(2,NULL,2.25),(3,'zz',NULL); CREATE TABLE ctas_r2 AS SELECT i, v, n, i*10 AS t FROM ctas_r1 WHERE i < 3; SELECT * FROM ctas_r2 ORDER BY i
ctas.column_names|CREATE TABLE ctas_c1(x, y) AS SELECT 1 AS a, 2 AS b, 3 AS c; SELECT * FROM ctas_c1; SELECT attname FROM pg_attribute WHERE attrelid='ctas_c1'::regclass AND attnum>0 ORDER BY attnum
ctas.with_no_data|CREATE TABLE ctas_n1 AS SELECT 1 AS a, 'x'::varchar(5) AS b WITH NO DATA; SELECT count(*) FROM ctas_n1; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid='ctas_n1'::regclass AND attnum>0 ORDER BY attnum
ctas.with_data|CREATE TABLE ctas_w1 AS SELECT 1 AS a WITH DATA; SELECT * FROM ctas_w1
ctas.names_and_no_data|CREATE TABLE ctas_nd(p, q) AS SELECT 1, 'two' WITH NO DATA; INSERT INTO ctas_nd VALUES (7, 'seven'); SELECT * FROM ctas_nd
ctas.if_not_exists|CREATE TABLE ctas_e1 AS SELECT 1 AS a; CREATE TABLE IF NOT EXISTS ctas_e1 AS SELECT 2 AS a; SELECT * FROM ctas_e1
ctas.exists_error|CREATE TABLE ctas_e2 AS SELECT 1 a; SELECT 'before'; CREATE TABLE ctas_e2 AS SELECT 2 a
ctas.temp|CREATE TEMP TABLE ctas_tt AS SELECT 1 a; SELECT * FROM ctas_tt
ctas.as_table|CREATE TABLE ctas_s(a int); INSERT INTO ctas_s VALUES (2),(1); CREATE TABLE ctas_s2 AS TABLE ctas_s; SELECT * FROM ctas_s2 ORDER BY a
ctas.union|CREATE TABLE ctas_u AS SELECT 1 a UNION ALL SELECT 2 ORDER BY 1; SELECT * FROM ctas_u ORDER BY 1
ctas.values|CREATE TABLE ctas_v AS VALUES (1, 'a'), (2, 'b'); SELECT * FROM ctas_v ORDER BY 1; SELECT attname FROM pg_attribute WHERE attrelid='ctas_v'::regclass AND attnum>0 ORDER BY attnum
ctas.cte|CREATE TABLE ctas_q AS WITH x AS (SELECT 5 AS v) SELECT v*2 AS w FROM x; SELECT * FROM ctas_q
ctas.id_is_not_a_key|CREATE TABLE ctas_id AS SELECT 1 AS id UNION ALL SELECT 1; INSERT INTO ctas_id VALUES (1); SELECT count(*) FROM ctas_id
ctas.question_column|CREATE TABLE ctas_qc AS SELECT 1+1, 2 AS two, 'x'::text, 1::int, upper('a'), CASE WHEN true THEN 1 END, CASE WHEN true THEN 1 ELSE 2::bigint END, (SELECT 5 AS inner_name), EXISTS (SELECT 1), ARRAY[1], now()::date; SELECT attname FROM pg_attribute WHERE attrelid='ctas_qc'::regclass AND attnum>0 ORDER BY attnum
ctas.too_many_names|SELECT 'start'; CREATE TABLE ctas_tm(a, b) AS SELECT 1
ctas.duplicate_names|SELECT 'start'; CREATE TABLE ctas_dn AS SELECT 1 a, 2 a
ctas.atomic_failure|CREATE TABLE ctas_af AS SELECT 1/(3-g) AS x FROM generate_series(1,3) g; SELECT 'unreachable'
ctas.in_transaction_rollback|BEGIN; CREATE TABLE ctas_tx AS SELECT 1 a; ROLLBACK; SELECT count(*) FROM pg_class WHERE relname='ctas_tx'
ctas.in_transaction_commit|BEGIN; CREATE TABLE ctas_tc AS SELECT 1 a; INSERT INTO ctas_tc VALUES (2); COMMIT; SELECT * FROM ctas_tc ORDER BY a
ctas.schema_qualified|CREATE SCHEMA ctas_ns; CREATE TABLE ctas_ns.t AS SELECT 1 AS a; SELECT * FROM ctas_ns.t
ctas.select_privilege|DROP ROLE IF EXISTS ctas_r; CREATE ROLE ctas_r; CREATE TABLE ctas_sec(a int); INSERT INTO ctas_sec VALUES (1); GRANT CREATE ON SCHEMA public TO ctas_r; SET ROLE ctas_r; SELECT 'as role'; CREATE TABLE ctas_sec2 AS SELECT * FROM ctas_sec
ctas.row_level_security|DROP ROLE IF EXISTS ctas_rr; CREATE ROLE ctas_rr; CREATE TABLE ctas_rls(a int, who text); INSERT INTO ctas_rls VALUES (1,'ctas_rr'),(2,'other'),(3,'ctas_rr'); ALTER TABLE ctas_rls ENABLE ROW LEVEL SECURITY; CREATE POLICY ctas_p ON ctas_rls USING (who = current_user); GRANT SELECT ON ctas_rls TO ctas_rr; GRANT CREATE ON SCHEMA public TO ctas_rr; SET ROLE ctas_rr; CREATE TABLE ctas_rls2 AS SELECT a FROM ctas_rls; SELECT a FROM ctas_rls2 ORDER BY a
select_into.basic|SELECT * INTO si_1 FROM (VALUES (1,'a'),(2,'b')) v(a,b); SELECT * FROM si_1 ORDER BY a
select_into.temp|SELECT 1 AS a, 'x' AS b INTO TEMP si_2; SELECT * FROM si_2
select_into.table_keyword|SELECT 3 AS a INTO TABLE si_3; SELECT * FROM si_3
select_into.where_order|CREATE TABLE si_src(a int, b text); INSERT INTO si_src VALUES (1,'x'),(2,'y'),(3,'z'); SELECT b, a INTO si_4 FROM si_src WHERE a > 1 ORDER BY a; SELECT * FROM si_4 ORDER BY a; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid='si_4'::regclass AND attnum>0 ORDER BY attnum
select_into.union|SELECT 1 AS a INTO si_5 UNION SELECT 2; SELECT * FROM si_5 ORDER BY a
select_into.exists|CREATE TABLE si_6(a int); SELECT 'start'; SELECT 1 INTO si_6
select_into.nested_rejected|SELECT 'start'; SELECT * FROM (SELECT 1 AS a INTO si_7) s
