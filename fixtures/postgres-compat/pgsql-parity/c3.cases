range_float8|CREATE TYPE c3floatrange AS RANGE (subtype = float8, subtype_diff = float8mi);SELECT '[1.5,2.5)'::c3floatrange @> 2.0::float8, '[1,2]'::c3floatrange * '[1.5,3)'::c3floatrange, upper('[1,2]'::c3floatrange), lower_inc('(1,2]'::c3floatrange), '{[1,2],[3,4]}'::c3floatmultirange IS NOT NULL;SELECT '[1,2]'::c3floatrange && '[2,3]'::c3floatrange, '[1,2)'::c3floatrange -|- '[2,3]'::c3floatrange, '[1,5]'::c3floatrange - '[3,6]'::c3floatrange
range_float8_multirange|CREATE TYPE c3fr AS RANGE (subtype = float8, multirange_type_name = c3frm);SELECT '{[1,2],[3,4]}'::c3frm, '{[1,2],[3,4]}'::c3frm @> 3.5::float8, range_merge('{[1,2],[3,4]}'::c3frm)
range_text|CREATE TYPE c3textrange AS RANGE (subtype = text);SELECT '[a,m)'::c3textrange @> 'b'::text, '[a,m)'::c3textrange @> 'z'::text, c3textrange('a','c') && c3textrange('b','d'), c3textrange('a','c','[]')
range_catalog|CREATE TYPE c3r2 AS RANGE (subtype = float8, subtype_diff = float8mi);CREATE TYPE c3r3 AS RANGE (subtype = text);SELECT rngtypid::regtype, rngsubtype::regtype, rngsubopc, rngsubdiff, rngmultitypid::regtype FROM pg_range WHERE rngtypid IN ('c3r2'::regtype,'c3r3'::regtype) ORDER BY 1::text
range_table_gist|CREATE TYPE c3r4 AS RANGE (subtype = float8);CREATE TABLE c3rt(id int, r c3r4);INSERT INTO c3rt VALUES (1,'[1,2)'),(2,'[5,6)'),(3,'empty');CREATE INDEX ON c3rt USING gist (r);SELECT id, r FROM c3rt WHERE r && '[1.5,1.7]' ORDER BY id;SELECT id FROM c3rt ORDER BY r, id
range_interval_time|CREATE TYPE c3ir AS RANGE (subtype = interval);CREATE TYPE c3tr AS RANGE (subtype = time);SELECT '[1 hour,2 hours)'::c3ir @> '90 minutes'::interval, '[10:00,12:00)'::c3tr @> '11:00'::time, '[10:00,12:00)'::c3tr
collation_create_catalog|CREATE COLLATION c3ci (provider = icu, locale = 'und-u-ks-level2', deterministic = false);CREATE COLLATION c3de (provider = icu, locale = 'de-DE');CREATE COLLATION c3sv (provider = icu, locale = 'sv');CREATE COLLATION c3c FROM "C";SELECT collname, collprovider, collisdeterministic, colllocale, collcollate FROM pg_collation WHERE collname LIKE 'c3%' ORDER BY 1
collation_nondeterministic_compare|CREATE COLLATION c3ci2 (provider = icu, locale = 'und-u-ks-level2', deterministic = false);SELECT 'abc' = 'ABC' COLLATE c3ci2, 'abc' < 'ABD' COLLATE c3ci2, 'a' = 'b' COLLATE c3ci2;CREATE TABLE c3ct(id int, s text);INSERT INTO c3ct VALUES (1,'Hello'),(2,'HELLO'),(3,'world');SELECT id FROM c3ct WHERE s = 'hello' COLLATE c3ci2 ORDER BY id
collation_order_by|CREATE COLLATION c3de2 (provider = icu, locale = 'de-DE');CREATE COLLATION c3sv3 (provider = icu, locale = 'sv');CREATE COLLATION c3c2 FROM "C";SELECT x FROM (VALUES ('b'),('A'),('a'),('B'),('ä')) v(x) ORDER BY x COLLATE c3de2, x COLLATE "C";SELECT x FROM (VALUES ('z'),('ä'),('a')) v(x) ORDER BY x COLLATE c3sv3;SELECT x FROM (VALUES ('b'),('A'),('a')) v(x) ORDER BY x COLLATE c3c2
collation_column|CREATE COLLATION c3de3 (provider = icu, locale = 'de-DE');CREATE TABLE c3t(s text COLLATE c3de3);INSERT INTO c3t VALUES ('b'),('A'),('a');SELECT s FROM c3t ORDER BY s;SELECT s FROM c3t WHERE s < 'b' ORDER BY s
collation_alter_drop|CREATE COLLATION c3sv4 (provider = icu, locale = 'sv');ALTER COLLATION c3sv4 RENAME TO c3sv5;SELECT count(*) FROM pg_collation WHERE collname IN ('c3sv4','c3sv5');DROP COLLATION c3sv5;DROP COLLATION IF EXISTS c3nope;SELECT count(*) FROM pg_collation WHERE collname = 'c3sv5'
collation_drop_dependency|CREATE COLLATION c3de4 (provider = icu, locale = 'de-DE');CREATE TABLE c3t4(s text COLLATE c3de4);DROP COLLATION c3de4
collation_libc_nondeterministic|CREATE COLLATION c3bad (provider = libc, locale = 'C', deterministic = false)
collation_duplicate|CREATE COLLATION c3dup (provider = icu, locale = 'und');CREATE COLLATION c3dup (provider = icu, locale = 'en')
collation_unknown|SELECT 'a' COLLATE c3nope
range_subdiff_procs|SELECT proname, count(*) FROM pg_proc WHERE proname IN ('float8mi','int4range_subdiff','numrange_subdiff','interval_mi') GROUP BY proname ORDER BY 1
range_bounds_render|CREATE TYPE c3ir2 AS RANGE (subtype = interval);CREATE TYPE c3tr2 AS RANGE (subtype = text);CREATE TYPE c3f2 AS RANGE (subtype = float8);SELECT lower('[1 day,2 days)'::c3ir2), '[1 day,2 days)'::c3ir2, upper('[ab,"b c")'::c3tr2), c3tr2('ab','b c'), '[-Infinity,1e20)'::c3f2, upper('[0.1,0.30000000000000004]'::c3f2);CREATE TABLE c3rs(r c3tr2);INSERT INTO c3rs VALUES ('[b,c)'),('[a,z)'),('[a,b)'),('empty');SELECT r FROM c3rs ORDER BY r
range_subdiff_text|CREATE TYPE c3r9 AS RANGE (subtype = float8, subtype_diff = float8mi);SELECT rngsubdiff::text FROM pg_range WHERE rngtypid = 'c3r9'::regtype
range_constructor_bounds|CREATE TYPE c3ri AS RANGE (subtype = int4);CREATE TYPE c3rt9 AS RANGE (subtype = text);SELECT upper(c3ri(1,5)), lower(c3rt9('ab','c'))
