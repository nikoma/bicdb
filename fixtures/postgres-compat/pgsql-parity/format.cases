format.position|SELECT format('%s %1$s %s', 'World', 'again')
format.width_position|SELECT format('%2$*3$s|%s', 'unused', 'value', 8), format('%*2$s|%s', 'unused', 4, 'f', 'next')
format.width_negative|SELECT format('>%*s<', -4, 'é')
format.width_null|SELECT format('>%4s%%<', NULL)
format.quote|SELECT format('>%-5I<', 'a b'), format('%I:%L:%s', true, false, true), format('%2$*1$L', 10, NULL)
format.variadic|SELECT format('%2$s:%1$s', VARIADIC ARRAY[1, 2]), format('literal', VARIADIC NULL::int[])
format.position_zero|SELECT format('%0$s')
format.width_zero|SELECT format('%*0$')
format.width_missing_dollar|SELECT format('%*1s', 1, 'x')
format.unterminated|SELECT format('%1$1', 1)
format.unknown_conversion|SELECT format('%1$x')
format.missing_value|SELECT format('%3$s', 'a')
format.null_identifier|SELECT format('%I', NULL)
format.width_overflow|SELECT format('%2147483648s', 'a')
format.width_noninteger|SELECT format('%*s', 2.5, 'a')
