udtdef.enum_cast|CREATE TYPE ud1_status AS ENUM ('new','paid'); CREATE TABLE ud1(n int, s ud1_status DEFAULT 'new'::ud1_status); INSERT INTO ud1(n) VALUES (1); INSERT INTO ud1 DEFAULT VALUES; SELECT n, s FROM ud1 ORDER BY n NULLS LAST
udtdef.enum_cast_qualified|CREATE TYPE public.ud2_status AS ENUM ('new','paid'); CREATE TABLE public.ud2(id int, s public.ud2_status DEFAULT 'new'::public.ud2_status NOT NULL); INSERT INTO ud2(id) VALUES (1); SELECT id, s, s = 'new' FROM ud2; SELECT column_default FROM information_schema.columns WHERE table_name = 'ud2' AND column_name = 's'
udtdef.enum_cast_catalog|CREATE TYPE ud3_status AS ENUM ('new','paid'); CREATE TABLE ud3(s ud3_status DEFAULT 'paid'::ud3_status); SELECT column_name, column_default, data_type, udt_name FROM information_schema.columns WHERE table_name = 'ud3'; SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid WHERE c.relname = 'ud3'
udtdef.enum_cast_bad_label|CREATE TYPE ud4_status AS ENUM ('new','paid'); CREATE TABLE ud4(s ud4_status DEFAULT 'nope'::ud4_status)
