exc.check_violation|create table h5c (a int check (a > 0)); do $$ begin insert into h5c values (-1); exception when check_violation then raise notice 'caught % %', sqlstate, sqlerrm; end $$; select count(*) from h5c
exc.partition_no_route|create table h5p (a int) partition by list (a); create table h5p_1 partition of h5p for values in (1); insert into h5p values (1); do $$ begin update h5p set a = a + 1; exception when check_violation then raise notice 'caught %', sqlstate; end $$; select tableoid::regclass::text, a from h5p
exc.sqlstate_literal|create table h5s (a int unique); insert into h5s values (1); do $$ begin insert into h5s values (1); exception when sqlstate '23505' then raise notice 'dup %', sqlstate; end $$
exc.category|create table h5g (a int not null); do $$ begin insert into h5g values (null); exception when integrity_constraint_violation then raise notice 'class 23: %', sqlstate; end $$
exc.category_sqlstate|do $$ begin perform 1/0; exception when sqlstate '22000' then raise notice 'class 22: %', sqlstate; end $$
exc.or_list|create table h5o (a int primary key); create table h5o2 (b int references h5o); do $$ begin insert into h5o2 values (5); exception when unique_violation or foreign_key_violation then raise notice 'fk: %', sqlstate; end $$
exc.others|do $$ begin perform 1/0; exception when others then raise notice 'others: % %', sqlstate, sqlerrm; end $$
exc.unmatched_propagates|do $$ begin perform 1/0; exception when unique_violation then raise notice 'wrong'; end $$
exc.rollback_inner_keep_outer|create table h5r (a int); do $$ begin insert into h5r values (1); begin insert into h5r values (2); perform 1/0; exception when division_by_zero then raise notice 'rolled back inner'; end; insert into h5r values (3); end $$; select a from h5r order by a
exc.nested_reraise|do $$ begin begin perform 1/0; exception when division_by_zero then raise notice 'inner %', sqlerrm; raise; end; exception when division_by_zero then raise notice 'outer %', sqlerrm; end $$
exc.unknown_condition|do $$ begin perform 1; exception when no_such_condition then null; end $$
exc.string_data_right_truncation|do $$ declare v varchar(2); begin v := 'abc'; exception when string_data_right_truncation then raise notice 'trunc %', sqlstate; end $$
exc.raise_using|do $$ begin raise exception 'boom' using errcode = '55001', detail = 'some detail', hint = 'some hint'; exception when sqlstate '55001' then raise notice 'got % %', sqlstate, sqlerrm; end $$
exc.raise_using_uncaught|do $$ begin raise exception 'boom %', 1 using errcode = 'division_by_zero', detail = 'd1', hint = 'h1'; end $$
exc.raise_condition_name|do $$ begin raise division_by_zero using detail = 'some detail info'; end $$
exc.raise_using_message|do $$ begin raise using message = 'custom' || ' message', errcode = '22012'; end $$
exc.raise_custom_sqlstate|do $$ begin raise exception using message = 'x', errcode = '1234F'; exception when sqlstate '1234F' then raise notice 'custom %', sqlstate; end $$
exc.raise_column_constraint|do $$ begin raise exception 'col' using column = 'c1', constraint = 'k1', table = 't1', schema = 's1', datatype = 'int'; exception when others then raise notice 'ok'; end $$
exc.stacked_diagnostics|do $$ declare m text; d text; h text; s text; c text; begin raise exception 'msg' using detail = 'det', hint = 'hin', errcode = '22012'; exception when others then get stacked diagnostics m = message_text, d = pg_exception_detail, h = pg_exception_hint, s = returned_sqlstate; raise notice '% / % / % / %', m, d, h, s; end $$
exc.stacked_constraint_names|create table h5d (a int constraint h5d_pos check (a > 0)); do $$ declare t text; c text; sch text; begin insert into h5d values (0); exception when check_violation then get stacked diagnostics t = table_name, c = constraint_name, sch = schema_name; raise notice '% % %', t, c, sch; end $$
exc.stacked_column_name|create table h5n (a int not null); do $$ declare col text; t text; begin insert into h5n values (null); exception when not_null_violation then get stacked diagnostics col = column_name, t = table_name; raise notice '% %', col, t; end $$
exc.stacked_outside_handler|do $$ declare m text; begin get stacked diagnostics m = message_text; end $$
exc.sqlerrm_outside|do $$ begin raise notice '%', sqlerrm; end $$
exc.function_handler|create function h5f(x int) returns text language plpgsql as $$ begin return (10 / x)::text; exception when division_by_zero then return 'div0: ' || sqlerrm; end $$; select h5f(2), h5f(0)
exc.handler_return_value_after_writes|create table h5w (a int); create function h5wf() returns int language plpgsql as $$ begin insert into h5w values (1); begin insert into h5w values (2); raise exception 'x'; exception when raise_exception then return (select count(*) from h5w); end; end $$; select h5wf(); select count(*) from h5w
exc.assert_not_caught_by_others|do $$ begin assert 1 = 2, 'nope'; exception when others then raise notice 'caught'; end $$
exc.assert_failure_named|do $$ begin assert 1 = 2, 'nope'; exception when assert_failure then raise notice 'assert %', sqlstate; end $$
exc.raise_invalid_sqlstate|do $$ begin raise exception 'x' using errcode = 'abcde'; end $$
fk.ref_part_insert_ok|create table h6p (a int primary key) partition by range (a); create table h6p_1 partition of h6p for values from (0) to (10); create table h6p_2 partition of h6p for values from (10) to (20); create table h6c (x int references h6p); insert into h6p values (1), (15); insert into h6c values (1), (15), (null); select count(*) from h6c
fk.ref_part_insert_fail|create table h6q (a int primary key) partition by range (a); create table h6q_1 partition of h6q for values from (0) to (10); create table h6qc (x int references h6q); insert into h6qc values (5)
fk.ref_part_delete_blocked|create table h6r (a int primary key) partition by range (a); create table h6r_1 partition of h6r for values from (0) to (10); create table h6rc (x int references h6r); insert into h6r values (1); insert into h6rc values (1); delete from h6r where a = 1
fk.ref_part_delete_on_partition|create table h6s (a int primary key) partition by range (a); create table h6s_1 partition of h6s for values from (0) to (10); create table h6sc (x int references h6s); insert into h6s values (1); insert into h6sc values (1); delete from h6s_1 where a = 1
fk.ref_part_update_blocked|create table h6u (a int primary key) partition by range (a); create table h6u_1 partition of h6u for values from (0) to (10); create table h6uc (x int references h6u); insert into h6u values (1); insert into h6uc values (1); update h6u set a = 2
fk.ref_part_cascade|create table h6v (a int primary key) partition by range (a); create table h6v_1 partition of h6v for values from (0) to (10); create table h6vc (x int references h6v on delete cascade); insert into h6v values (1), (2); insert into h6vc values (1), (2); delete from h6v where a = 1; select x from h6vc
fk.ref_part_constraint_rows|create table h6w (a int primary key) partition by range (a); create table h6w_1 partition of h6w for values from (0) to (10); create table h6w_2 partition of h6w for values from (10) to (20); create table h6wc (x int references h6w); select conname, conrelid::regclass::text, confrelid::regclass::text from pg_constraint where contype = 'f' and conrelid = 'h6wc'::regclass order by 1, 3
fk.defined_on_part_insert|create table h6x (a int primary key); create table h6xc (a int references h6x, b int) partition by list (b); create table h6xc_1 partition of h6xc for values in (1); insert into h6x values (1); insert into h6xc values (1, 1); insert into h6xc values (2, 1)
fk.defined_on_part_rows|create table h6y (a int primary key); create table h6yc (a int references h6y, b int) partition by list (b); create table h6yc_1 partition of h6yc for values in (1); select conname, conrelid::regclass::text, conparentid <> 0 from pg_constraint where contype = 'f' and conrelid in ('h6yc'::regclass, 'h6yc_1'::regclass) order by 2
fk.defined_on_part_delete_parent|create table h6z (a int primary key); create table h6zc (a int references h6z, b int) partition by list (b); create table h6zc_1 partition of h6zc for values in (1); insert into h6z values (1); insert into h6zc values (1, 1); delete from h6z
fk.defined_on_part_attach|create table h6t (a int primary key); create table h6tc (a int references h6t, b int) partition by list (b); create table h6tc_1 (a int, b int); insert into h6tc_1 values (9, 1); alter table h6tc attach partition h6tc_1 for values in (1)
priv.maintain_grant|drop role if exists h7u1; create role h7u1; create table h7t1 (a int); grant maintain on h7t1 to h7u1; select has_table_privilege('h7u1', 'h7t1', 'MAINTAIN'), has_table_privilege('h7u1', 'h7t1', 'SELECT')
priv.maintain_analyze|drop role if exists h7u2; create role h7u2; create table h7t2 (a int); grant maintain on h7t2 to h7u2; set role h7u2; analyze h7t2; select 1
priv.maintain_vacuum|drop role if exists h7u3; create role h7u3; create table h7t3 (a int); grant maintain on h7t3 to h7u3; set role h7u3; vacuum h7t3; select 1
priv.maintain_no_select|drop role if exists h7u4; create role h7u4; create table h7t4 (a int); grant maintain on h7t4 to h7u4; set role h7u4; select * from h7t4
