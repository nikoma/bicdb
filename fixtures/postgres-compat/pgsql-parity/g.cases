geo_gist_index|CREATE TABLE g53(id int, b box, po polygon, c circle, p point);INSERT INTO g53 SELECT i, box(point(i,i),point(i+1,i+1)), polygon(box(point(i,i),point(i+1,i+1))), circle(point(i,i),1), point(i,i) FROM generate_series(1,50) i;CREATE INDEX g53_b ON g53 USING gist (b);CREATE INDEX g53_po ON g53 USING gist (po);CREATE INDEX g53_c ON g53 USING gist (c);CREATE INDEX g53_p ON g53 USING gist (p);SELECT id FROM g53 WHERE b && box '(10,10),(12,12)' ORDER BY id;SELECT id FROM g53 WHERE c @> point '(20,20.5)' ORDER BY id;SELECT id FROM g53 WHERE p <@ box '(5,5),(7,7)' ORDER BY id;SELECT id FROM g53 ORDER BY p <-> point '(30.2,30.2)' LIMIT 3
