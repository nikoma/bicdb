    "SELECT ~ '08:00:2b:01:02:03'::macaddr, '08:00:2b:ff:00:ff'::macaddr & 'ff:ff:ff:00:ff:00'::macaddr, '08:00:2b:00:00:00'::macaddr | '00:00:00:01:02:03'::macaddr, ~ '08:00:2b:01:02:03:04:05'::macaddr8, '08:00:2b:01:02:03'::macaddr < '08:00:2b:01:02:04'::macaddr, '08:00:2b:01:02:03:04:05'::macaddr8 = '08:00:2b:01:02:03:04:05'::macaddr8;",
    "SELECT abbrev('10.1.0.0/16'::cidr), abbrev('2001:db8:1::/48'::cidr), host('192.168.1.5/24'::inet), text('::1'::inet), family('::1'::inet), masklen('10/8'::cidr);",
