information_schema|CREATE FOREIGN DATA WRAPPER pq_w20_59 OPTIONS ("test wrapper" 'true');CREATE SERVER pq_s10_59 TYPE 'x' FOREIGN DATA WRAPPER pq_w20_59 OPTIONS (host 'a');CREATE USER MAPPING FOR public SERVER pq_s10_59 OPTIONS (k 'v');SELECT foreign_data_wrapper_name, library_name, foreign_data_wrapper_language FROM information_schema.foreign_data_wrappers WHERE foreign_data_wrapper_name LIKE '%_59' ORDER BY 1, 2, 3;SELECT foreign_data_wrapper_name, option_name, option_value FROM information_schema.foreign_data_wrapper_options WHERE foreign_data_wrapper_name LIKE '%_59' ORDER BY 1, 2, 3;SELECT foreign_server_name, foreign_data_wrapper_name, foreign_server_type, foreign_server_version FROM information_schema.foreign_servers WHERE foreign_server_name LIKE '%_59' ORDER BY 1, 2;SELECT foreign_server_name, option_name, option_value FROM information_schema.foreign_server_options WHERE foreign_server_name LIKE '%_59' ORDER BY 1, 2, 3;SELECT replace(authorization_identifier::text, current_user, 'ME') AS authorization_identifier, foreign_server_name FROM information_schema.user_mappings WHERE foreign_server_name LIKE '%_59' ORDER BY 1, 2;SELECT replace(authorization_identifier::text, current_user, 'ME') AS a, option_name, option_value FROM information_schema.user_mapping_options WHERE foreign_server_name LIKE '%_59' ORDER BY 1, 2, 3;SET ROLE pg_monitor;SELECT count(*) FROM information_schema.foreign_servers WHERE foreign_server_name LIKE '%_59'
comments|CREATE FOREIGN DATA WRAPPER pq_w21_60;CREATE SERVER pq_s11_60 FOREIGN DATA WRAPPER pq_w21_60;COMMENT ON FOREIGN DATA WRAPPER pq_w21_60 IS 'useless';COMMENT ON SERVER pq_s11_60 IS 'foreign server';SELECT d.description FROM pg_foreign_data_wrapper w JOIN pg_description d ON d.classoid = w.tableoid AND d.objoid = w.oid WHERE w.fdwname LIKE '%_60';SELECT d.description FROM pg_foreign_server s JOIN pg_description d ON d.classoid = s.tableoid AND d.objoid = s.oid WHERE s.srvname LIKE '%_60';COMMENT ON SERVER pq_s11_60 IS NULL;SELECT count(*) FROM pg_foreign_server s JOIN pg_description d ON d.objoid = s.oid WHERE s.srvname LIKE '%_60'
