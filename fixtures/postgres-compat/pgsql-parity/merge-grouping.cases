merge_multi_clause|CREATE TABLE m1t(id int primary key, n int, note text default 'dflt');CREATE TABLE m1s(id int, n int);INSERT INTO m1t VALUES (1,10,'a'),(2,20,'b'),(3,30,'c');INSERT INTO m1s VALUES (1,100),(3,300),(4,400),(5,-5);MERGE INTO m1t t USING m1s s ON t.id=s.id WHEN MATCHED AND s.n>200 THEN DELETE WHEN MATCHED THEN UPDATE SET n=t.n+s.n WHEN NOT MATCHED AND s.n<0 THEN DO NOTHING WHEN NOT MATCHED THEN INSERT (id,n) VALUES (s.id,s.n);SELECT * FROM m1t ORDER BY id
merge_by_source|CREATE TABLE m2t(id int primary key, n int, note text);CREATE TABLE m2s(id int, n int);INSERT INTO m2t VALUES (1,10,'a'),(2,20,'b'),(3,30,'c');INSERT INTO m2s VALUES (1,100),(4,400);MERGE INTO m2t t USING m2s s ON t.id=s.id WHEN NOT MATCHED BY SOURCE AND t.n>25 THEN DELETE WHEN NOT MATCHED BY SOURCE THEN UPDATE SET note='orphan' WHEN NOT MATCHED BY TARGET THEN INSERT VALUES (s.id,s.n,DEFAULT) WHEN MATCHED THEN DO NOTHING;SELECT * FROM m2t ORDER BY id
merge_values_source|CREATE TABLE m3t(id int primary key, n int);INSERT INTO m3t VALUES (1,1);MERGE INTO m3t t USING (VALUES (1,5),(2,6)) AS v(id,n) ON t.id=v.id WHEN MATCHED THEN UPDATE SET n=v.n*10 WHEN NOT MATCHED THEN INSERT VALUES (v.id,v.n);SELECT * FROM m3t ORDER BY id
merge_subquery_source|CREATE TABLE m4t(id int primary key, n int);CREATE TABLE m4s(id int, n int);INSERT INTO m4t VALUES (1,1),(2,2);INSERT INTO m4s VALUES (1,7),(2,8),(3,9);MERGE INTO m4t t USING (SELECT id, sum(n) AS n FROM m4s WHERE id<>2 GROUP BY id) s ON t.id=s.id WHEN MATCHED THEN UPDATE SET n=s.n WHEN NOT MATCHED THEN INSERT (n,id) VALUES (s.n,s.id);SELECT * FROM m4t ORDER BY id
merge_default_values|CREATE TABLE m5t(id serial primary key, tag text default 'none');MERGE INTO m5t d USING (VALUES (1),(2)) v(k) ON false WHEN NOT MATCHED THEN INSERT DEFAULT VALUES;SELECT * FROM m5t ORDER BY id
merge_returning_update|CREATE TABLE m6t(id int primary key, n int);INSERT INTO m6t VALUES (1,10),(2,20);MERGE INTO m6t t USING (SELECT 1 AS id, 100 AS n) s ON t.id=s.id WHEN MATCHED THEN UPDATE SET n=s.n RETURNING merge_action(), t.id, old.n, new.n, s.n
merge_returning_star|CREATE TABLE m7t(id int primary key, n int);INSERT INTO m7t VALUES (2,20);MERGE INTO m7t t USING (VALUES (2,0)) s(id,n) ON t.id=s.id WHEN MATCHED THEN DELETE RETURNING merge_action() AS action, *;MERGE INTO m7t t USING (VALUES (9,90)) s(id,n) ON t.id=s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id,s.n) RETURNING merge_action(), t.*, old.id, new.id
merge_cardinality|CREATE TABLE m8t(id int primary key, n int);INSERT INTO m8t VALUES (1,0);MERGE INTO m8t t USING (VALUES (1,1),(1,2)) s(id,n) ON t.id=s.id WHEN MATCHED THEN UPDATE SET n=s.n
merge_cardinality_do_nothing|CREATE TABLE m9t(id int primary key, n int);INSERT INTO m9t VALUES (1,0);MERGE INTO m9t t USING (VALUES (1,1),(1,2)) s(id,n) ON t.id=s.id WHEN MATCHED AND s.n=2 THEN UPDATE SET n=s.n WHEN MATCHED THEN DO NOTHING;SELECT * FROM m9t
merge_unreachable|CREATE TABLE m10t(id int primary key);MERGE INTO m10t t USING m10t s ON t.id=s.id WHEN MATCHED THEN DELETE WHEN MATCHED AND s.id>1 THEN DO NOTHING
merge_rollback|CREATE TABLE m11t(id int primary key, n int check (n>=0));INSERT INTO m11t VALUES (1,1),(2,2);MERGE INTO m11t t USING (VALUES (1,5),(2,-1),(3,3)) s(id,n) ON t.id=s.id WHEN MATCHED THEN UPDATE SET n=s.n WHEN NOT MATCHED THEN INSERT VALUES (s.id,s.n);SELECT * FROM m11t ORDER BY id
merge_trigger_ops|CREATE TABLE m12t(id int primary key, n int);CREATE TABLE m12log(op text, id int);INSERT INTO m12t VALUES (1,1),(3,3);CREATE FUNCTION m12fn() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF TG_OP='DELETE' THEN INSERT INTO m12log VALUES (TG_OP, OLD.id); RETURN OLD; END IF; INSERT INTO m12log VALUES (TG_OP, NEW.id); RETURN NEW; END $$;CREATE TRIGGER m12tr AFTER INSERT OR UPDATE OR DELETE ON m12t FOR EACH ROW EXECUTE FUNCTION m12fn();MERGE INTO m12t t USING (VALUES (1),(3),(4)) s(id) ON t.id=s.id WHEN MATCHED AND s.id=1 THEN UPDATE SET n=0 WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT VALUES (s.id, 4);SELECT * FROM m12log ORDER BY id;SELECT * FROM m12t ORDER BY id
merge_fk|CREATE TABLE m13p(id int primary key);CREATE TABLE m13c(id int primary key, p int references m13p);INSERT INTO m13p VALUES (1);MERGE INTO m13c t USING (VALUES (1,1),(2,2)) s(id,p) ON t.id=s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id,s.p)
merge_not_matched_target_ref|CREATE TABLE m14t(id int primary key, n int);MERGE INTO m14t t USING (VALUES (1)) s(id) ON t.id=s.id WHEN NOT MATCHED AND t.n>1 THEN INSERT VALUES (s.id, 1)
merge_tag_count|CREATE TABLE m15t(id int primary key, n int);INSERT INTO m15t VALUES (1,1),(2,2);MERGE INTO m15t t USING (VALUES (1),(2),(3)) s(id) ON t.id=s.id WHEN MATCHED AND t.id=1 THEN DELETE WHEN NOT MATCHED THEN INSERT VALUES (s.id, 0);SELECT * FROM m15t ORDER BY id
grouping_rollup|CREATE TABLE g1(region text, product text, qty int);INSERT INTO g1 VALUES ('east','a',1),('east','b',2),('west','a',3),('west','a',4);SELECT region, product, sum(qty), GROUPING(region, product) AS g FROM g1 GROUP BY ROLLUP (region, product) ORDER BY region, product
grouping_cube|CREATE TABLE g2(region text, product text, qty int);INSERT INTO g2 VALUES ('east','a',1),('east','b',2),('west','a',3),('west','a',4);SELECT region, product, count(*), sum(qty) FROM g2 GROUP BY CUBE (region, product) ORDER BY 1, 2
grouping_sets_mixed_having|CREATE TABLE g3(region text, product text, qty int);INSERT INTO g3 VALUES ('east','a',1),('east','b',2),('west','a',3),('west','a',4);SELECT region, product, sum(qty) AS total FROM g3 GROUP BY region, GROUPING SETS ((product), ()) HAVING sum(qty) > 2 ORDER BY total DESC, product
grouping_fn_order|CREATE TABLE g4(region text, product text, qty int);INSERT INTO g4 VALUES ('east','a',1),('east','b',2),('west','a',3),('west','a',4);SELECT GROUPING(product), product, max(qty) FROM g4 GROUP BY GROUPING SETS (product, ()) ORDER BY GROUPING(product), product
grouping_empty_input|CREATE TABLE g5(region text, qty int);SELECT region, count(*), sum(qty) FROM g5 GROUP BY ROLLUP (region);SELECT 1 FROM g5 GROUP BY ()
grouping_bad_arg|CREATE TABLE g6(region text, qty int);SELECT GROUPING(qty) FROM g6 GROUP BY ROLLUP (region)
grouping_nested_sets|CREATE TABLE g7(a int, b int, c int, v int);INSERT INTO g7 VALUES (1,1,1,1),(1,2,1,2),(2,1,2,3);SELECT a, b, c, sum(v), GROUPING(a,b,c) FROM g7 GROUP BY GROUPING SETS ((a, b), ROLLUP (c), ()) ORDER BY 5, 1, 2, 3
grouping_rollup_composite|CREATE TABLE g8(a int, b int, c int, v int);INSERT INTO g8 VALUES (1,1,1,1),(1,2,1,2),(2,1,2,3);SELECT a, b, c, sum(v) FROM g8 GROUP BY ROLLUP ((a, b), c) ORDER BY 1, 2, 3
grouping_expr_and_distinct|CREATE TABLE g9(a int, b int, v int);INSERT INTO g9 VALUES (1,1,1),(1,2,2),(2,1,3);SELECT DISTINCT a % 2 AS parity, sum(v) FROM g9 GROUP BY GROUPING SETS ((a % 2), (a % 2)) ORDER BY 1;SELECT a + 1, count(*) FROM g9 GROUP BY ROLLUP (a + 1) ORDER BY 1 NULLS FIRST LIMIT 2
grouping_qualified|CREATE TABLE g10(a int, v int);INSERT INTO g10 VALUES (1,1),(2,2);SELECT t.a, sum(t.v), GROUPING(a) FROM g10 t GROUP BY ROLLUP (t.a) ORDER BY a
fetch_with_ties|CREATE TABLE f1(id int, g int);INSERT INTO f1 VALUES (1,1),(2,1),(3,2),(4,2),(5,3);SELECT * FROM (SELECT * FROM f1 ORDER BY g FETCH FIRST 3 ROWS WITH TIES) s ORDER BY id;SELECT * FROM (SELECT id FROM f1 ORDER BY g DESC OFFSET 1 ROWS FETCH FIRST 1 ROW WITH TIES) s ORDER BY id;SELECT * FROM (SELECT g, count(*) AS c FROM f1 GROUP BY g ORDER BY c DESC FETCH FIRST 1 ROWS WITH TIES) s ORDER BY g;SELECT id FROM f1 ORDER BY id FETCH FIRST 2 ROWS WITH TIES
fetch_with_ties_no_order|CREATE TABLE f2(id int);SELECT * FROM f2 FETCH FIRST 1 ROWS WITH TIES
hypothetical_set|CREATE TABLE h1(g int, x int);INSERT INTO h1 VALUES (1,10),(1,20),(1,20),(1,null),(2,5);SELECT g, rank(20) WITHIN GROUP (ORDER BY x), dense_rank(20) WITHIN GROUP (ORDER BY x), percent_rank(20) WITHIN GROUP (ORDER BY x), cume_dist(20) WITHIN GROUP (ORDER BY x) FROM h1 GROUP BY g ORDER BY g;SELECT rank(15) WITHIN GROUP (ORDER BY x DESC NULLS LAST), cume_dist(NULL) WITHIN GROUP (ORDER BY x) FROM h1;SELECT rank(1) WITHIN GROUP (ORDER BY x) FROM h1 WHERE false
