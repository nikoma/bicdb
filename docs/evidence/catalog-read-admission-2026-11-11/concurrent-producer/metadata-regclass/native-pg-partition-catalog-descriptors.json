  "native_version": "16.13",
  "read_only_catalog_query": "SELECT c.relname,string_agg(a.attname||':'||t.typname,',' ORDER BY a.attnum) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_attribute a ON a.attrelid=c.oid JOIN pg_type t ON t.oid=a.atttypid WHERE n.nspname='pg_catalog' AND c.relname IN ('pg_indexes','pg_inherits','pg_partitioned_table','pg_attrdef','pg_sequence','pg_tables') AND a.attnum>0 GROUP BY c.relname ORDER BY c.relname",
