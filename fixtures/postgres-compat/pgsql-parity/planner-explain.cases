pin1|create table pin1(id int primary key, a int, b int, c text); insert into pin1 select g, g % 100, g % 7, 'x'||g from generate_series(1,2000) g; insert into pin1 values (2001, null, null, null); create table pin1s(k int primary key, w int, u text); insert into pin1s values (1, 2, 'x2'), (2, null, null), (3, 2, 'x2'), (4, 5, 'x5'); create index pin1_a on pin1(a); create index pin1_b on pin1(b); analyze pin1; select count(*) from pin1 where a in (select w from pin1s)
