udtdef.enum_cast|CREATE TYPE ud1_status AS ENUM ('new','paid'); CREATE TABLE ud1(n int, s ud1_status DEFAULT 'new'::ud1_status); INSERT INTO ud1(n) VALUES (1); INSERT INTO ud1 DEFAULT VALUES; SELECT n, s FROM ud1 ORDER BY n NULLS LAST
udtdef.enum_cast_qualified|CREATE TYPE public.ud2_status AS ENUM ('new','paid'); CREATE TABLE public.ud2(id int, s public.ud2_status DEFAULT 'new'::public.ud2_status NOT NULL); INSERT INTO ud2(id) VALUES (1); SELECT id, s, s = 'new' FROM ud2; SELECT column_default FROM information_schema.columns WHERE table_name = 'ud2' AND column_name = 's'
udtdef.enum_cast_catalog|CREATE TYPE ud3_status AS ENUM ('new','paid'); CREATE TABLE ud3(s ud3_status DEFAULT 'paid'::ud3_status); SELECT column_name, column_default, data_type, udt_name FROM information_schema.columns WHERE table_name = 'ud3'; SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid WHERE c.relname = 'ud3'
udtdef.enum_cast_bad_label|CREATE TYPE ud4_status AS ENUM ('new','paid'); CREATE TABLE ud4(s ud4_status DEFAULT 'nope'::ud4_status)
udtdef.domain_cast|CREATE DOMAIN ud5_pos AS int CHECK (VALUE > 0); CREATE TABLE ud5(id int, p ud5_pos DEFAULT 7::ud5_pos); INSERT INTO ud5(id) VALUES (1); SELECT id, p FROM ud5; SELECT column_default FROM information_schema.columns WHERE table_name = 'ud5' AND column_name = 'p'
udtdef.domain_cast_qualified_text|CREATE DOMAIN public.ud6_code AS text CHECK (VALUE <> ''); CREATE TABLE ud6(id int, c public.ud6_code DEFAULT 'x'::public.ud6_code); INSERT INTO ud6(id) VALUES (1); SELECT id, c FROM ud6; SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid WHERE c.relname = 'ud6'
udtdef.domain_cast_violates_on_insert|CREATE DOMAIN ud7_pos AS int CHECK (VALUE > 0); CREATE TABLE ud7(id int, p ud7_pos DEFAULT (-1)::ud7_pos); INSERT INTO ud7(id) VALUES (1)
udtdef.composite_cast|CREATE TYPE ud8_pair AS (a int, b text); CREATE TABLE ud8(id int, p ud8_pair DEFAULT '(1,x)'::ud8_pair); INSERT INTO ud8(id) VALUES (1); SELECT id, p, (p).a, (p).b FROM ud8
udtdef.composite_row_cast|CREATE TYPE ud9_pair AS (a int, b text); CREATE TABLE ud9(id int, p ud9_pair DEFAULT ROW(2,'y')::ud9_pair); INSERT INTO ud9(id) VALUES (1); SELECT id, p FROM ud9
udtdef.enum_array_cast|CREATE TYPE ud10_status AS ENUM ('new','paid'); CREATE TABLE ud10(id int, s ud10_status[] DEFAULT '{new,paid}'::ud10_status[]); INSERT INTO ud10(id) VALUES (1); SELECT id, s FROM ud10
udtdef.alter_set_default_cast|CREATE TYPE ud11_status AS ENUM ('new','paid'); CREATE TABLE ud11(id int, s ud11_status); ALTER TABLE ud11 ALTER COLUMN s SET DEFAULT 'paid'::public.ud11_status; INSERT INTO ud11(id) VALUES (1); SELECT id, s FROM ud11; SELECT column_default FROM information_schema.columns WHERE table_name = 'ud11' AND column_name = 's'
udtdef.add_column_default_cast|CREATE TYPE ud12_status AS ENUM ('new','paid'); CREATE TABLE ud12(id int); INSERT INTO ud12 VALUES (1); ALTER TABLE ud12 ADD COLUMN s ud12_status DEFAULT 'paid'::ud12_status; INSERT INTO ud12(id) VALUES (2); SELECT id, s FROM ud12 ORDER BY id; SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d JOIN pg_class c ON c.oid = d.adrelid WHERE c.relname = 'ud12'
udtdef.plain_literal_still_works|CREATE TYPE ud13_status AS ENUM ('new','paid'); CREATE TABLE ud13(id int, s ud13_status DEFAULT 'new'); INSERT INTO ud13(id) VALUES (1); SELECT id, s FROM ud13
udtdef.add_column_default_cast_empty_domain|CREATE DOMAIN ud14_pos AS int CHECK (VALUE > 0); CREATE TABLE ud14(id int); ALTER TABLE ud14 ADD COLUMN p ud14_pos DEFAULT (-1)::ud14_pos; SELECT count(*) FROM ud14
udtdef.add_column_bad_label|CREATE TYPE ud15_status AS ENUM ('new'); CREATE TABLE ud15(id int); ALTER TABLE ud15 ADD COLUMN s ud15_status DEFAULT 'nope'::ud15_status
udtdef.plain_defaults_in_information_schema|CREATE TABLE ud16(a int DEFAULT 0, b text DEFAULT 'x', c boolean DEFAULT true, d int); SELECT column_name, column_default FROM information_schema.columns WHERE table_name = 'ud16' ORDER BY ordinal_position
