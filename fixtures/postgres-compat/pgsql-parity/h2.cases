lo.write_denied|drop role if exists h7u21; create role h7u21; select lo_create(43002) > 0; grant select on large object 43002 to h7u21; set role h7u21; select lo_put(43002, 0, '\x01')
lo.grant_update|drop role if exists h7u22; create role h7u22; select lo_create(43003) > 0; grant select, update on large object 43003 to h7u22; set role h7u22; select lo_put(43003, 0, '\x01'); select length(lo_get(43003))
lo.revoke|drop role if exists h7u23; create role h7u23; select lo_create(43004) > 0; grant select on large object 43004 to h7u23; revoke select on large object 43004 from h7u23; set role h7u23; select lo_get(43004)
