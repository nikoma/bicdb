stats.variance_int|CREATE TABLE sv(a int, b int8, c numeric, d float8, e float4, s int2); INSERT INTO sv VALUES (1, 10, 1.5, 1.5, 1.5, 1), (2, 20, 2.25, 2.25, 2.25, 2), (4, 40, 3.125, 3.125, 3.125, 4), (NULL, NULL, NULL, NULL, NULL, NULL); SELECT variance(a), var_samp(a), var_pop(a), stddev(a), stddev_samp(a), stddev_pop(a) FROM sv
stats.variance_types|CREATE TABLE svt(a int, b int8, c numeric, d float8, e float4, s int2); INSERT INTO svt VALUES (1, 10, 1.5, 1.5, 1.5, 1), (2, 20, 2.25, 2.25, 2.25, 2), (4, 40, 3.125, 3.125, 3.125, 4); SELECT variance(b), stddev(c), var_pop(d), stddev_pop(e), variance(s), stddev(s) FROM svt
stats.variance_edge|CREATE TABLE sve(a int, d float8); INSERT INTO sve VALUES (5, 2.5); SELECT var_samp(a), var_pop(a), stddev_samp(d), stddev_pop(d), variance(a) FROM sve; SELECT var_pop(a), stddev(a) FROM sve WHERE false
stats.variance_typeof|CREATE TABLE svy(a int, d float8, n numeric); SELECT pg_typeof(variance(a)), pg_typeof(stddev(d)), pg_typeof(var_pop(n)) FROM svy
stats.no_from|SELECT var_pop(1.0::float8), var_samp(2.0::float8), stddev_pop(3.0::float8), stddev_samp('NaN'::float8), var_pop(1::numeric), var_samp(2::numeric), sum(1), count(*), avg(2), max('x')
stats.regression|CREATE TABLE sr(y float8, x float8); INSERT INTO sr VALUES (1, 2), (3, 5), (4, 4), (7, 9), (NULL, 1), (2, NULL); SELECT regr_count(y, x), regr_sxx(y, x), regr_syy(y, x), regr_sxy(y, x), regr_avgx(y, x), regr_avgy(y, x), regr_r2(y, x), regr_slope(y, x), regr_intercept(y, x), covar_pop(y, x), covar_samp(y, x), corr(y, x) FROM sr
stats.regression_edge|CREATE TABLE sre(y int, x int); INSERT INTO sre VALUES (1, 1); SELECT regr_count(y, x), covar_samp(y, x), covar_pop(y, x), corr(y, x), regr_slope(y, x), regr_r2(y, x) FROM sre
stats.regression_groups|CREATE TABLE srg(g int, y int, x int); INSERT INTO srg VALUES (1, 1, 2), (1, 2, 4), (2, 5, 1), (2, 6, 3), (2, 9, 4); SELECT g, corr(y, x), regr_slope(y, x), covar_samp(y, x) FROM srg GROUP BY g ORDER BY g
stats.bit_aggregates|CREATE TABLE sb(a int, b int2, c int8); INSERT INTO sb VALUES (12, 6, 5), (10, 3, 3), (NULL, NULL, NULL); SELECT bit_and(a), bit_or(a), bit_xor(a), bit_and(b), bit_or(c), bit_xor(c), pg_typeof(bit_and(b)) FROM sb; SELECT bit_and(a) FROM sb WHERE false
stats.bool_aggregates|CREATE TABLE sba(b bool); INSERT INTO sba VALUES (true), (false), (NULL); SELECT bool_and(b), bool_or(b), every(b) FROM sba
funcs.make_date_time|SELECT make_date(2024, 2, 29), make_time(8, 15, 23.5), make_timestamp(2013, 7, 15, 8, 15, 23.5), make_date(-44, 3, 15), pg_typeof(make_date(2024, 1, 1))
funcs.make_date_error|SELECT 'start'; SELECT make_date(2013, 2, 30)
funcs.typeof_unknown|SELECT pg_typeof('a'), pg_typeof('a'::text), pg_typeof(1)
types.values_typmod|VALUES ('a'::varchar(2), 1.5::numeric(4,1)), ('b'::varchar(2), 2::numeric(4,1)) \gdesc
types.values_typmod_mixed|VALUES ('a'::varchar(2)), ('b'::varchar(3)) \gdesc
fk.parent_swap_no_action|CREATE TABLE fps_p(id int PRIMARY KEY); CREATE TABLE fps_c(p int REFERENCES fps_p); INSERT INTO fps_p VALUES (1), (2); INSERT INTO fps_c VALUES (1), (2); UPDATE fps_p SET id = 3 - id; SELECT * FROM fps_p ORDER BY id
fk.parent_update_violation|CREATE TABLE fpv_p(id int PRIMARY KEY); CREATE TABLE fpv_c(p int REFERENCES fpv_p); INSERT INTO fpv_p VALUES (1); INSERT INTO fpv_c VALUES (1); SELECT 'start'; UPDATE fpv_p SET id = 5
fk.parent_swap_restrict|CREATE TABLE fpr_p(id int PRIMARY KEY); CREATE TABLE fpr_c(p int REFERENCES fpr_p ON UPDATE RESTRICT); INSERT INTO fpr_p VALUES (1), (2); INSERT INTO fpr_c VALUES (1); SELECT 'start'; UPDATE fpr_p SET id = 3 - id
part.partition_tree|CREATE TABLE ppt(a int) PARTITION BY RANGE (a); CREATE TABLE ppt1 PARTITION OF ppt FOR VALUES FROM (0) TO (10); CREATE TABLE ppt2 PARTITION OF ppt FOR VALUES FROM (10) TO (20); SELECT relid, parentrelid, isleaf, level FROM pg_partition_tree('ppt'); SELECT * FROM pg_partition_ancestors('ppt2'); SELECT pg_partition_root('ppt1'), pg_partition_root('ppt'); CREATE TABLE ppt_plain(a int); SELECT count(*) FROM pg_partition_tree('ppt_plain'); SELECT pg_partition_root('ppt_plain') IS NULL
priv.lock_modes|DROP ROLE IF EXISTS b4_lock_user; CREATE ROLE b4_lock_user; CREATE TABLE b4_lock(a int); GRANT INSERT ON b4_lock TO b4_lock_user; SET SESSION AUTHORIZATION b4_lock_user; BEGIN; LOCK TABLE b4_lock IN ROW EXCLUSIVE MODE; COMMIT; SELECT 'start'; BEGIN; LOCK TABLE b4_lock IN ACCESS EXCLUSIVE MODE
priv.lock_select_only|DROP ROLE IF EXISTS b4_lock_sel; CREATE ROLE b4_lock_sel; CREATE TABLE b4_lock_s(a int); GRANT SELECT ON b4_lock_s TO b4_lock_sel; SET SESSION AUTHORIZATION b4_lock_sel; BEGIN; LOCK TABLE b4_lock_s IN ACCESS SHARE MODE; COMMIT; SELECT 'start'; BEGIN; LOCK TABLE b4_lock_s IN ROW EXCLUSIVE MODE
priv.lock_none|DROP ROLE IF EXISTS b4_lock_none; CREATE ROLE b4_lock_none; CREATE TABLE b4_lock_n(a int); SET SESSION AUTHORIZATION b4_lock_none; SELECT 'start'; BEGIN; LOCK TABLE b4_lock_n IN ACCESS SHARE MODE
priv.truncate_grant|DROP ROLE IF EXISTS b4_trunc; CREATE ROLE b4_trunc; CREATE TABLE b4_trunc_t(a int); INSERT INTO b4_trunc_t VALUES (1); GRANT TRUNCATE ON b4_trunc_t TO b4_trunc; SET SESSION AUTHORIZATION b4_trunc; TRUNCATE b4_trunc_t; RESET SESSION AUTHORIZATION; SELECT count(*) FROM b4_trunc_t
priv.truncate_denied|DROP ROLE IF EXISTS b4_trunc2; CREATE ROLE b4_trunc2; CREATE TABLE b4_trunc_d(a int); GRANT SELECT, DELETE ON b4_trunc_d TO b4_trunc2; SET SESSION AUTHORIZATION b4_trunc2; SELECT 'start'; TRUNCATE b4_trunc_d
part.multilevel|CREATE TABLE pml(a int, b int) PARTITION BY RANGE (a); CREATE TABLE pml1 PARTITION OF pml FOR VALUES FROM (0) TO (10) PARTITION BY LIST (b); CREATE TABLE pml1a PARTITION OF pml1 FOR VALUES IN (1, 2); CREATE TABLE pml_def PARTITION OF pml DEFAULT PARTITION BY RANGE (b); CREATE TABLE pml_def1 PARTITION OF pml_def FOR VALUES FROM (0) TO (100); INSERT INTO pml VALUES (5, 1), (50, 50); SELECT tableoid::regclass, * FROM pml ORDER BY a; SELECT relid, parentrelid, isleaf, level FROM pg_partition_tree('pml') ORDER BY relid::text; SELECT pg_partition_root('pml1a'); SELECT 'start'; INSERT INTO pml VALUES (5, 3)
part.attach_column_order|CREATE TABLE pao(a int, b text) PARTITION BY LIST (a); CREATE TABLE pao1(b text, a int); ALTER TABLE pao ATTACH PARTITION pao1 FOR VALUES IN (1); INSERT INTO pao VALUES (1, 'x'); SELECT * FROM pao; SELECT * FROM pao1
part.attach_errors|CREATE TABLE pae(a int, b text) PARTITION BY LIST (a); CREATE TABLE pae_extra(a int, b text, c int); CREATE TABLE pae_missing(a int); CREATE TABLE pae_type(a int, b varchar); SELECT 'start'; ALTER TABLE pae ATTACH PARTITION pae_extra FOR VALUES IN (1); ALTER TABLE pae ATTACH PARTITION pae_missing FOR VALUES IN (1); ALTER TABLE pae ATTACH PARTITION pae_type FOR VALUES IN (1)
part.bound_expr_errors|CREATE TABLE pbe(a int) PARTITION BY LIST (a); SELECT 'start'; CREATE TABLE pbe1 PARTITION OF pbe FOR VALUES IN (somename); CREATE TABLE pbe1 PARTITION OF pbe FOR VALUES IN (sum(a)); CREATE TABLE pbe1 PARTITION OF pbe FOR VALUES IN (sum(1)); CREATE TABLE pbe1 PARTITION OF pbe FOR VALUES IN ((select 1)); CREATE TABLE pbe1 PARTITION OF pbe FOR VALUES IN (generate_series(4, 6))
part.overlap|CREATE TABLE pov(a int) PARTITION BY RANGE (a); CREATE TABLE pov1 PARTITION OF pov FOR VALUES FROM (0) TO (10); SELECT 'start'; CREATE TABLE pov2 PARTITION OF pov FOR VALUES FROM (5) TO (15)
priv.role_admin_option|DROP ROLE IF EXISTS b4_grp; DROP ROLE IF EXISTS b4_adm; DROP ROLE IF EXISTS b4_plain; DROP ROLE IF EXISTS b4_tgt; CREATE ROLE b4_grp; CREATE ROLE b4_adm; CREATE ROLE b4_plain; CREATE ROLE b4_tgt; GRANT b4_grp TO b4_adm WITH ADMIN OPTION; SET ROLE b4_adm; GRANT b4_grp TO b4_tgt; SELECT current_role; RESET ROLE; SET ROLE b4_plain; SELECT 'start'; GRANT b4_grp TO b4_plain
priv.current_role|DROP ROLE IF EXISTS b4_cr; CREATE ROLE b4_cr; SET ROLE b4_cr; SELECT current_role, current_user, session_user = current_role
part.second_default|CREATE TABLE psd(a int) PARTITION BY LIST (a); CREATE TABLE psd_def PARTITION OF psd DEFAULT; SELECT 'start'; CREATE TABLE psd_def2 PARTITION OF psd DEFAULT
