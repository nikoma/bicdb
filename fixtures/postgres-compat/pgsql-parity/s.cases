ts.builtin_catalog|SELECT oid, cfgname, cfgparser FROM pg_ts_config WHERE cfgname IN ('simple','english','russian') ORDER BY oid; SELECT oid, dictname, dicttemplate, dictinitoption FROM pg_ts_dict WHERE dictname IN ('simple','english_stem','arabic_stem') ORDER BY oid; SELECT oid, tmplname, tmplinit, tmpllexize FROM pg_ts_template ORDER BY oid; SELECT prsname, prsstart, prstoken, prsend, prsheadline, prslextype FROM pg_ts_parser
ts.builtin_map|SELECT t.alias, d.dictname FROM pg_ts_config_map m JOIN ts_token_type('default') t ON t.tokid = m.maptokentype JOIN pg_ts_dict d ON d.oid = m.mapdict WHERE m.mapcfg = 'russian'::regconfig ORDER BY m.maptokentype; SELECT count(*) FROM pg_ts_config_map
ts.regconfig|SELECT 'english'::regconfig, 'english'::regconfig::oid, 'pg_catalog.simple'::regconfig::oid, 'english_stem'::regdictionary::oid, 13248::regconfig, 3765::regdictionary
ts.regconfig_missing|SELECT 'no_such_cfg'::regconfig
ts.dict_simple|CREATE TEXT SEARCH DICTIONARY s_simp1 (template = simple, stopwords = english, accept = false); SELECT ts_lexize('s_simp1','The'), ts_lexize('s_simp1','Foo') IS NULL; SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 's_simp1'; ALTER TEXT SEARCH DICTIONARY s_simp1 (accept); SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 's_simp1'; ALTER TEXT SEARCH DICTIONARY s_simp1 (accept = true, stopwords); SELECT dictinitoption, ts_lexize('s_simp1','The') FROM pg_ts_dict WHERE dictname = 's_simp1'
ts.dict_errors1|CREATE TEXT SEARCH DICTIONARY s_e1 (template = simple, "Accept" = 1)
ts.dict_errors2|CREATE TEXT SEARCH DICTIONARY s_e2 (template = simple, stopwords = 'a/b')
ts.dict_errors3|CREATE TEXT SEARCH DICTIONARY s_e3 (template = snowball)
ts.dict_errors4|CREATE TEXT SEARCH DICTIONARY s_e4 (template = snowball, language = klingon)
ts.dict_errors5|CREATE TEXT SEARCH DICTIONARY s_e5 (template = snowball, language = english, x = 1.5)
ts.dict_errors6|CREATE TEXT SEARCH DICTIONARY s_e6 (foo = bar)
ts.dict_errors7|CREATE TEXT SEARCH DICTIONARY s_e7 (template = nosuch)
ts.dict_errors8|CREATE TEXT SEARCH DICTIONARY s_e8 (template = simple, accept)
ts.dict_errors9|CREATE TEXT SEARCH DICTIONARY s_e9 (template = simple, stopwords = english, stopwords = english)
ts.dict_dup|CREATE TEXT SEARCH DICTIONARY s_dup (template = simple); CREATE TEXT SEARCH DICTIONARY s_dup (template = simple)
ts.dict_snowball|CREATE TEXT SEARCH DICTIONARY s_sb (template = snowball, language = English); SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 's_sb'; SELECT ts_lexize('s_sb', 'Running'), ts_lexize('s_sb', 'the'), ts_lexize('english_stem', 'the')
ts.synonym|CREATE TEXT SEARCH DICTIONARY s_syn (template = synonym, synonyms = synonym_sample); SELECT ts_lexize('s_syn', 'PoStGrEs'), ts_lexize('s_syn', 'Gogle'), ts_lexize('s_syn', 'indices'), ts_lexize('s_syn', 'other') IS NULL; ALTER TEXT SEARCH DICTIONARY s_syn (CaseSensitive = 1); SELECT ts_lexize('s_syn', 'PoStGrEs') IS NULL, dictinitoption FROM pg_ts_dict WHERE dictname = 's_syn'; ALTER TEXT SEARCH DICTIONARY s_syn (CaseSensitive = off); SELECT ts_lexize('s_syn', 'PoStGrEs'), dictinitoption FROM pg_ts_dict WHERE dictname = 's_syn'
ts.synonym_bad_bool|CREATE TEXT SEARCH DICTIONARY s_syn2 (template = synonym, synonyms = synonym_sample); ALTER TEXT SEARCH DICTIONARY s_syn2 (CaseSensitive = 2)
ts.synonym_missing_file|CREATE TEXT SEARCH DICTIONARY s_syn3 (template = synonym, synonyms = nosuch)
ts.ispell_refused|CREATE TEXT SEARCH DICTIONARY s_isp (template = ispell, dictfile = ispell_sample, afffile = ispell_sample)
ts.ispell_bad_param|CREATE TEXT SEARCH DICTIONARY s_isp2 (template = ispell, "DictFile" = ispell_sample)
ts.thesaurus_refused|CREATE TEXT SEARCH DICTIONARY s_th (template = thesaurus, dictfile = thesaurus_sample, dictionary = english_stem)
ts.config_synonym|CREATE TEXT SEARCH DICTIONARY s_syn4 (template = synonym, synonyms = synonym_sample); CREATE TEXT SEARCH CONFIGURATION s_cfg1 (COPY = english); ALTER TEXT SEARCH CONFIGURATION s_cfg1 ALTER MAPPING FOR asciiword, hword_asciipart, asciihword WITH s_syn4, english_stem; SELECT to_tsvector('s_cfg1', 'Postgresql is often called as postgres or pgsql and pronounced as postgre'); SELECT to_tsvector('s_cfg1', 'Most common mistake is to write Gogle instead of Google'); SELECT to_tsvector('s_cfg1', 'Indexes or indices - Which is right plural form of index?'); SELECT to_tsquery('s_cfg1', 'Index & indices'); SELECT plainto_tsquery('s_cfg1', 'postgres indices'); SELECT phraseto_tsquery('s_cfg1', 'gogle indices')
ts.config_only_synonym|CREATE TEXT SEARCH DICTIONARY s_syn5 (template = synonym, synonyms = synonym_sample); CREATE TEXT SEARCH CONFIGURATION s_cfg2 (copy = english); ALTER TEXT SEARCH CONFIGURATION s_cfg2 ALTER MAPPING FOR asciiword WITH s_syn5; SELECT to_tsvector('s_cfg2', 'postgres the foo gogle bar'); ALTER TEXT SEARCH CONFIGURATION s_cfg2 DROP MAPPING FOR asciiword; SELECT to_tsvector('s_cfg2', 'postgres the foo gogle bar 123 abc'); SELECT to_tsquery('s_cfg2', 'foo & 123'); SELECT plainto_tsquery('s_cfg2', 'foo 123 bar 45')
ts.config_parser|CREATE TEXT SEARCH CONFIGURATION s_cfg3 (parser = default); SELECT count(*) FROM pg_ts_config_map WHERE mapcfg = 's_cfg3'::regconfig; SELECT to_tsvector('s_cfg3', 'hello world') = ''::tsvector; ALTER TEXT SEARCH CONFIGURATION s_cfg3 ADD MAPPING FOR asciiword WITH simple; SELECT to_tsvector('s_cfg3', 'Hello world 42')
ts.config_add_dup|CREATE TEXT SEARCH CONFIGURATION s_cfg4 (parser = default); ALTER TEXT SEARCH CONFIGURATION s_cfg4 ADD MAPPING FOR asciiword WITH simple; ALTER TEXT SEARCH CONFIGURATION s_cfg4 ADD MAPPING FOR asciiword WITH simple
ts.config_errors1|CREATE TEXT SEARCH CONFIGURATION s_cfg5 (parser = default, copy = english)
ts.config_errors2|CREATE TEXT SEARCH CONFIGURATION s_cfg6 (parser = nosuch)
ts.config_errors3|CREATE TEXT SEARCH CONFIGURATION s_cfg7 (copy = nosuch)
ts.config_errors4|CREATE TEXT SEARCH CONFIGURATION s_cfg8 (foo = bar)
ts.config_grammar|CREATE TEXT SEARCH CONFIGURATION s_dummy (COPY = english); ALTER TEXT SEARCH CONFIGURATION s_dummy DROP MAPPING FOR word, word; ALTER TEXT SEARCH CONFIGURATION s_dummy DROP MAPPING IF EXISTS FOR word, word; ALTER TEXT SEARCH CONFIGURATION s_dummy ADD MAPPING FOR word, word WITH simple; SELECT count(*) FROM pg_ts_config_map WHERE mapcfg = 's_dummy'::regconfig
ts.config_bad_token|CREATE TEXT SEARCH CONFIGURATION s_dummy2 (COPY = english); ALTER TEXT SEARCH CONFIGURATION s_dummy2 DROP MAPPING IF EXISTS FOR not_a_token, not_a_token
ts.config_missing_map|CREATE TEXT SEARCH CONFIGURATION s_dummy3 (COPY = english); ALTER TEXT SEARCH CONFIGURATION s_dummy3 DROP MAPPING FOR word; ALTER TEXT SEARCH CONFIGURATION s_dummy3 DROP MAPPING FOR word
ts.config_replace|CREATE TEXT SEARCH CONFIGURATION s_c9 (copy = english); ALTER TEXT SEARCH CONFIGURATION s_c9 ALTER MAPPING REPLACE english_stem WITH simple; SELECT count(*) FROM pg_ts_config_map WHERE mapcfg = 's_c9'::regconfig AND mapdict = 'simple'::regdictionary; ALTER TEXT SEARCH CONFIGURATION s_c9 ALTER MAPPING FOR word REPLACE simple WITH english_stem; SELECT count(*) FROM pg_ts_config_map WHERE mapcfg = 's_c9'::regconfig AND mapdict = 'simple'::regdictionary; SELECT 's_c9'::regconfig; SELECT to_tsvector('s_c9', 'The running dogs')
ts.config_unknown_dict|CREATE TEXT SEARCH CONFIGURATION s_c10 (copy = english); ALTER TEXT SEARCH CONFIGURATION s_c10 ALTER MAPPING FOR asciiword WITH nosuch
ts.drop_restrict|CREATE TEXT SEARCH DICTIONARY s_d11 (template = snowball, language = english); CREATE TEXT SEARCH CONFIGURATION s_c11 (copy = english); ALTER TEXT SEARCH CONFIGURATION s_c11 ALTER MAPPING REPLACE english_stem WITH s_d11; DROP TEXT SEARCH DICTIONARY s_d11
ts.drop_cascade|CREATE TEXT SEARCH DICTIONARY s_d12 (template = snowball, language = english); CREATE TEXT SEARCH CONFIGURATION s_c12 (copy = english); ALTER TEXT SEARCH CONFIGURATION s_c12 ALTER MAPPING REPLACE english_stem WITH s_d12; DROP TEXT SEARCH DICTIONARY s_d12 CASCADE; SELECT count(*) FROM pg_ts_config WHERE cfgname = 's_c12'
ts.drop_builtin|DROP TEXT SEARCH DICTIONARY simple
ts.drop_if_exists|DROP TEXT SEARCH CONFIGURATION IF EXISTS no_such_cfg; DROP TEXT SEARCH DICTIONARY IF EXISTS no_such_dict; DROP TEXT SEARCH PARSER IF EXISTS no_such_prs; DROP TEXT SEARCH TEMPLATE IF EXISTS no_such_tmpl; DROP TEXT SEARCH TEMPLATE IF EXISTS no_such_schema.no_such_tmpl; SELECT 1
ts.drop_missing|DROP TEXT SEARCH PARSER test_tsparser_exists
ts.template_parser|CREATE TEXT SEARCH TEMPLATE s_t1 (lexize = dsimple_lexize); CREATE TEXT SEARCH TEMPLATE s_t2 (init = dsimple_init, lexize = dsimple_lexize); CREATE TEXT SEARCH DICTIONARY s_d13 (template = s_t2, stopwords = english); SELECT ts_lexize('s_d13', 'The'), ts_lexize('s_d13', 'Hi'); CREATE TEXT SEARCH PARSER s_p1 (start = prsd_start, gettoken = prsd_nexttoken, end = prsd_end, lextypes = prsd_lextype); SELECT tmplname, tmplinit, tmpllexize FROM pg_ts_template WHERE tmplname LIKE 's_t%' ORDER BY 1; SELECT prsname, prsstart, prsheadline FROM pg_ts_parser WHERE prsname = 's_p1'; CREATE TEXT SEARCH CONFIGURATION s_c13 (parser = s_p1); SELECT count(*) FROM pg_ts_config c JOIN pg_ts_parser p ON p.oid = c.cfgparser WHERE c.cfgname = 's_c13' AND p.prsname = 's_p1'
ts.template_errors1|CREATE TEXT SEARCH TEMPLATE s_t3 (init = dsimple_init)
ts.template_errors2|CREATE TEXT SEARCH TEMPLATE s_t4 (lexize = nosuchfn)
ts.template_errors3|CREATE TEXT SEARCH TEMPLATE tstemp_case ("Init" = init_function)
ts.parser_errors1|CREATE TEXT SEARCH PARSER tspars_case ("Start" = start_function)
ts.alter_generic|CREATE SCHEMA s_nsp1; CREATE SCHEMA s_nsp2; SET search_path = s_nsp1, public; CREATE TEXT SEARCH DICTIONARY alt_d1 (template = simple); CREATE TEXT SEARCH DICTIONARY alt_d2 (template = simple); ALTER TEXT SEARCH DICTIONARY alt_d1 RENAME TO alt_d3; ALTER TEXT SEARCH DICTIONARY alt_d2 SET SCHEMA s_nsp2; CREATE TEXT SEARCH CONFIGURATION alt_c1 (copy = english); ALTER TEXT SEARCH CONFIGURATION alt_c1 RENAME TO alt_c3; ALTER TEXT SEARCH CONFIGURATION alt_c3 SET SCHEMA s_nsp2; CREATE TEXT SEARCH TEMPLATE alt_t1 (lexize = dsimple_lexize); ALTER TEXT SEARCH TEMPLATE alt_t1 RENAME TO alt_t2; CREATE TEXT SEARCH PARSER alt_p1 (start = prsd_start, gettoken = prsd_nexttoken, end = prsd_end, lextypes = prsd_lextype); ALTER TEXT SEARCH PARSER alt_p1 SET SCHEMA s_nsp2; SELECT n.nspname, d.dictname FROM pg_ts_dict d JOIN pg_namespace n ON n.oid = d.dictnamespace WHERE n.nspname LIKE 's_nsp%' ORDER BY 1, 2; SELECT n.nspname, c.cfgname FROM pg_ts_config c JOIN pg_namespace n ON n.oid = c.cfgnamespace WHERE n.nspname LIKE 's_nsp%' ORDER BY 1, 2; SELECT 's_nsp2.alt_c3'::regconfig, to_tsvector('s_nsp2.alt_c3', 'Running dogs'); DROP SCHEMA s_nsp2 CASCADE; DROP SCHEMA s_nsp1 CASCADE
ts.alter_conflict|CREATE TEXT SEARCH DICTIONARY alt_e1 (template = simple); CREATE TEXT SEARCH DICTIONARY alt_e2 (template = simple); ALTER TEXT SEARCH DICTIONARY alt_e1 RENAME TO alt_e2
ts.alter_owner|DROP ROLE IF EXISTS s_tsr1; DROP ROLE IF EXISTS s_tsr2; CREATE ROLE s_tsr1; CREATE ROLE s_tsr2; CREATE TEXT SEARCH DICTIONARY alt_o1 (template = simple); ALTER TEXT SEARCH DICTIONARY alt_o1 OWNER TO s_tsr1; SELECT r.rolname FROM pg_ts_dict d JOIN pg_roles r ON r.oid = d.dictowner WHERE d.dictname = 'alt_o1'; GRANT CREATE ON SCHEMA public TO s_tsr2; SET ROLE s_tsr2; ALTER TEXT SEARCH DICTIONARY alt_o1 RENAME TO alt_o2
ts.alter_owner_missing_role|CREATE TEXT SEARCH DICTIONARY alt_o3 (template = simple); ALTER TEXT SEARCH DICTIONARY alt_o3 OWNER TO no_such_role_x
ts.parser_needs_superuser|DROP ROLE IF EXISTS s_tsr3; CREATE ROLE s_tsr3; SET ROLE s_tsr3; CREATE TEXT SEARCH PARSER s_p9 (start = prsd_start, gettoken = prsd_nexttoken, end = prsd_end, lextypes = prsd_lextype)
ts.rollback|BEGIN; CREATE TEXT SEARCH DICTIONARY s_rb (template = simple); ROLLBACK; SELECT count(*) FROM pg_ts_dict WHERE dictname = 's_rb'
ts.default_config|CREATE TEXT SEARCH CONFIGURATION s_def (copy = simple); SET default_text_search_config = 's_def'; SELECT get_current_ts_config(), to_tsvector('The Running Dogs')
ts.missing_config|SELECT to_tsvector('no_such_cfg', 'x')
ts.missing_dict|SELECT ts_lexize('no_such_dict', 'x')
ts.builtin_unchanged|SELECT to_tsvector('english', 'The quick brown foxes jumped over http://example.com/a/b and foo-bar2 abc123 1.5 1.2.3 user@example.com /usr/bin'); SELECT to_tsvector('russian', 'running собаки'); SELECT to_tsquery('english', 'running & dogs:*'); SELECT plainto_tsquery('english', 'the running dogs'); SELECT websearch_to_tsquery('english', '"running dogs" -cats or birds')
ts.alter_builtin|BEGIN; ALTER TEXT SEARCH CONFIGURATION english RENAME TO s_eng; SELECT 's_eng'::regconfig::oid, to_tsvector('s_eng', 'dogs'); SELECT count(*) FROM pg_ts_config WHERE cfgname = 'english'; ROLLBACK; SELECT 'english'::regconfig::oid
