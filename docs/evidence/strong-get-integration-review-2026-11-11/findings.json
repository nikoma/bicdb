  "findings": [
    {
      "id": "F1",
      "finding": "Missing authenticated authority-acquisition boundary when range leader differs from metadata leader.",
      "existing": [
        {
          "revision": "be82a20f708de36644fa7fdd33b5dbf002a7840b",
          "path": "crates/bicdb-core/src/distribution_consensus.rs",
          "symbols": [
            "MetadataConsensusStore::begin_read_authority",
            "MetadataConsensusStore::read_authority_probe",
            "MetadataConsensusStore::record_read_authority_ack",
            "MetadataConsensusStore::finish_read_authority",
            "MetadataReadAuthority"
          ]
        },
        {
          "revision": "be82a20f708de36644fa7fdd33b5dbf002a7840b",
          "path": "crates/bicdb-core/src/distribution_transport.rs",
          "symbols": [
            "ClusterDataRequest::MetadataReadProbe",
            "TcpClusterRelocationTransport::probe_metadata_read_authority"
          ]
        }
      ],
      "proposal": "Separate MetadataAuthorityProvider and range-leader-to-metadata-leader RPC with fresh request/context identity and authenticated opaque observation; or explicit execution relay. Bare serialized DTO is not a permit."
    },
    {
      "id": "F2",
      "finding": "Legacy event dispatch holds outer database read guard; listener starts before coordinator construction.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_transport.rs",
          "symbols": [
            "dispatch_cluster_data_request"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-pgwire/src/checkpoint_driver.rs",
          "symbols": [
            "RangeWriteCoordinator::new_schema_fenced",
            "install_commit_admission"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/db.rs",
          "symbols": [
            "BicDb::commit_admission_ready"
          ]
        }
      ],
      "proposal": "Separate StrongGet dispatch; release database/service locks before network; reorder construction or use an initially-empty installed coordinator handle. Admission object presence is not freshness."
    },
    {
      "id": "F3",
      "finding": "Reservation is private/fixed30seconds; recovery entrypoint reserves again and cached leadership recovery skips completed epochs.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_range_consensus.rs",
          "symbols": [
            "RANGE_ADMISSION_WAIT",
            "RangeWriteCoordinator::reserve_range",
            "RangeWriteCoordinator::recover_one_range_leadership",
            "RangeWriteCoordinator::recover_local_leadership",
            "recovered_epochs"
          ]
        }
      ],
      "proposal": "One request-deadline-aware reservation and fresh recovery inner method that consumes/borrows that guard; no nested reserve or cached recovered bit as authority."
    },
    {
      "id": "F4",
      "finding": "Prefix/tail recovery returns unit and counters rather than a request-scoped certified/applied floor.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_range_consensus.rs",
          "symbols": [
            "RangeWriteCoordinator::recover_leader_prefix",
            "RangeWriteCoordinator::recover_leader_tail",
            "RangeWriteProgress"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_data.rs",
          "symbols": [
            "ClusterDataNodeService::apply_range_write_leader_recovery",
            "ClusterDataNodeService::resolve_range_write_leader_tail"
          ]
        }
      ],
      "proposal": "Typed CertifiedAppliedRangeFloor preserving certificate/abort/configuration evidence. Keep ambiguity/divergence/snapshot refusal; prove ACK/read quorum and range reconfiguration intersection independently of metadata quorum."
    },
    {
      "id": "F5",
      "finding": "Learner source DB commit sequences are not range indexes; learner state is removed at completion; no installed durable range-image certified base is exposed.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_data.rs",
          "symbols": [
            "RangeLearnerApplyState",
            "RangeLearnerStore::finish_snapshot",
            "RangeLearnerStore::apply_commit_frames_with",
            "RangeLearnerStore::complete_relocation",
            "ClusterDataNodeService::apply_snapshot_step",
            "ClusterDataNodeService::apply_range_write_suffix"
          ]
        }
      ],
      "proposal": "Persist image/base identity and covered certified/resolved range prefix beyond learner cleanup; capture at verified fenced cut and prove crash-safe installation/extension. Do not equate database seq with range index or add only a discarded learner field."
    },
    {
      "id": "F6",
      "finding": "Coordinator active-range reservation is not shared by all physical image mutation paths.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_range_consensus.rs",
          "symbols": [
            "active_ranges"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_data.rs",
          "symbols": [
            "ClusterDataNodeService::apply_snapshot_step",
            "ClusterDataNodeService::apply_catch_up",
            "ClusterDataNodeService::apply_range_digest_repair_batch",
            "ClusterDataNodeService::cleanup_source_step"
          ]
        }
      ],
      "proposal": "Shared per-range image gate/generation includes relocation, repair, cleanup and restore; materialize result from snapshot proven to cover floor, keep owned value/stamp, release outer DB locks before final quorum."
    },
    {
      "id": "F7",
      "finding": "Current legacy local read and schema checks do not establish complete final strong-read semantic permit.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_events.rs",
          "symbols": [
            "execute_cluster_event"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_data.rs",
          "symbols": [
            "ClusterDataNodeService::schema_compatibility_allows"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/db.rs",
          "symbols": [
            "BicDb::check_recovery_state"
          ]
        },
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution.rs",
          "symbols": [
            "RangeDescriptor",
            "ClusterNode"
          ]
        }
      ],
      "proposal": "Revalidate range/token interval, epoch, leader/voters/identities/incarnation, restore, namespace, active/pending/live schema, reader capability, image identity and health. Ignore heartbeat-only generation changes; preserve old command epochs."
    },
    {
      "id": "F8",
      "finding": "Sequential recovery RPC/count bounds and metadata context expiration are not complete end-to-end I/O deadlines.",
      "existing": [
        {
          "revision": "d49a391b3c6157f90f29e9f2f5214143c60f9f4b",
          "path": "crates/bicdb-core/src/distribution_range_consensus.rs",
          "symbols": [
            "RangeWriteCoordinator::recover_leader_prefix",
            "RangeWriteCoordinator::recover_leader_tail"
          ]
        },
        {
          "revision": "be82a20f708de36644fa7fdd33b5dbf002a7840b",
          "path": "crates/bicdb-core/src/distribution_consensus.rs",
          "symbols": [
            "MetadataReadContext"
          ]
        }
      ],
      "proposal": "Propagate remaining budget and bounded parallel quorum work, completing on sufficient safe evidence instead of all-voter completion. Separate TCP deadline candidate is outside this review."
    }
  ],
  "healthy_positive_tests": [
    {
      "id": "P1",
      "required_behavior": "Different metadata/range leaders return exact prior-ACK value and genuine absence within finite budget.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P2",
      "required_behavior": "One voter unavailable but required quorums healthy: successful read without all-node wait.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P3",
      "required_behavior": "Authority epochE2 with retained certified command epochE1: successful exact read after valid recovery.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P4",
      "required_behavior": "Promoted/relocated image beyond retained history: certified base plus suffix works, including restart.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P5",
      "required_behavior": "Aborts advance resolved floor; provisional values remain invisible.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P6",
      "required_behavior": "Heartbeat-only global generations change continuously; stable semantic range still completes reads.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P7",
      "required_behavior": "Concurrent writes yield in-interval state; exact immutable prior-ACK payload remains visible.",
      "status": "proposed_not_executed_by_review"
    },
    {
      "id": "P8",
      "required_behavior": "Metadata leadership change with stable range semantics eventually succeeds through bounded retry.",
      "status": "proposed_not_executed_by_review"
    }
  ],
