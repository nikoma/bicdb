cx_raise|CREATE FUNCTION cx_raise(i integer) RETURNS int LANGUAGE plpgsql AS E'\nbegin\n  if i > 0 then\n    raise exception ''bad %'', i;\n  end if;\n  return i;\nend';SELECT cx_raise(3)
cx_assign|CREATE FUNCTION cx_assign(t text) RETURNS int LANGUAGE plpgsql AS E'\ndeclare\n  i int;\nbegin\n  i := t;\n  return i;\nend';SELECT cx_assign('x')
cx_div|CREATE FUNCTION cx_div(a int) RETURNS int LANGUAGE plpgsql AS E'\nbegin\n  return 10 / a;\nend';SELECT cx_div(0)
cx_nested|CREATE FUNCTION cx_inner(x int) RETURNS int LANGUAGE plpgsql AS E'\nbegin\n  raise exception ''inner %'', x;\nend';CREATE FUNCTION cx_outer() RETURNS int LANGUAGE plpgsql AS E'\ndeclare r int;\nbegin\n  r := cx_inner(5);\n  return r;\nend';SELECT cx_outer()
cx_perform|CREATE FUNCTION cx_pin(x int) RETURNS int LANGUAGE plpgsql AS E'\nbegin\n  raise exception ''pin %'', x;\nend';CREATE FUNCTION cx_pout() RETURNS void LANGUAGE plpgsql AS E'\nbegin\n  perform cx_pin(1);\nend';SELECT cx_pout()
cx_trigger|CREATE TABLE cx_tt(a int);CREATE FUNCTION cx_tf() RETURNS trigger LANGUAGE plpgsql AS E'\nbegin\n  if new.a < 0 then\n    raise exception ''negative %'', new.a;\n  end if;\n  return new;\nend';CREATE TRIGGER cx_tg BEFORE INSERT ON cx_tt FOR EACH ROW EXECUTE FUNCTION cx_tf();INSERT INTO cx_tt VALUES (-1)
cx_do|DO $$begin raise exception 'from do'; end$$
cx_strict|CREATE TABLE cx_s(a int);CREATE FUNCTION cx_strict() RETURNS void LANGUAGE plpgsql AS E'\ndeclare x int;\nbegin\n  select a into strict x from cx_s;\nend';SELECT cx_strict()
cx_char|CREATE FUNCTION cx_two(a character, b character) RETURNS void LANGUAGE plpgsql AS E'\nbegin\n  raise exception ''two'';\nend';SELECT cx_two('a','b')
cx_sqlfn|CREATE TABLE cx_q(a int);INSERT INTO cx_q VALUES (0);CREATE FUNCTION cx_sqlfn() RETURNS int LANGUAGE sql AS $$SELECT 1/a FROM cx_q$$;SELECT cx_sqlfn()
cx_loop|CREATE FUNCTION cx_loop() RETURNS void LANGUAGE plpgsql AS E'\ndeclare i int;\nbegin\n  for i in 1..3 loop\n    if i = 2 then\n      raise exception ''at %'', i;\n    end if;\n  end loop;\nend';SELECT cx_loop()
cx_handler|CREATE FUNCTION cx_handler() RETURNS text LANGUAGE plpgsql AS E'\nbegin\n  begin\n    raise exception ''first'';\n  exception when others then\n    return ''caught '' || sqlerrm;\n  end;\nend';SELECT cx_handler()
cx_notice|CREATE FUNCTION cx_notice() RETURNS int LANGUAGE plpgsql AS E'\nbegin\n  raise notice ''hello'';\n  return 1;\nend';SELECT cx_notice()
cx_chain|CREATE TABLE cx_ct(a int);CREATE FUNCTION cx_ctf() RETURNS trigger LANGUAGE plpgsql AS E'\nbegin\n  raise exception ''trigger says no'';\nend';CREATE TRIGGER cx_ctg BEFORE INSERT ON cx_ct FOR EACH ROW EXECUTE FUNCTION cx_ctf();CREATE FUNCTION cx_cins() RETURNS void LANGUAGE plpgsql AS E'\nbegin\n  insert into cx_ct values (1);\nend';SELECT cx_cins()
cx_while|CREATE FUNCTION cx_while() RETURNS void LANGUAGE plpgsql AS E'\ndeclare i int := 0;\nbegin\n  while 10 / (2 - i) > 0 loop\n    i := i + 1;\n  end loop;\nend';SELECT cx_while()
sd_show|SHOW max_stack_depth;SET max_stack_depth = '100kB';SHOW max_stack_depth;RESET max_stack_depth;SHOW max_stack_depth
sd_bad|SET max_stack_depth = '50'
sd_big|SET max_stack_depth = '100MB'
sd_unit|SET max_stack_depth = '1 xyz'
sd_json|SET max_stack_depth = '100kB';SELECT repeat('[', 10000)::json
fn_xact|BEGIN;SELECT pg_current_xact_id() = pg_current_xact_id_if_assigned();COMMIT;SELECT pg_current_xact_id_if_assigned() IS NULL
fn_toreg3|SELECT to_regtypemod('bogus type')
fn_toreg2|SELECT to_regcollation('"POSIX"'), to_regcollation('nosuch'), to_regoper('nosuch')
fn_depth|CREATE TABLE fd_t(a int);CREATE FUNCTION fd_f() RETURNS trigger LANGUAGE plpgsql AS $$begin raise notice 'depth %', pg_trigger_depth(); return new; end$$;CREATE TRIGGER fd_g BEFORE INSERT ON fd_t FOR EACH ROW EXECUTE FUNCTION fd_f();SELECT pg_trigger_depth();INSERT INTO fd_t VALUES (1)
fn_gcd|SELECT gcd(4.0, 6.0), lcm(4.0, 6.0), gcd(12.5, 5), lcm(0.5, 0.75), gcd('NaN'::numeric, 1)
fn_adj|SELECT range_adjacent(int4range(1,2), int4range(2,3)), range_adjacent(int4range(1,2), int4range(3,4))
fn_casefold|SELECT casefold('ABC'), casefold('aBc')
fn_gamma_err|SELECT gamma(0)
fn_gamma_err2|SELECT gamma(-1)
fn_lgamma_err|SELECT lgamma(0)
fn_gamma_big|SELECT gamma(200)
