    "SELECT @-@ '[(0,0),(3,4)]'::lseg, @-@ '[(0,0),(3,4)]'::path, @@ '(0,0),(4,2)'::box, # '((0,0),(1,0),(1,1))'::path, ?- '[(0,0),(3,0)]'::lseg, ?| '[(0,0),(0,3)]'::lseg;",
    "SELECT '[(0,0),(3,4)]'::lseg = '[(3,4),(0,0)]'::lseg, '[(0,0),(3,4)]'::lseg < '[(0,0),(6,8)]'::lseg, '(0,0),(2,2)'::box = '(0,0),(1,4)'::box, '(0,0),(2,2)'::box ~= '(0,0),(1,4)'::box, point(0,0) <> point(1,1), '{1,-1,0}'::line = '{2,-2,0}'::line, '((0,0),(1,0),(1,1))'::polygon ~= '((1,0),(1,1),(0,0))'::polygon;",
    "SELECT point(1,0) <@ '[(0,0),(2,0)]'::lseg, point(1,1) <@ '(0,0),(2,2)'::box, '(0,0),(1,1)'::box <@ '(0,0),(2,2)'::box, point(1,1) <@ '((0,0),(2,0),(2,2),(0,2))'::polygon, point(1,1) <@ '<(0,0),2>'::circle, '<(0,0),1>'::circle <@ '<(0,0),2>'::circle;",
    "SELECT '[(0,0),(2,2)]'::lseg ?# '[(0,2),(2,0)]'::lseg, '{1,-1,0}'::line ?# '{1,1,-2}'::line, '(0,0),(2,2)'::box ?# '(1,1),(3,3)'::box, '((0,0),(2,0))'::path ?# '((1,-1),(1,1))'::path, '(0,0),(2,2)'::box && '(1,1),(3,3)'::box;",
    "SELECT point(0,0) <-> point(3,4), point(1,3) <-> '[(0,0),(2,0)]'::lseg, point(5,1) <-> '(0,0),(2,2)'::box, point(5,0) <-> '<(0,0),2>'::circle, '(0,0),(2,2)'::box <-> '(2,0),(4,2)'::box, '<(0,0),1>'::circle <-> '<(5,0),2>'::circle;",
    "SELECT '{1,-1,0}'::line # '{1,1,-2}'::line, '[(0,0),(2,2)]'::lseg # '[(0,2),(2,0)]'::lseg, point(2,3) ## '[(0,0),(4,0)]'::lseg;",
    "SELECT '[(1,1),(2,2)]'::lseg ## '(0,0),(3,3)'::box, '[(1,1),(4,4)]'::lseg ## '(0,0),(3,3)'::box, '[(0,0),(2,0)]'::lseg ## '[(3,1),(3,3)]'::lseg, '[(3,1),(3,3)]'::lseg ## '[(0,0),(2,0)]'::lseg, '{0,1,0}'::line ## '[(0,2),(3,2)]'::lseg;",
