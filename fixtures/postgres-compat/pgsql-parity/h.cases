expr.err_list_multi|create table h1e13 (a int, b int) partition by list (a, b)
expr.err_magic|create table h1e14 (a int) partition by magic (a)
expr.err_record|create table h1e15 (a int, b int) partition by range (((a, b)))
expr.err_unknown_literal|create table h1e16 (a int, b int) partition by range (a, ('unknown'))
expr.err_udf_const|create function h1cf() returns int language sql immutable as $$ select 1 $$; create table h1e17 (a int) partition by range (h1cf())
expr.err_udf_volatile|create function h1vf(a int) returns int language sql as $$ select a $$; create table h1e18 (a int) partition by range (h1vf(a))
expr.err_udf_setof|create function h1sf(a int) returns setof int language sql immutable as $$ select 1 $$; create table h1e19 (a int) partition by range (h1sf(a))
expr.err_minvalue_tail|create table h1mv (a int, b int, c int) partition by range (a, abs(b), c); create table h1mv_0 partition of h1mv for values from (minvalue, 0, 0) to (1, maxvalue, maxvalue)
expr.err_maxvalue_tail|create table h1mx (a int, b int, c int) partition by range (a, abs(b), c); create table h1mx_2 partition of h1mx for values from (10, 6, minvalue) to (10, maxvalue, minvalue)
