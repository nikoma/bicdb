ctas.basic|CREATE TABLE ctas_b1 AS SELECT generate_series(1,3) a; SELECT a FROM ctas_b1 ORDER BY a
ctas.column_types|CREATE TABLE ctas_t1(i int, v varchar(10), n numeric(8,2), ts timestamp(3), c char(4), b bigint, f float8, d date, bo boolean, j jsonb, arr int[]); CREATE TABLE ctas_t2 AS SELECT i, v, n, ts, c, b, f, d, bo, j, arr, i+1, 'lit' AS lit, 1.5 AS lit_num, v::varchar(3) AS v3, n::numeric(4,1) AS n4, 'x'::text AS t, NULL AS nul, b*2 AS b2 FROM ctas_t1; SELECT attname, format_type(atttypid, atttypmod), attnotnull FROM pg_attribute WHERE attrelid='ctas_t2'::regclass AND attnum>0 ORDER BY attnum
ctas.rows|CREATE TABLE ctas_r1(i int, v varchar(10), n numeric(8,2)); INSERT INTO ctas_r1 VALUES (1,'x',1.5),(2,NULL,2.25),(3,'zz',NULL); CREATE TABLE ctas_r2 AS SELECT i, v, n, i*10 AS t FROM ctas_r1 WHERE i < 3; SELECT * FROM ctas_r2 ORDER BY i
ctas.column_names|CREATE TABLE ctas_c1(x, y) AS SELECT 1 AS a, 2 AS b, 3 AS c; SELECT * FROM ctas_c1; SELECT attname FROM pg_attribute WHERE attrelid='ctas_c1'::regclass AND attnum>0 ORDER BY attnum
ctas.with_no_data|CREATE TABLE ctas_n1 AS SELECT 1 AS a, 'x'::varchar(5) AS b WITH NO DATA; SELECT count(*) FROM ctas_n1; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid='ctas_n1'::regclass AND attnum>0 ORDER BY attnum
ctas.with_data|CREATE TABLE ctas_w1 AS SELECT 1 AS a WITH DATA; SELECT * FROM ctas_w1
ctas.names_and_no_data|CREATE TABLE ctas_nd(p, q) AS SELECT 1, 'two' WITH NO DATA; INSERT INTO ctas_nd VALUES (7, 'seven'); SELECT * FROM ctas_nd
ctas.if_not_exists|CREATE TABLE ctas_e1 AS SELECT 1 AS a; CREATE TABLE IF NOT EXISTS ctas_e1 AS SELECT 2 AS a; SELECT * FROM ctas_e1
ctas.exists_error|CREATE TABLE ctas_e2 AS SELECT 1 a; SELECT 'before'; CREATE TABLE ctas_e2 AS SELECT 2 a
ctas.temp|CREATE TEMP TABLE ctas_tt AS SELECT 1 a; SELECT * FROM ctas_tt
ctas.as_table|CREATE TABLE ctas_s(a int); INSERT INTO ctas_s VALUES (2),(1); CREATE TABLE ctas_s2 AS TABLE ctas_s; SELECT * FROM ctas_s2 ORDER BY a
ctas.union|CREATE TABLE ctas_u AS SELECT 1 a UNION ALL SELECT 2 ORDER BY 1; SELECT * FROM ctas_u ORDER BY 1
ctas.values|CREATE TABLE ctas_v AS VALUES (1, 'a'), (2, 'b'); SELECT * FROM ctas_v ORDER BY 1; SELECT attname FROM pg_attribute WHERE attrelid='ctas_v'::regclass AND attnum>0 ORDER BY attnum
ctas.cte|CREATE TABLE ctas_q AS WITH x AS (SELECT 5 AS v) SELECT v*2 AS w FROM x; SELECT * FROM ctas_q
ctas.id_is_not_a_key|CREATE TABLE ctas_id AS SELECT 1 AS id UNION ALL SELECT 1; INSERT INTO ctas_id VALUES (1); SELECT count(*) FROM ctas_id
ctas.question_column|CREATE TABLE ctas_qc AS SELECT 1+1, 2 AS two, 'x'::text, 1::int, upper('a'), CASE WHEN true THEN 1 END, CASE WHEN true THEN 1 ELSE 2::bigint END, (SELECT 5 AS inner_name), EXISTS (SELECT 1), ARRAY[1], now()::date; SELECT attname FROM pg_attribute WHERE attrelid='ctas_qc'::regclass AND attnum>0 ORDER BY attnum
ctas.too_many_names|SELECT 'start'; CREATE TABLE ctas_tm(a, b) AS SELECT 1
ctas.duplicate_names|SELECT 'start'; CREATE TABLE ctas_dn AS SELECT 1 a, 2 a
ctas.atomic_failure|CREATE TABLE ctas_af AS SELECT 1/(3-g) AS x FROM generate_series(1,3) g; SELECT 'unreachable'
ctas.in_transaction_rollback|BEGIN; CREATE TABLE ctas_tx AS SELECT 1 a; ROLLBACK; SELECT count(*) FROM pg_class WHERE relname='ctas_tx'
ctas.in_transaction_commit|BEGIN; CREATE TABLE ctas_tc AS SELECT 1 a; INSERT INTO ctas_tc VALUES (2); COMMIT; SELECT * FROM ctas_tc ORDER BY a
ctas.schema_qualified|CREATE SCHEMA ctas_ns; CREATE TABLE ctas_ns.t AS SELECT 1 AS a; SELECT * FROM ctas_ns.t
ctas.select_privilege|DROP ROLE IF EXISTS ctas_r; CREATE ROLE ctas_r; CREATE TABLE ctas_sec(a int); INSERT INTO ctas_sec VALUES (1); GRANT CREATE ON SCHEMA public TO ctas_r; SET ROLE ctas_r; SELECT 'as role'; CREATE TABLE ctas_sec2 AS SELECT * FROM ctas_sec
ctas.row_level_security|DROP ROLE IF EXISTS ctas_rr; CREATE ROLE ctas_rr; CREATE TABLE ctas_rls(a int, who text); INSERT INTO ctas_rls VALUES (1,'ctas_rr'),(2,'other'),(3,'ctas_rr'); ALTER TABLE ctas_rls ENABLE ROW LEVEL SECURITY; CREATE POLICY ctas_p ON ctas_rls USING (who = current_user); GRANT SELECT ON ctas_rls TO ctas_rr; GRANT CREATE ON SCHEMA public TO ctas_rr; SET ROLE ctas_rr; CREATE TABLE ctas_rls2 AS SELECT a FROM ctas_rls; SELECT a FROM ctas_rls2 ORDER BY a
select_into.basic|SELECT * INTO si_1 FROM (VALUES (1,'a'),(2,'b')) v(a,b); SELECT * FROM si_1 ORDER BY a
select_into.temp|SELECT 1 AS a, 'x' AS b INTO TEMP si_2; SELECT * FROM si_2
select_into.table_keyword|SELECT 3 AS a INTO TABLE si_3; SELECT * FROM si_3
select_into.where_order|CREATE TABLE si_src(a int, b text); INSERT INTO si_src VALUES (1,'x'),(2,'y'),(3,'z'); SELECT b, a INTO si_4 FROM si_src WHERE a > 1 ORDER BY a; SELECT * FROM si_4 ORDER BY a; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid='si_4'::regclass AND attnum>0 ORDER BY attnum
select_into.union|SELECT 1 AS a INTO si_5 UNION SELECT 2; SELECT * FROM si_5 ORDER BY a
select_into.exists|CREATE TABLE si_6(a int); SELECT 'start'; SELECT 1 INTO si_6
select_into.nested_rejected|SELECT 'start'; SELECT * FROM (SELECT 1 AS a INTO si_7) s
view.insert_update_delete|CREATE TABLE uv_b(a int, b text); CREATE VIEW uv_v AS SELECT a, b FROM uv_b; INSERT INTO uv_v VALUES (1, 'x'), (2, 'y'); UPDATE uv_v SET b = 'z' WHERE a = 2; DELETE FROM uv_v WHERE a = 1; SELECT * FROM uv_b ORDER BY a
view.returning|CREATE TABLE uv_r(id int, v int); CREATE VIEW uv_rv AS SELECT id AS key, v, v * 2 AS doubled FROM uv_r; INSERT INTO uv_rv (key, v) VALUES (1, 10) RETURNING *; UPDATE uv_rv SET v = v + 1 WHERE key = 1 RETURNING key, doubled; DELETE FROM uv_rv WHERE doubled > 0 RETURNING v
view.where_filters_update_delete|CREATE TABLE uv_w(a int); INSERT INTO uv_w VALUES (1), (5), (10); CREATE VIEW uv_wv AS SELECT a FROM uv_w WHERE a > 3; UPDATE uv_wv SET a = a + 100; DELETE FROM uv_wv WHERE a = 110; SELECT a FROM uv_w ORDER BY a
view.insert_outside_where_no_check|CREATE TABLE uv_n(a int); CREATE VIEW uv_nv AS SELECT a FROM uv_n WHERE a > 0; INSERT INTO uv_nv VALUES (-5); SELECT a FROM uv_n; SELECT count(*) FROM uv_nv
view.renamed_and_partial_columns|CREATE TABLE uv_p(a int, b int DEFAULT 7, c int); CREATE VIEW uv_pv AS SELECT c AS first, a AS second FROM uv_p; INSERT INTO uv_pv VALUES (1, 2); INSERT INTO uv_pv (second) VALUES (3); UPDATE uv_pv SET first = 9 WHERE second = 3; SELECT a, b, c FROM uv_p ORDER BY a
view.nested|CREATE TABLE uv_nb(a int, b int); CREATE VIEW uv_n1 AS SELECT a, b FROM uv_nb WHERE a > 0; CREATE VIEW uv_n2 AS SELECT b AS bb, a FROM uv_n1 WHERE b < 100; INSERT INTO uv_n2 (a, bb) VALUES (1, 2); UPDATE uv_n2 SET bb = 50 WHERE a = 1; SELECT * FROM uv_nb; DELETE FROM uv_n2; SELECT count(*) FROM uv_nb
view.star|CREATE TABLE uv_s(a int, b text); CREATE VIEW uv_sv AS SELECT * FROM uv_s; INSERT INTO uv_sv VALUES (1, 'one'); UPDATE uv_sv SET b = 'uno'; SELECT * FROM uv_sv
view.computed_column_insert|CREATE TABLE uv_c(a int); CREATE VIEW uv_cv AS SELECT a, a * 2 AS twice FROM uv_c; SELECT 'start'; INSERT INTO uv_cv (a, twice) VALUES (1, 2)
view.computed_column_update|CREATE TABLE uv_cu(a int); CREATE VIEW uv_cuv AS SELECT a, a * 2 AS twice FROM uv_cu; SELECT 'start'; UPDATE uv_cuv SET twice = 3
view.not_updatable_aggregate|CREATE TABLE uv_g(a int); CREATE VIEW uv_gv AS SELECT count(*) AS n FROM uv_g; SELECT 'start'; INSERT INTO uv_gv VALUES (1)
view.not_updatable_distinct|CREATE TABLE uv_d(a int); CREATE VIEW uv_dv AS SELECT DISTINCT a FROM uv_d; SELECT 'start'; DELETE FROM uv_dv
view.not_updatable_join|CREATE TABLE uv_j1(a int); CREATE TABLE uv_j2(a int); CREATE VIEW uv_jv AS SELECT uv_j1.a FROM uv_j1 JOIN uv_j2 ON uv_j1.a = uv_j2.a; SELECT 'start'; UPDATE uv_jv SET a = 1
view.not_updatable_union|CREATE TABLE uv_u(a int); CREATE VIEW uv_uv AS SELECT a FROM uv_u UNION SELECT a FROM uv_u; SELECT 'start'; DELETE FROM uv_uv
view.not_updatable_limit|CREATE TABLE uv_l(a int); CREATE VIEW uv_lv AS SELECT a FROM uv_l LIMIT 5; SELECT 'start'; INSERT INTO uv_lv VALUES (1)
view.hidden_column_not_reachable|CREATE TABLE uv_h(a int, secret int); INSERT INTO uv_h VALUES (1, 42); CREATE VIEW uv_hv AS SELECT a FROM uv_h; SELECT 'start'; DELETE FROM uv_hv WHERE secret = 42
view.base_name_not_in_scope|CREATE TABLE uv_bn(a int, secret int); INSERT INTO uv_bn VALUES (1, 42); CREATE VIEW uv_bnv AS SELECT a FROM uv_bn; SELECT 'start'; UPDATE uv_bnv SET a = 2 WHERE uv_bn.secret = 42
view.subquery_in_where|CREATE TABLE uv_q(a int); CREATE TABLE uv_q2(a int); INSERT INTO uv_q VALUES (1), (2), (3); INSERT INTO uv_q2 VALUES (2); CREATE VIEW uv_qv AS SELECT a FROM uv_q; DELETE FROM uv_qv WHERE a IN (SELECT a FROM uv_q2); UPDATE uv_qv SET a = a * 10 WHERE EXISTS (SELECT 1 FROM uv_q2 WHERE uv_q2.a < uv_qv.a); SELECT a FROM uv_q ORDER BY a
view.check_option_cascaded|CREATE TABLE ck_b(a int); CREATE VIEW ck_v AS SELECT a FROM ck_b WHERE a > 0 WITH CHECK OPTION; INSERT INTO ck_v VALUES (1); SELECT count(*) FROM ck_b; INSERT INTO ck_v VALUES (-1)
view.check_option_update|CREATE TABLE ck_u(a int); INSERT INTO ck_u VALUES (5); CREATE VIEW ck_uv AS SELECT a FROM ck_u WHERE a > 0 WITH LOCAL CHECK OPTION; UPDATE ck_uv SET a = a + 1; SELECT a FROM ck_u; UPDATE ck_uv SET a = -a
view.check_option_rolls_back|CREATE TABLE ck_r(a int); CREATE VIEW ck_rv AS SELECT a FROM ck_r WHERE a < 10 WITH CHECK OPTION; BEGIN; INSERT INTO ck_rv VALUES (1); SAVEPOINT s; INSERT INTO ck_rv VALUES (2), (20); SELECT 'unreachable'
view.check_option_cascaded_nested|CREATE TABLE ck_n(a int); CREATE VIEW ck_n1 AS SELECT a FROM ck_n WHERE a > 0; CREATE VIEW ck_n2 AS SELECT a FROM ck_n1 WHERE a < 10 WITH CASCADED CHECK OPTION; INSERT INTO ck_n2 VALUES (5); SELECT count(*) FROM ck_n; INSERT INTO ck_n2 VALUES (-5)
view.check_option_local_nested|CREATE TABLE ck_l(a int); CREATE VIEW ck_l1 AS SELECT a FROM ck_l WHERE a > 0; CREATE VIEW ck_l2 AS SELECT a FROM ck_l1 WHERE a < 10 WITH LOCAL CHECK OPTION; INSERT INTO ck_l2 VALUES (-5); SELECT count(*) FROM ck_l; INSERT INTO ck_l2 VALUES (50)
view.check_option_lower_view|CREATE TABLE ck_w(a int); CREATE VIEW ck_w1 AS SELECT a FROM ck_w WHERE a > 0 WITH CHECK OPTION; CREATE VIEW ck_w2 AS SELECT a FROM ck_w1 WHERE a < 10; INSERT INTO ck_w2 VALUES (50); SELECT count(*) FROM ck_w; INSERT INTO ck_w2 VALUES (-1)
view.check_option_with_option|CREATE TABLE ck_o(a int); CREATE VIEW ck_ov WITH (check_option = local) AS SELECT a FROM ck_o WHERE a > 0; INSERT INTO ck_ov VALUES (3); SELECT * FROM ck_o; INSERT INTO ck_ov VALUES (0)
view.check_option_requires_updatable|CREATE TABLE ck_x(a int); SELECT 'start'; CREATE VIEW ck_xv AS SELECT DISTINCT a FROM ck_x WITH CHECK OPTION
view.check_option_null_fails|CREATE TABLE ck_z(a int); CREATE VIEW ck_zv AS SELECT a FROM ck_z WHERE a > 0 WITH CHECK OPTION; SELECT 'start'; INSERT INTO ck_zv VALUES (NULL)
view.privilege_definer|DROP ROLE IF EXISTS uv_role1; CREATE ROLE uv_role1; CREATE TABLE uv_pd(a int); CREATE VIEW uv_pdv AS SELECT a FROM uv_pd; GRANT INSERT, SELECT ON uv_pdv TO uv_role1; SET ROLE uv_role1; INSERT INTO uv_pdv VALUES (1); SELECT a FROM uv_pdv; RESET ROLE; SELECT a FROM uv_pd
view.privilege_view_required|DROP ROLE IF EXISTS uv_role2; CREATE ROLE uv_role2; CREATE TABLE uv_pr(a int); CREATE VIEW uv_prv AS SELECT a FROM uv_pr; GRANT SELECT ON uv_prv TO uv_role2; SET ROLE uv_role2; SELECT 'start'; INSERT INTO uv_prv VALUES (1)
view.privilege_invoker|DROP ROLE IF EXISTS uv_role3; CREATE ROLE uv_role3; CREATE TABLE uv_pi(a int); CREATE VIEW uv_piv WITH (security_invoker = true) AS SELECT a FROM uv_pi; GRANT INSERT ON uv_piv TO uv_role3; SET ROLE uv_role3; SELECT 'start'; INSERT INTO uv_piv VALUES (1)
view.rls_invoker|DROP ROLE IF EXISTS uv_role4; CREATE ROLE uv_role4; CREATE TABLE uv_rl(a int, who text); INSERT INTO uv_rl VALUES (1, 'uv_role4'), (2, 'other'); ALTER TABLE uv_rl ENABLE ROW LEVEL SECURITY; CREATE POLICY uv_rlp ON uv_rl USING (who = current_user); GRANT SELECT, UPDATE, DELETE ON uv_rl TO uv_role4; CREATE VIEW uv_rlv WITH (security_invoker = true) AS SELECT a, who FROM uv_rl; GRANT SELECT, UPDATE, DELETE ON uv_rlv TO uv_role4; SET ROLE uv_role4; UPDATE uv_rlv SET a = a + 10; DELETE FROM uv_rlv WHERE who = 'other'; RESET ROLE; SELECT a, who FROM uv_rl ORDER BY a
view.rls_owner_bypass|CREATE TABLE uv_ro(a int, who text); INSERT INTO uv_ro VALUES (1, 'x'), (2, 'y'); ALTER TABLE uv_ro ENABLE ROW LEVEL SECURITY; CREATE POLICY uv_rop ON uv_ro USING (who = 'x'); CREATE VIEW uv_rov AS SELECT a FROM uv_ro; UPDATE uv_rov SET a = a + 10; SELECT a FROM uv_ro ORDER BY a
matview.snapshot_and_refresh|CREATE TABLE mv_s(a int); INSERT INTO mv_s VALUES (1), (2); CREATE MATERIALIZED VIEW mv_sv AS SELECT count(*) AS n, sum(a) AS total FROM mv_s; INSERT INTO mv_s VALUES (3); SELECT * FROM mv_sv; REFRESH MATERIALIZED VIEW mv_sv; SELECT * FROM mv_sv
matview.with_no_data|CREATE TABLE mv_n(a int); INSERT INTO mv_n VALUES (1); CREATE MATERIALIZED VIEW mv_nv AS SELECT a FROM mv_n WITH NO DATA; SELECT relname, relkind FROM pg_class WHERE relname = 'mv_nv'; SELECT * FROM mv_nv
matview.refresh_with_data|CREATE TABLE mv_d(a int); INSERT INTO mv_d VALUES (7); CREATE MATERIALIZED VIEW mv_dv AS SELECT a FROM mv_d WITH NO DATA; REFRESH MATERIALIZED VIEW mv_dv WITH DATA; SELECT * FROM mv_dv; REFRESH MATERIALIZED VIEW mv_dv WITH NO DATA; SELECT 'emptied'; SELECT * FROM mv_dv
matview.create_with_data|CREATE TABLE mv_w(a int); INSERT INTO mv_w VALUES (4); CREATE MATERIALIZED VIEW mv_wv AS SELECT a * 2 AS b FROM mv_w WITH DATA; SELECT * FROM mv_wv
matview.not_updatable|CREATE TABLE mv_u(a int); CREATE MATERIALIZED VIEW mv_uv AS SELECT a FROM mv_u; SELECT 'start'; INSERT INTO mv_uv VALUES (1)
matview.not_deletable|CREATE TABLE mv_x(a int); CREATE MATERIALIZED VIEW mv_xv AS SELECT a FROM mv_x; SELECT 'start'; DELETE FROM mv_xv
matview.refresh_not_matview|CREATE TABLE mv_t(a int); SELECT 'start'; REFRESH MATERIALIZED VIEW mv_t
matview.refresh_missing|SELECT 'start'; REFRESH MATERIALIZED VIEW mv_missing
matview.concurrently_needs_unique_index|CREATE TABLE mv_c(a int); CREATE MATERIALIZED VIEW mv_cv AS SELECT a FROM mv_c; SELECT 'start'; REFRESH MATERIALIZED VIEW CONCURRENTLY mv_cv
matview.concurrently_with_unique_index|CREATE TABLE mv_ci(a int); INSERT INTO mv_ci VALUES (1); CREATE MATERIALIZED VIEW mv_civ AS SELECT a FROM mv_ci; CREATE UNIQUE INDEX mv_civ_a ON mv_civ (a); INSERT INTO mv_ci VALUES (2); REFRESH MATERIALIZED VIEW CONCURRENTLY mv_civ; SELECT a FROM mv_civ ORDER BY a
matview.concurrently_unpopulated|CREATE TABLE mv_cu(a int); CREATE MATERIALIZED VIEW mv_cuv AS SELECT a FROM mv_cu WITH NO DATA; CREATE UNIQUE INDEX mv_cuv_a ON mv_cuv (a); SELECT 'start'; REFRESH MATERIALIZED VIEW CONCURRENTLY mv_cuv
matview.refresh_in_rolled_back_transaction|CREATE TABLE mv_r(a int); INSERT INTO mv_r VALUES (1); CREATE MATERIALIZED VIEW mv_rv AS SELECT count(*) AS n FROM mv_r; INSERT INTO mv_r VALUES (2); BEGIN; REFRESH MATERIALIZED VIEW mv_rv; SELECT n FROM mv_rv; ROLLBACK; SELECT n FROM mv_rv
matview.refresh_requires_owner|DROP ROLE IF EXISTS mv_role; CREATE ROLE mv_role; CREATE TABLE mv_o(a int); CREATE MATERIALIZED VIEW mv_ov AS SELECT a FROM mv_o; GRANT SELECT ON mv_ov TO mv_role; SET ROLE mv_role; SELECT count(*) FROM mv_ov; REFRESH MATERIALIZED VIEW mv_ov
matview.columns|CREATE TABLE mv_k(a int, v varchar(5)); CREATE MATERIALIZED VIEW mv_kv AS SELECT a, v, a + 1 AS b FROM mv_k; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'mv_kv'::regclass AND attnum > 0 ORDER BY attnum
view.information_schema|CREATE TABLE is_b(a int); CREATE VIEW is_v1 AS SELECT a FROM is_b WHERE a > 0 WITH LOCAL CHECK OPTION; CREATE VIEW is_v2 AS SELECT count(*) FROM is_b; CREATE VIEW is_v3 AS SELECT a + 1 AS b FROM is_b; SELECT table_name, check_option, is_updatable, is_insertable_into FROM information_schema.views WHERE table_name LIKE 'is_v%' ORDER BY table_name
trigger.instead_of_insert|CREATE TABLE io_b(a int, note text); CREATE VIEW io_v AS SELECT a, upper(note) AS note FROM io_b; CREATE FUNCTION io_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN INSERT INTO io_b VALUES (NEW.a * 10, lower(NEW.note)); RETURN NEW; END$$; CREATE TRIGGER io_t INSTEAD OF INSERT ON io_v FOR EACH ROW EXECUTE FUNCTION io_f(); INSERT INTO io_v VALUES (1, 'AbC'), (2, 'x') RETURNING *; SELECT * FROM io_b ORDER BY a
trigger.instead_of_update_delete|CREATE TABLE iu_b(a int, b int); INSERT INTO iu_b VALUES (1, 1), (2, 2); CREATE VIEW iu_v AS SELECT a, b, a + b AS s FROM iu_b; CREATE FUNCTION iu_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN IF TG_OP = 'UPDATE' THEN UPDATE iu_b SET b = NEW.b WHERE a = OLD.a; RETURN NEW; ELSE DELETE FROM iu_b WHERE a = OLD.a; RETURN OLD; END IF; END$$; CREATE TRIGGER iu_t INSTEAD OF UPDATE OR DELETE ON iu_v FOR EACH ROW EXECUTE FUNCTION iu_f(); UPDATE iu_v SET b = 50 WHERE a = 2 RETURNING a, b; DELETE FROM iu_v WHERE s = 2 RETURNING a; SELECT * FROM iu_b ORDER BY a
trigger.instead_of_returns_null|CREATE TABLE in_b(a int); CREATE VIEW in_v AS SELECT a FROM in_b; CREATE FUNCTION in_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN IF NEW.a > 1 THEN INSERT INTO in_b VALUES (NEW.a); RETURN NEW; END IF; RETURN NULL; END$$; CREATE TRIGGER in_t INSTEAD OF INSERT ON in_v FOR EACH ROW EXECUTE FUNCTION in_f(); WITH r AS (INSERT INTO in_v VALUES (1), (2), (3) RETURNING a) SELECT count(*) FROM r; SELECT * FROM in_b ORDER BY a
trigger.instead_of_on_table_rejected|CREATE TABLE it_b(a int); CREATE FUNCTION it_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN RETURN NEW; END$$; SELECT 'start'; CREATE TRIGGER it_t INSTEAD OF INSERT ON it_b FOR EACH ROW EXECUTE FUNCTION it_f()
trigger.before_on_view_rejected|CREATE TABLE ib_b(a int); CREATE VIEW ib_v AS SELECT a FROM ib_b; CREATE FUNCTION ib_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN RETURN NEW; END$$; SELECT 'start'; CREATE TRIGGER ib_t BEFORE INSERT ON ib_v FOR EACH ROW EXECUTE FUNCTION ib_f()
trigger.instead_of_on_non_updatable_view|CREATE TABLE ig_b(a int); CREATE TABLE ig_log(n bigint); CREATE VIEW ig_v AS SELECT count(*) AS n FROM ig_b; CREATE FUNCTION ig_f() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN INSERT INTO ig_log VALUES (NEW.n); RETURN NEW; END$$; CREATE TRIGGER ig_t INSTEAD OF INSERT ON ig_v FOR EACH ROW EXECUTE FUNCTION ig_f(); INSERT INTO ig_v VALUES (42); SELECT * FROM ig_log
