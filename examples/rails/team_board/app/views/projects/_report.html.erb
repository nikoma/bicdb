<section class="panel report" id="latest_report">
  <span class="eyebrow">BACKGROUND REPORT</span>
  <% if report&.ready? %>
    <h2>The latest snapshot</h2>
    <div class="metrics"><% report.payload.fetch("statuses", {}).each do |status, count| %><div><strong><%= count %></strong><span><%= status.humanize %></span></div><% end %><div><strong><%= report.payload["comments"] %></strong><span>Comments</span></div></div>
    <p class="hint">Generated by Solid Queue, cached in Solid Cache, and broadcast through Solid Cable. All three use BicDB.</p>
  <% elsif report %>
    <h2>Report queued</h2><p class="muted">A background worker will publish the result here. You can also refresh the page.</p>
  <% else %>
    <h2>A clearer view of the work</h2><p class="muted">Generate a report to exercise durable jobs, aggregation, database caching, and live updates.</p>
  <% end %>
</section>
