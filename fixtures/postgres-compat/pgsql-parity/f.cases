vac_cols_missing|CREATE TABLE vac_g(a int);ANALYZE vac_g(nope)
vac_cols_dup|CREATE TABLE vac_h(a int, b int);ANALYZE vac_h(a, b, b)
vac_parallel_full|CREATE TABLE vac_i(a int);VACUUM (PARALLEL 2, FULL TRUE) vac_i
vac_parallel_noval|CREATE TABLE vac_j(a int);VACUUM (PARALLEL) vac_j
vac_parallel_neg|CREATE TABLE vac_k(a int);VACUUM (PARALLEL -1) vac_k
vac_only_db_stats|CREATE TABLE vac_l(a int);VACUUM (ONLY_DATABASE_STATS);VACUUM (ONLY_DATABASE_STATS) vac_l
vac_view|CREATE TABLE vac_m(a int);CREATE VIEW vac_mv AS SELECT * FROM vac_m;VACUUM vac_mv;ANALYZE vac_mv
