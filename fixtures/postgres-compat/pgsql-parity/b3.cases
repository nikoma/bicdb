types.casts_typmod|SELECT 'x'::varchar(3), 'ab'::char(4), 1.5::numeric(5,2), now()::timestamp(0), '1 day'::interval, B'101'::bit(3), 'x'::varchar, 1::numeric \gdesc
types.table_columns|CREATE TABLE tt1(v varchar(10), n numeric(8,2), c char(3), ts timestamp(3), tz timestamptz, d date, i2 int2, i4 int4, i8 int8, f4 float4, f8 float8, b bool, t text, j jsonb, u uuid, arr int[]); SELECT * FROM tt1 \gdesc
types.arithmetic|SELECT 1::int2 + 1::int2, 1::int2 + 1, 1 + 1::int8, 1 + 1.5, 1 * 2.0::float8, 1::int4 / 2, 2::numeric / 3, 1::float4 + 1, 10 % 3, 2 ^ 3, -1::int2, 1.5::float4 * 2::float4 \gdesc
types.date_functions|SELECT date_trunc('day', '2024-01-02'::date), date_trunc('day', now()), date_trunc('day', '2024-01-02 10:00'::timestamp), '2024-01-02'::date + 1, '2024-01-02'::date - '2024-01-01'::date, '2024-01-02'::date + interval '1 day', now() - interval '1 h', age('2024-01-02'::timestamp, '2024-01-01'::timestamp), extract(year FROM now()), date_part('year', now()), to_char(now(), 'YYYY'), current_date, current_timestamp, localtimestamp, make_date(2024, 1, 2) \gdesc
types.string_functions|SELECT upper('a'), length('abc'), substr('abc', 1, 2), position('b' IN 'abc'), concat('a', 1), 'a' || 'b', repeat('a', 2), left('abc', 1), lpad('a', 3), replace('a', 'a', 'b'), split_part('a,b', ',', 1), strpos('ab', 'b'), md5('a'), char_length('ab'), octet_length('ab'), initcap('ab'), trim('a') \gdesc
types.case_coalesce|SELECT CASE WHEN true THEN 1 ELSE 2.5 END, CASE WHEN true THEN 1 ELSE 2::int8 END, coalesce(1, 2.5), coalesce(NULL, 'x'), coalesce(1::int2, 2), greatest(1, 2.5), least(1::int8, 2), nullif(1, 2), CASE WHEN true THEN 'a' END \gdesc
types.aggregates|CREATE TABLE ta(i2 int2, i4 int4, i8 int8, n numeric, f4 float4, f8 float8, t text); SELECT sum(i2), sum(i4), sum(i8), sum(n), sum(f4), sum(f8), avg(i2), avg(i4), avg(i8), avg(f4), avg(f8), count(*), count(i4), min(i4), max(t), string_agg(t, ','), array_agg(i4), bool_and(i4 > 0) FROM ta \gdesc
types.aggregates_typeof|CREATE TABLE tb(i4 int4, n numeric(6,2)); INSERT INTO tb VALUES (1, 1.5); SELECT pg_typeof(sum(i4)), pg_typeof(avg(i4)), pg_typeof(count(*)), pg_typeof(sum(n)), pg_typeof(max(n)) FROM tb
types.typeof_expressions|SELECT pg_typeof(1), pg_typeof(1.5), pg_typeof(1::int2 + 1), pg_typeof(1 / 2), pg_typeof(now()), pg_typeof(current_date + 1), pg_typeof(date_trunc('day', current_date)), pg_typeof(true), pg_typeof(ARRAY[1]), pg_typeof(NULL), pg_typeof(2^2)
types.ctas_column_types|CREATE TABLE tc AS SELECT 'x'::varchar(3) AS v, date_trunc('day', '2024-01-02'::date) AS dt, 1::int2 + 1::int2 AS i2, coalesce(1, 2.5) AS co, CASE WHEN true THEN 1 ELSE 2::int8 END AS ca, 1.5::numeric(5,2) AS n; SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'tc'::regclass AND attnum > 0 ORDER BY attnum
types.subquery_and_union|CREATE TABLE tu(i int4, v varchar(5)); SELECT (SELECT max(i) FROM tu), v FROM tu UNION ALL SELECT 1::int8, 'abc' \gdesc
types.json_functions|SELECT '{"a":1}'::jsonb -> 'a', '{"a":1}'::jsonb ->> 'a', '{"a":1}'::json -> 'a', jsonb_build_object('a', 1), to_jsonb(1), json_agg(1), jsonb_array_length('[1]') \gdesc
types.misc_functions|SELECT round(1.5), round(1.55, 1), round(1.5::float8), abs(-1), abs(-1.5), ceil(1.5), floor(1.5::float8), sqrt(4), random(), trunc(1.5), mod(5, 2), power(2, 3), generate_series(1, 2), gen_random_uuid(), now()::time, to_number('1', '9'), to_date('2024-01-01', 'YYYY-MM-DD'), to_timestamp(0) \gdesc
types.values_describe|VALUES (1, 'a', 1.5), (2, 'b', 2) \gdesc
types.values_describe_cast|VALUES (1::int8, 'a'::varchar) \gdesc
types.from_query_casts|CREATE TABLE tq(v text, n numeric, d date); SELECT v::varchar(4), n::numeric(6,1), date_trunc('day', d), d::timestamp(2) FROM tq \gdesc
types.date_trunc_value|SELECT date_trunc('day', '2024-01-02'::date), date_trunc('month', '2024-03-15 10:00'::timestamp)
fk.self_reference_one_statement|CREATE TABLE fk_tree(id int PRIMARY KEY, parent int REFERENCES fk_tree); INSERT INTO fk_tree VALUES (1, NULL), (2, 1), (3, 2); SELECT * FROM fk_tree ORDER BY id
fk.self_reference_forward|CREATE TABLE fk_fw(id int PRIMARY KEY, parent int REFERENCES fk_fw); INSERT INTO fk_fw VALUES (2, 1), (1, NULL); SELECT count(*) FROM fk_fw
fk.self_reference_missing|CREATE TABLE fk_m(id int PRIMARY KEY, parent int REFERENCES fk_m); SELECT 'start'; INSERT INTO fk_m VALUES (1, NULL), (2, 9)
fk.update_shift_both|CREATE TABLE fk_u(id int PRIMARY KEY, parent int REFERENCES fk_u); INSERT INTO fk_u VALUES (1, NULL), (2, 1); UPDATE fk_u SET parent = parent + 10, id = id + 10; SELECT * FROM fk_u ORDER BY id
fk.update_child_to_new_row|CREATE TABLE fk_c(id int PRIMARY KEY, parent int REFERENCES fk_c); INSERT INTO fk_c VALUES (1, NULL), (2, 1); UPDATE fk_c SET parent = 2 WHERE id = 1; SELECT * FROM fk_c ORDER BY id
fk.cascade_delete|CREATE TABLE fk_p(id int PRIMARY KEY); CREATE TABLE fk_ch(p int REFERENCES fk_p ON DELETE CASCADE, q int); INSERT INTO fk_p VALUES (1), (2); INSERT INTO fk_ch VALUES (1, 1), (2, 2), (1, 3); DELETE FROM fk_p WHERE id = 1; SELECT * FROM fk_ch ORDER BY q
fk.set_null_delete|CREATE TABLE fk_sp(id int PRIMARY KEY); CREATE TABLE fk_sc(p int REFERENCES fk_sp ON DELETE SET NULL, q int); INSERT INTO fk_sp VALUES (1); INSERT INTO fk_sc VALUES (1, 1); DELETE FROM fk_sp; SELECT * FROM fk_sc
fk.self_cascade_delete|CREATE TABLE fk_sd(id int PRIMARY KEY, parent int REFERENCES fk_sd ON DELETE CASCADE); INSERT INTO fk_sd VALUES (1, NULL), (2, 1), (3, 2); DELETE FROM fk_sd WHERE id = 1; SELECT count(*) FROM fk_sd
copy.csv_header|CREATE TABLE ch(a int, b text); INSERT INTO ch VALUES (1, 'x'), (2, NULL), (3, ''); COPY ch TO STDOUT WITH (FORMAT csv, HEADER)
copy.text_header|CREATE TABLE cth(a int, "B c" text); INSERT INTO cth VALUES (1, 'x'); COPY cth TO STDOUT WITH (HEADER)
copy.query_csv_header|COPY (SELECT 1 AS one, 'a,b' AS two) TO STDOUT WITH (FORMAT csv, HEADER true)
copy.binary_out|CREATE TABLE cb(a int, b text, c int8, d bool, e float8); INSERT INTO cb VALUES (1, 'x', 5, true, 1.5), (NULL, NULL, NULL, NULL, NULL); COPY cb TO STDOUT WITH (FORMAT binary)
copy.binary_legacy_keyword|CREATE TABLE cbl(a int); INSERT INTO cbl VALUES (7); COPY cbl TO STDOUT BINARY
colpriv.select_granted_columns|DROP ROLE IF EXISTS cp_r1; CREATE ROLE cp_r1; CREATE TABLE cp_t1(id int, name text, secret text); INSERT INTO cp_t1 VALUES (1, 'a', 's'); GRANT SELECT (id, name) ON cp_t1 TO cp_r1; SET ROLE cp_r1; SELECT id, name FROM cp_t1; SELECT name FROM cp_t1 WHERE id = 1; SELECT count(*) FROM cp_t1
colpriv.select_other_column_denied|DROP ROLE IF EXISTS cp_r2; CREATE ROLE cp_r2; CREATE TABLE cp_t2(id int, secret text); GRANT SELECT (id) ON cp_t2 TO cp_r2; SET ROLE cp_r2; SELECT 'start'; SELECT secret FROM cp_t2
colpriv.select_star_denied|DROP ROLE IF EXISTS cp_r3; CREATE ROLE cp_r3; CREATE TABLE cp_t3(id int, secret text); GRANT SELECT (id) ON cp_t3 TO cp_r3; SET ROLE cp_r3; SELECT 'start'; SELECT * FROM cp_t3
colpriv.where_denied|DROP ROLE IF EXISTS cp_r4; CREATE ROLE cp_r4; CREATE TABLE cp_t4(id int, secret text); GRANT SELECT (id) ON cp_t4 TO cp_r4; SET ROLE cp_r4; SELECT 'start'; SELECT id FROM cp_t4 WHERE secret = 'x'
colpriv.whole_row_denied|DROP ROLE IF EXISTS cp_r5; CREATE ROLE cp_r5; CREATE TABLE cp_t5(id int, secret text); GRANT SELECT (id) ON cp_t5 TO cp_r5; SET ROLE cp_r5; SELECT 'start'; SELECT row_to_json(cp_t5) FROM cp_t5
colpriv.subquery_denied|DROP ROLE IF EXISTS cp_r6; CREATE ROLE cp_r6; CREATE TABLE cp_t6(id int, secret text); INSERT INTO cp_t6 VALUES (1, 's'); GRANT SELECT (id) ON cp_t6 TO cp_r6; SET ROLE cp_r6; SELECT 'start'; SELECT (SELECT max(secret) FROM cp_t6)
colpriv.insert_columns|DROP ROLE IF EXISTS cp_r7; CREATE ROLE cp_r7; CREATE TABLE cp_t7(id int, name text, secret text DEFAULT 'd'); GRANT INSERT (id, name) ON cp_t7 TO cp_r7; SET ROLE cp_r7; INSERT INTO cp_t7 (id, name) VALUES (1, 'a'); INSERT INTO cp_t7 VALUES (2, 'b'); RESET ROLE; SELECT * FROM cp_t7 ORDER BY id
colpriv.insert_column_denied|DROP ROLE IF EXISTS cp_r8; CREATE ROLE cp_r8; CREATE TABLE cp_t8(id int, secret text); GRANT INSERT (id) ON cp_t8 TO cp_r8; SET ROLE cp_r8; SELECT 'start'; INSERT INTO cp_t8 (id, secret) VALUES (1, 'x')
colpriv.update_columns|DROP ROLE IF EXISTS cp_r9; CREATE ROLE cp_r9; CREATE TABLE cp_t9(id int, name text, secret text); INSERT INTO cp_t9 VALUES (1, 'a', 's'); GRANT UPDATE (name) ON cp_t9 TO cp_r9; GRANT SELECT (id) ON cp_t9 TO cp_r9; SET ROLE cp_r9; UPDATE cp_t9 SET name = 'b' WHERE id = 1; RESET ROLE; SELECT * FROM cp_t9
colpriv.update_where_needs_select|DROP ROLE IF EXISTS cp_r10; CREATE ROLE cp_r10; CREATE TABLE cp_t10(id int, name text); INSERT INTO cp_t10 VALUES (1, 'a'); GRANT UPDATE (name) ON cp_t10 TO cp_r10; SET ROLE cp_r10; SELECT 'start'; UPDATE cp_t10 SET name = 'b' WHERE id = 1
colpriv.update_no_read_allowed|DROP ROLE IF EXISTS cp_r11; CREATE ROLE cp_r11; CREATE TABLE cp_t11(id int, name text); INSERT INTO cp_t11 VALUES (1, 'a'); GRANT UPDATE (name) ON cp_t11 TO cp_r11; SET ROLE cp_r11; UPDATE cp_t11 SET name = 'z'; RESET ROLE; SELECT * FROM cp_t11
colpriv.returning_denied|DROP ROLE IF EXISTS cp_r12; CREATE ROLE cp_r12; CREATE TABLE cp_t12(id int, secret text); GRANT INSERT ON cp_t12 TO cp_r12; GRANT SELECT (id) ON cp_t12 TO cp_r12; SET ROLE cp_r12; INSERT INTO cp_t12 VALUES (1, 'a') RETURNING id; SELECT 'next'; INSERT INTO cp_t12 VALUES (2, 'b') RETURNING secret
colpriv.revoke|DROP ROLE IF EXISTS cp_r13; CREATE ROLE cp_r13; CREATE TABLE cp_t13(id int, secret text); GRANT SELECT (id, secret) ON cp_t13 TO cp_r13; REVOKE SELECT (secret) ON cp_t13 FROM cp_r13; SET ROLE cp_r13; SELECT id FROM cp_t13; SELECT 'next'; SELECT secret FROM cp_t13
colpriv.table_revoke_removes_columns|DROP ROLE IF EXISTS cp_r14; CREATE ROLE cp_r14; CREATE TABLE cp_t14(id int); GRANT SELECT (id) ON cp_t14 TO cp_r14; REVOKE SELECT ON cp_t14 FROM cp_r14; SET ROLE cp_r14; SELECT 'start'; SELECT id FROM cp_t14
colpriv.has_column_privilege|DROP ROLE IF EXISTS cp_r15; CREATE ROLE cp_r15; CREATE TABLE cp_t15(id int, secret text); GRANT SELECT (id) ON cp_t15 TO cp_r15; SELECT has_column_privilege('cp_r15', 'cp_t15', 'id', 'SELECT'), has_column_privilege('cp_r15', 'cp_t15', 'secret', 'SELECT'), has_column_privilege('cp_r15', 'cp_t15', 'id', 'UPDATE'), has_any_column_privilege('cp_r15', 'cp_t15', 'SELECT'), has_column_privilege('cp_t15', 'secret', 'SELECT')
colpriv.information_schema|DROP ROLE IF EXISTS cp_r16; CREATE ROLE cp_r16; CREATE TABLE cp_t16(id int, secret text); GRANT SELECT (id), UPDATE (secret) ON cp_t16 TO cp_r16; SELECT grantee, column_name, privilege_type, is_grantable FROM information_schema.column_privileges WHERE table_name = 'cp_t16' AND grantee = 'cp_r16' ORDER BY column_name, privilege_type
colpriv.missing_column_grant|DROP ROLE IF EXISTS cp_r17; CREATE ROLE cp_r17; CREATE TABLE cp_t17(id int); SELECT 'start'; GRANT SELECT (nope) ON cp_t17 TO cp_r17
colpriv.join_using_denied|DROP ROLE IF EXISTS cp_r18; CREATE ROLE cp_r18; CREATE TABLE cp_a(id int, secret text); CREATE TABLE cp_b(secret text); GRANT SELECT (id) ON cp_a TO cp_r18; GRANT SELECT ON cp_b TO cp_r18; SET ROLE cp_r18; SELECT 'start'; SELECT id FROM cp_a JOIN cp_b USING (secret)
