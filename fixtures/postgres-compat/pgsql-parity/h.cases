type.alter_column_denied|drop role if exists h4u11; create role h4u11; grant create on schema public to h4u11; create domain h4d11 as int; revoke usage on domain h4d11 from public; create table h4t11 (a int); alter table h4t11 owner to h4u11; set role h4u11; alter table h4t11 alter column a type h4d11
type.composite_attr_denied|drop role if exists h4u12; create role h4u12; grant create on schema public to h4u12; create domain h4d12 as int; revoke usage on domain h4d12 from public; set role h4u12; create type h4ty12 as (a int, b h4d12)
type.has_type_privilege|drop role if exists h4u13; create role h4u13; create domain h4d13 as int; revoke usage on domain h4d13 from public; select has_type_privilege('h4u13', 'h4d13', 'USAGE'); grant usage on domain h4d13 to h4u13; select has_type_privilege('h4u13', 'h4d13', 'USAGE')
type.array_of_denied|drop role if exists h4u14; create role h4u14; grant create on schema public to h4u14; create type h4ty14 as (a int); revoke usage on type h4ty14 from public; set role h4u14; create table h4t14 (a h4ty14[])
