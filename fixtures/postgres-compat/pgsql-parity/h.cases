role.pg_read_all_settings|drop role if exists h4u27; create role h4u27; grant pg_read_all_settings to h4u27; set role h4u27; select pg_has_role('h4u27', 'pg_read_all_settings', 'member')
role.pg_maintain|drop role if exists h4u28; create role h4u28; create table h4t28 (a int); grant pg_maintain to h4u28; set role h4u28; analyze h4t28; select 1
role.pg_maintain_no_select|drop role if exists h4u29; create role h4u29; create table h4t29 (a int); grant pg_maintain to h4u29; set role h4u29; select * from h4t29
role.maintain_privilege|drop role if exists h4u30; create role h4u30; create table h4t30 (a int); grant maintain on h4t30 to h4u30; select has_table_privilege('h4u30', 'h4t30', 'MAINTAIN'); set role h4u30; analyze h4t30; select 1
role.pg_signal_backend_member|drop role if exists h4u31; create role h4u31; grant pg_signal_backend to h4u31; select pg_has_role('h4u31', 'pg_signal_backend', 'member'), pg_has_role('h4u31', 'pg_read_all_data', 'member')
role.predefined_exist|select rolname from pg_roles where rolname in ('pg_read_all_data', 'pg_write_all_data', 'pg_maintain', 'pg_signal_backend', 'pg_read_all_settings', 'pg_read_all_stats', 'pg_monitor', 'pg_database_owner') order by 1
role.predefined_cannot_login|select rolname, rolcanlogin, rolsuper from pg_roles where rolname in ('pg_read_all_data', 'pg_write_all_data') order by 1
