agg.basic_sfunc|CREATE FUNCTION add_sq(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq(int) (sfunc = add_sq, stype = int, initcond = '0'); SELECT sumsq(x) FROM generate_series(1,3) x
agg.group_by|CREATE FUNCTION add_sq2(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq2(int) (sfunc = add_sq2, stype = int, initcond = '0'); CREATE TABLE aggt(g text, v int); INSERT INTO aggt VALUES ('a',1),('a',2),('b',3); SELECT g, sumsq2(v) FROM aggt GROUP BY g ORDER BY g
agg.null_initcond|CREATE FUNCTION mx(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT CASE WHEN s IS NULL OR x > s THEN x ELSE s END'; CREATE AGGREGATE mymax(int) (sfunc = mx, stype = int); SELECT mymax(x), mymax(x) FILTER (WHERE x < 3) FROM generate_series(1,4) x; SELECT mymax(x) FROM generate_series(1,0) x
agg.finalfunc|CREATE FUNCTION avg_acc(s float8[], x float8) RETURNS float8[] LANGUAGE sql AS 'SELECT ARRAY[s[1] + x, s[2] + 1]'; CREATE FUNCTION avg_fin(s float8[]) RETURNS float8 LANGUAGE sql AS 'SELECT CASE WHEN s[2] = 0 THEN NULL ELSE s[1] / s[2] END'; CREATE AGGREGATE myavg(float8) (sfunc = avg_acc, stype = float8[], finalfunc = avg_fin, initcond = '{0,0}'); SELECT myavg(x) FROM generate_series(1,4) x
agg.order_by|CREATE FUNCTION cat_acc(s text, x text) RETURNS text LANGUAGE sql AS 'SELECT CASE WHEN s IS NULL THEN x ELSE s || '','' || x END'; CREATE AGGREGATE mycat(text) (sfunc = cat_acc, stype = text); SELECT mycat(x ORDER BY x DESC) FROM (VALUES ('a'),('c'),('b')) t(x)
agg.window|CREATE FUNCTION add_sq3(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq3(int) (sfunc = add_sq3, stype = int, initcond = '0'); SELECT x, sumsq3(x) OVER (ORDER BY x) FROM generate_series(1,3) x
agg.strict_sfunc|CREATE FUNCTION smax(s int, x int) RETURNS int LANGUAGE sql STRICT AS 'SELECT greatest(s, x)'; CREATE AGGREGATE smax_agg(int) (sfunc = smax, stype = int); SELECT smax_agg(x) FROM (VALUES (NULL::int),(3),(NULL),(5),(2)) t(x)
agg.catalog|CREATE FUNCTION add_sq4(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq4(int) (sfunc = add_sq4, stype = int, initcond = '0'); SELECT aggfnoid::regproc, aggtransfn::regproc, aggtranstype::regtype, agginitval, aggkind FROM pg_aggregate WHERE aggfnoid = 'sumsq4'::regproc; SELECT proname, prokind FROM pg_proc WHERE proname = 'sumsq4'
agg.drop|CREATE FUNCTION add_sq5(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq5(int) (sfunc = add_sq5, stype = int, initcond = '0'); DROP AGGREGATE sumsq5(int); SELECT sumsq5(1)
agg.drop_missing|DROP AGGREGATE nosuchagg(int)
agg.duplicate|CREATE FUNCTION add_sq6(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq6(int) (sfunc = add_sq6, stype = int); CREATE AGGREGATE sumsq6(int) (sfunc = add_sq6, stype = int)
agg.combine_plpgsql|CREATE FUNCTION pl_acc(s bigint, x int) RETURNS bigint LANGUAGE plpgsql AS $$BEGIN RETURN coalesce(s,0) + x; END$$; CREATE AGGREGATE plsum(int) (sfunc = pl_acc, stype = bigint, combinefunc = int8pl); SELECT plsum(x) FROM generate_series(1,10) x
op.basic|CREATE FUNCTION int_dist(a int, b int) RETURNS int LANGUAGE sql AS 'SELECT abs(a - b)'; CREATE OPERATOR <-> (leftarg = int, rightarg = int, function = int_dist, commutator = <->); SELECT 3 <-> 7, 7 <-> 3
op.where_orderby|CREATE FUNCTION int_dist2(a int, b int) RETURNS int LANGUAGE sql AS 'SELECT abs(a - b)'; CREATE OPERATOR ### (leftarg = int, rightarg = int, function = int_dist2); CREATE TABLE opt(v int); INSERT INTO opt VALUES (1),(5),(9); SELECT v FROM opt WHERE v ### 4 < 3 ORDER BY v ### 6
op.prefix|CREATE FUNCTION neg_text(t text) RETURNS text LANGUAGE sql AS 'SELECT reverse(t)'; CREATE OPERATOR ~~~ (rightarg = text, function = neg_text); SELECT ~~~ 'abc'
op.order_by_using|CREATE FUNCTION mylt(a int, b int) RETURNS bool LANGUAGE sql AS 'SELECT a > b'; CREATE OPERATOR <<< (leftarg = int, rightarg = int, function = mylt); SELECT x FROM generate_series(1,3) x ORDER BY x USING <
op.catalog|CREATE FUNCTION int_dist3(a int, b int) RETURNS int LANGUAGE sql AS 'SELECT abs(a - b)'; CREATE OPERATOR @@@ (leftarg = int, rightarg = int, function = int_dist3, commutator = @@@); SELECT oprname, oprkind, oprleft::regtype, oprright::regtype, oprresult::regtype, oprcode::regproc FROM pg_operator WHERE oprname = '@@@'
op.drop|CREATE FUNCTION int_dist4(a int, b int) RETURNS int LANGUAGE sql AS 'SELECT abs(a - b)'; CREATE OPERATOR %%% (leftarg = int, rightarg = int, function = int_dist4); DROP OPERATOR %%% (int, int); SELECT 1 %%% 2
op.negator|CREATE FUNCTION int_eqx(a int, b int) RETURNS bool LANGUAGE sql AS 'SELECT a = b'; CREATE FUNCTION int_nex(a int, b int) RETURNS bool LANGUAGE sql AS 'SELECT a <> b'; CREATE OPERATOR === (leftarg = int, rightarg = int, function = int_eqx, negator = !==); CREATE OPERATOR !== (leftarg = int, rightarg = int, function = int_nex, negator = ===); SELECT 1 === 1, 1 !== 1, NOT (1 === 2)
cast.with_function|CREATE TYPE money2 AS (cents int); CREATE FUNCTION int_to_m2(i int) RETURNS money2 LANGUAGE sql AS 'SELECT ROW(i * 100)::money2'; CREATE CAST (int AS money2) WITH FUNCTION int_to_m2(int); SELECT (5::money2).cents
cast.inout|CREATE TYPE mood AS ENUM ('sad','ok','happy'); CREATE CAST (text AS mood) WITH INOUT AS ASSIGNMENT; CREATE TABLE castt(m mood); INSERT INTO castt VALUES ('ok'::text); SELECT m FROM castt
cast.implicit|CREATE DOMAIN posint AS int; CREATE FUNCTION txt_to_int(t text) RETURNS int LANGUAGE sql AS 'SELECT length(t)'; CREATE TYPE wrap AS (v int); CREATE FUNCTION wrap_from_int(i int) RETURNS wrap LANGUAGE sql AS 'SELECT ROW(i)::wrap'; CREATE CAST (int AS wrap) WITH FUNCTION wrap_from_int(int) AS IMPLICIT; CREATE FUNCTION takes_wrap(w wrap) RETURNS int LANGUAGE sql AS 'SELECT (w).v'; SELECT takes_wrap(7)
cast.catalog|CREATE TYPE money3 AS (cents int); CREATE FUNCTION int_to_m3(i int) RETURNS money3 LANGUAGE sql AS 'SELECT ROW(i)::money3'; CREATE CAST (int AS money3) WITH FUNCTION int_to_m3(int) AS ASSIGNMENT; SELECT castsource::regtype, casttarget::regtype, castfunc::regproc, castcontext, castmethod FROM pg_cast WHERE casttarget = 'money3'::regtype
cast.drop|CREATE TYPE money4 AS (cents int); CREATE FUNCTION int_to_m4(i int) RETURNS money4 LANGUAGE sql AS 'SELECT ROW(i)::money4'; CREATE CAST (int AS money4) WITH FUNCTION int_to_m4(int); DROP CAST (int AS money4); SELECT 5::money4
cast.duplicate|CREATE TYPE money5 AS (cents int); CREATE FUNCTION int_to_m5(i int) RETURNS money5 LANGUAGE sql AS 'SELECT ROW(i)::money5'; CREATE CAST (int AS money5) WITH FUNCTION int_to_m5(int); CREATE CAST (int AS money5) WITH FUNCTION int_to_m5(int)
unnest.multi|SELECT * FROM unnest(ARRAY[1,2,3], ARRAY['a','b']) AS t(n, s)
unnest.multi_ordinality|SELECT * FROM unnest(ARRAY[1,2], ARRAY['x','y','z']) WITH ORDINALITY AS t(n, s, o)
unnest.multi_lateral|CREATE TABLE unt(id int, a int[], b text[]); INSERT INTO unt VALUES (1, '{1,2}', '{x}'), (2, '{}', '{y,z}'); SELECT unt.id, u.* FROM unt, unnest(unt.a, unt.b) AS u(n, s) ORDER BY 1, 2, 3
unnest.rows_from|SELECT * FROM ROWS FROM (generate_series(1,3), unnest(ARRAY['a','b'])) AS t(n, s)
cursor.savepoint|BEGIN; DECLARE s1 CURSOR FOR SELECT 1; SAVEPOINT sp; DECLARE s2 CURSOR FOR SELECT 2; ROLLBACK TO SAVEPOINT sp; SELECT name FROM pg_cursors ORDER BY name; FETCH s1; FETCH s2
cursor.for_update_fetched|CREATE TABLE cufl(id int PRIMARY KEY, v int); INSERT INTO cufl VALUES (1,1),(2,2); BEGIN; DECLARE cf CURSOR FOR SELECT id FROM cufl ORDER BY id FOR UPDATE; FETCH 1 FROM cf; COMMIT
json.table_sibling_nested|SELECT * FROM JSON_TABLE('{"a":[1,2],"b":["x"]}', '$' COLUMNS (NESTED PATH '$.a[*]' COLUMNS (a int PATH '$'), NESTED PATH '$.b[*]' COLUMNS (b text PATH '$')))
json.table_passing|SELECT * FROM JSON_TABLE('[1,5,9]', '$[*] ? (@ > $min)' PASSING 3 AS min COLUMNS (v int PATH '$'))
json.table_on_error|SELECT * FROM JSON_TABLE('{"a":1}', '$.a[*]' COLUMNS (v int PATH '$') ERROR ON ERROR)
json.table_on_error_strict|SELECT * FROM JSON_TABLE('{"a":1}', 'strict $.b' COLUMNS (v int PATH '$') ERROR ON ERROR)
snapshot.export|BEGIN ISOLATION LEVEL REPEATABLE READ; SELECT length(pg_export_snapshot()) > 0; COMMIT
snapshot.set_outside|SET TRANSACTION SNAPSHOT '00000003-0000001B-1'
snapshot.set_bad_id|BEGIN ISOLATION LEVEL REPEATABLE READ; SET TRANSACTION SNAPSHOT 'nonsense'
snapshot.set_missing|BEGIN ISOLATION LEVEL REPEATABLE READ; SET TRANSACTION SNAPSHOT '00000003-0000001B-1'
snapshot.read_committed|BEGIN; SET TRANSACTION SNAPSHOT '00000003-0000001B-1'
agg.persist_and_privilege|CREATE FUNCTION add_sq7(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq7(int) (sfunc = add_sq7, stype = int, initcond = '0'); CREATE ROLE aggr_r; REVOKE EXECUTE ON FUNCTION sumsq7(int) FROM PUBLIC; SET ROLE aggr_r; SELECT sumsq7(x) FROM generate_series(1,2) x
agg.distinct|CREATE FUNCTION cnt_acc(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + 1'; CREATE AGGREGATE mycount(int) (sfunc = cnt_acc, stype = int, initcond = '0'); SELECT mycount(x), mycount(DISTINCT x) FROM (VALUES (1),(1),(2)) t(x)
agg.rollback|BEGIN; CREATE FUNCTION add_sq8(s int, x int) RETURNS int LANGUAGE sql AS 'SELECT s + x*x'; CREATE AGGREGATE sumsq8(int) (sfunc = add_sq8, stype = int, initcond = '0'); ROLLBACK; SELECT count(*) FROM pg_proc WHERE proname = 'sumsq8'
cast.rollback|CREATE TYPE money6 AS (cents int); CREATE FUNCTION int_to_m6(i int) RETURNS money6 LANGUAGE sql AS 'SELECT ROW(i)::money6'; BEGIN; CREATE CAST (int AS money6) WITH FUNCTION int_to_m6(int); ROLLBACK; SELECT count(*) FROM pg_cast WHERE casttarget = 'money6'::regtype
unnest.rows_from_ordinality|SELECT * FROM ROWS FROM (generate_series(1,2), generate_series(10,12)) WITH ORDINALITY AS t(a, b, o)
