role.pg_read_all_data|drop role if exists h4u20; create role h4u20; create table h4t20 (a int); insert into h4t20 values (1); grant pg_read_all_data to h4u20; set role h4u20; select * from h4t20
role.pg_read_all_data_no_write|drop role if exists h4u21; create role h4u21; create table h4t21 (a int); grant pg_read_all_data to h4u21; set role h4u21; insert into h4t21 values (1)
role.pg_write_all_data|drop role if exists h4u22; create role h4u22; create table h4t22 (a int); grant pg_write_all_data to h4u22; set role h4u22; insert into h4t22 values (1); update h4t22 set a = 2; delete from h4t22
