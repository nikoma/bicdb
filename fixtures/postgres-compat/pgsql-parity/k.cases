jp.dt_iso_types|SET timezone = 'UTC'; SELECT jsonb_path_query('"2017-03-10"', '$.datetime().type()'); SELECT jsonb_path_query('"2017-03-10 12:34:56"', '$.datetime()'); SELECT jsonb_path_query('"2017-03-10 12:34:56+3"', '$.datetime()'); SELECT jsonb_path_query('"2017-03-10T12:34:56.789+3:10"', '$.datetime()'); SELECT jsonb_path_query('"2017-03-10T12:34:56.789EST"', '$.datetime()'); SELECT jsonb_path_query('"12:34:56+3:10"', '$.datetime()'); SELECT jsonb_path_query('"12:34:56"', '$.datetime().type()')
jp.dt_templates|SELECT jsonb_path_query('"10-03-2017"', '$.datetime("dd-mm-yyyy")'); SELECT jsonb_path_query('"10-03-2017 12:34 +05:20"', '$.datetime("dd-mm-yyyy HH24:MI TZH:TZM")'); SELECT jsonb_path_query('"12:34 -05"', '$.datetime("HH24:MI TZH")'); SELECT jsonb_path_query('"10-03-2017T12:34:56"', '$.datetime("dd-mm-yyyy\"T\"HH24:MI:SS")')
jp.dt_template_errors|SELECT jsonb_path_query('"10-03-2017 12:34"', '$.datetime("dd-mm-yyyy")')
jp.dt_unmatched_char|SELECT jsonb_path_query('"10-03-2017t12:34:56"', '$.datetime("dd-mm-yyyy\"T\"HH24:MI:SS")')
jp.dt_bad_separator|SELECT jsonb_path_query('"12:34"', '$.datetime("aaa")')
jp.dt_too_short|SELECT jsonb_path_query('"12:34"', '$.datetime("HH24:MI TZH")')
jp.dt_bogus|SELECT jsonb_path_query('"bogus"', '$.datetime()')
jp.dt_not_string|SELECT jsonb_path_query('1', '$.datetime()')
jp.dt_lax_array|SELECT count(*) FROM jsonb_path_query('[]', '$.datetime()'); SELECT jsonb_path_query_array('["2017-03-10", "12:34:56"]', '$.datetime().type()'); SELECT jsonb_path_query_array('[1, "yes", false]', '$[*].string()')
jp.date_methods|SELECT jsonb_path_query('"2023-08-15"', '$.date()'); SELECT jsonb_path_query('"2023-08-15 12:34:56"', '$.date()'); SELECT jsonb_path_query_tz('"2023-08-15 12:34:56 +05:30"', '$.date()'); SELECT jsonb_path_query('"2023-08-15"', '$.date().type()')
jp.date_tz_error|SELECT jsonb_path_query('"2023-08-15 12:34:56 +05:30"', '$.date()')
jp.date_tz_error_silent|SELECT jsonb_path_query('"2023-08-15 12:34:56 +05:30"', '$.date()', silent => true)
jp.date_not_recognized|SELECT jsonb_path_query('"12:34:56"', '$.date()')
jp.time_methods|SELECT jsonb_path_query('"12:34:56"', '$.time()'); SELECT jsonb_path_query_tz('"12:34:56 +05:30"', '$.time()'); SELECT jsonb_path_query('"2023-08-15 12:34:56"', '$.time()'); SELECT jsonb_path_query('"12:34:56.789"', '$.time(0)'); SELECT jsonb_path_query('"12:34:56.789"', '$.time(2)'); SELECT jsonb_path_query('"12:34:56.789"', '$.time(5)')
jp.time_precision_warning|SELECT jsonb_path_query('"12:34:56.789012"', '$.time(8)'); SELECT jsonb_path_query('"12:34:56.789 +05:30"', '$.time_tz(10)')
jp.time_precision_range|SELECT jsonb_path_query('"12:34:56.789"', '$.time(12345678901)')
jp.time_negative_syntax|SELECT jsonb_path_query('"12:34:56.789"', '$.time(-1)')
jp.time_fraction_syntax|SELECT jsonb_path_query('"12:34:56.789"', '$.time(2.0)')
jp.date_arg_syntax|SELECT jsonb_path_query('"2023-08-15"', '$.date(2)')
jp.timetz_methods|SELECT jsonb_path_query('"12:34:56 +05:30"', '$.time_tz()'); SELECT jsonb_path_query('"12:34:56 +05:30"', '$.time_tz().type()'); SELECT jsonb_path_query('"12:34:56.789 +05:30"', '$.time_tz(2)')
jp.timetz_from_date|SELECT jsonb_path_query('"2023-08-15"', '$.time_tz()')
jp.timestamp_methods|SELECT jsonb_path_query('"2023-08-15 12:34:56"', '$.timestamp()'); SELECT jsonb_path_query('"2023-08-15"', '$.timestamp()'); SELECT jsonb_path_query('"2023-08-15 12:34:56.789"', '$.timestamp(0)'); SELECT jsonb_path_query('"2023-08-15 12:34:56.789012"', '$.timestamp(8)'); SELECT jsonb_path_query_tz('"2023-08-15 12:34:56 +05:30"', '$.timestamp()')
jp.timestamptz_methods|SET timezone = 'PST8PDT'; SELECT jsonb_path_query('"2023-08-15 12:34:56 +05:30"', '$.timestamp_tz()'); SELECT jsonb_path_query_tz('"2023-08-15"', '$.timestamp_tz()'); SELECT jsonb_path_query_tz('"2023-08-15 12:34:56"', '$.timestamp_tz()'); SELECT jsonb_path_query('"2023-08-15 12:34:56.789 +05:30"', '$.timestamp_tz(2)')
jp.timestamptz_from_date_error|SELECT jsonb_path_query('"2023-08-15"', '$.timestamp_tz()')
jp.string_of_datetimes|BEGIN; SET LOCAL timezone = 'UTC'; SET LOCAL datestyle = 'German'; SELECT jsonb_path_query('"2023-08-15 12:34:56 +5:30"', '$.timestamp_tz().string()'); SELECT jsonb_path_query('"2023-08-15 12:34:56"', '$.timestamp().string()'); SELECT jsonb_path_query('"12:34:56 +5:30"', '$.time_tz().string()'); SELECT jsonb_path_query('"2023-08-15"', '$.date().string()'); ROLLBACK
jp.timetz_absorbs_zone|BEGIN; SET LOCAL timezone = 'UTC-10'; SELECT jsonb_path_query_tz('"12:34:56"', '$.time_tz().string()'); ROLLBACK
jp.compare_dates|SET timezone = '+00'; SELECT jsonb_path_query('["2017-03-10", "2017-03-11", "2017-03-09", "12:34:56", "01:02:03+04", "2017-03-10 00:00:00", "2017-03-10 12:34:56", "2017-03-10 01:02:03+04", "2017-03-10 03:00:00+03"]', '$[*].datetime() ? (@ == "10.03.2017".datetime("dd.mm.yyyy"))')
jp.compare_dates_tz|SET timezone = '+00'; SELECT jsonb_path_query_tz('["2017-03-10", "2017-03-11", "2017-03-09", "12:34:56", "01:02:03+04", "2017-03-10 00:00:00", "2017-03-10 12:34:56", "2017-03-10 01:02:03+04", "2017-03-10 03:00:00+03"]', '$[*].datetime() ? (@ >= "10.03.2017".datetime("dd.mm.yyyy"))')
jp.compare_dates_error|SET timezone = '+00'; SELECT jsonb_path_query('["2017-03-10 01:02:03+04"]', '$[*].datetime() ? (@ >= "10.03.2017".datetime("dd.mm.yyyy"))')
jp.compare_times_tz|SET timezone = '+00'; SELECT jsonb_path_query_tz('["12:34:00", "12:35:00", "12:36:00", "12:35:00 +00", "12:35:00 +01", "13:35:00 +01", "2017-03-10", "2017-03-10 12:35:00", "2017-03-10 12:35:00 +01"]', '$[*].time_tz() ? (@ >= "12:35:00 +1".time_tz())')
jp.compare_timestamps|SET timezone = '+00'; SELECT jsonb_path_query_tz('["2017-03-10 12:34:00", "2017-03-10 12:35:00", "2017-03-10 12:36:00", "2017-03-10 12:35:00 +01", "2017-03-10 13:35:00 +01", "2017-03-10 12:35:00 -01", "2017-03-10", "2017-03-11", "12:34:56", "12:34:56 +01"]', '$[*].datetime() ? (@ < "10.03.2017 12:35".datetime("dd.mm.yyyy HH24:MI"))')
jp.compare_big_year|SELECT jsonb_path_query('"1000000-01-01"', '$.datetime() > "2020-01-01 12:00:00".datetime()'::jsonpath)
jp.exists_operator|SELECT jsonb '"10-03-2017"' @? '$.datetime("dd-mm-yyyy")', jsonb '"12:34:56 +05:30"' @? '$.time_tz()'
jp.print_methods|SELECT '$.datetime("dd-mm-yyyy").time(3).timestamp_tz(2)'::jsonpath, '$.date().type()'::jsonpath
dt.between_symmetric|SELECT 5 BETWEEN SYMMETRIC 10 AND 1, 5 BETWEEN 10 AND 1, 5 NOT BETWEEN SYMMETRIC 10 AND 1, 5 BETWEEN ASYMMETRIC 1 AND 10, 5 BETWEEN SYMMETRIC NULL AND 10, 50 BETWEEN SYMMETRIC (CASE WHEN true AND true THEN 100 END) AND 1
dt.between_symmetric_dates|CREATE TABLE k_bs (d date); INSERT INTO k_bs VALUES ('1997-01-02'), ('1997-01-05'), ('1998-01-01'); SELECT d FROM k_bs WHERE d BETWEEN SYMMETRIC '1997-01-31' AND '1997-01-01' ORDER BY d; SELECT d FROM k_bs WHERE d NOT BETWEEN SYMMETRIC '1997-01-31' AND '1997-01-01' ORDER BY d
