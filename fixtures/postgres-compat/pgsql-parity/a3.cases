only.select|CREATE TABLE o1p(a int); CREATE TABLE o1c(b int) INHERITS (o1p); INSERT INTO o1p VALUES (1); INSERT INTO o1c VALUES (2, 2); SELECT a FROM ONLY o1p; SELECT count(*) FROM o1p; SELECT x.a FROM ONLY o1p x; SELECT t.a FROM o1c t JOIN ONLY o1p p ON true ORDER BY 1
only.update_delete|CREATE TABLE o2p(a int); CREATE TABLE o2c(b int) INHERITS (o2p); INSERT INTO o2p VALUES (1); INSERT INTO o2c VALUES (2, 2); UPDATE ONLY o2p SET a = a + 10; SELECT a FROM o2p ORDER BY a; DELETE FROM ONLY o2p WHERE a > 0; SELECT a FROM o2p ORDER BY a; UPDATE ONLY o2p SET a = 0 RETURNING a
only.partitioned_parent|CREATE TABLE o3(a int) PARTITION BY RANGE (a); CREATE TABLE o3a PARTITION OF o3 FOR VALUES FROM (0) TO (10); INSERT INTO o3 VALUES (1); SELECT count(*) FROM ONLY o3; SELECT count(*) FROM o3
noinherit.create|CREATE TABLE ni1p(a int, CONSTRAINT ni1_pos CHECK (a > 0) NO INHERIT, CHECK (a < 100)); CREATE TABLE ni1c() INHERITS (ni1p); INSERT INTO ni1c VALUES (-5); SELECT conname, connoinherit FROM pg_constraint WHERE conrelid='ni1p'::regclass ORDER BY 1; SELECT count(*) FROM pg_constraint WHERE conrelid='ni1c'::regclass AND contype='c'; INSERT INTO ni1p VALUES (-5)
noinherit.alter_add|CREATE TABLE ni2p(a int); CREATE TABLE ni2c() INHERITS (ni2p); ALTER TABLE ni2p ADD CONSTRAINT ni2_pos CHECK (a > 0) NO INHERIT; INSERT INTO ni2c VALUES (-1); INSERT INTO ni2p VALUES (-1)
alter_inherit.attach_detach|CREATE TABLE ai1p(a int, b text); CREATE TABLE ai1c(a int, b text, c int); INSERT INTO ai1c VALUES (1, 'x', 2); ALTER TABLE ai1c INHERIT ai1p; SELECT a FROM ai1p; ALTER TABLE ai1c NO INHERIT ai1p; SELECT count(*) FROM ai1p
alter_inherit.missing_column|CREATE TABLE ai2p(a int, b text); CREATE TABLE ai2c(a int); ALTER TABLE ai2c INHERIT ai2p
alter_inherit.circular|CREATE TABLE ai3p(a int); CREATE TABLE ai3c() INHERITS (ai3p); ALTER TABLE ai3p INHERIT ai3c
alter_inherit.not_parent|CREATE TABLE ai4p(a int); CREATE TABLE ai4c(a int); ALTER TABLE ai4c NO INHERIT ai4p
drop_cascade.parent|CREATE TABLE dc1p(a int); CREATE TABLE dc1c(b int) INHERITS (dc1p); CREATE TABLE dc1g(c int) INHERITS (dc1c); DROP TABLE dc1p CASCADE; SELECT count(*) FROM pg_class WHERE relname IN ('dc1p','dc1c','dc1g')
rename.hierarchy|CREATE TABLE rn1p(a int); CREATE TABLE rn1c(b int) INHERITS (rn1p); INSERT INTO rn1c VALUES (1, 2); ALTER TABLE rn1p RENAME TO rn1pp; ALTER TABLE rn1c RENAME TO rn1cc; SELECT a FROM rn1pp; SELECT c.relname, p.relname FROM pg_inherits i JOIN pg_class c ON c.oid=i.inhrelid JOIN pg_class p ON p.oid=i.inhparent WHERE p.relname='rn1pp'
inherit.empty_column_list|CREATE TABLE ec1p(a int); CREATE TABLE ec1c () INHERITS (ec1p); INSERT INTO ec1c VALUES (3); SELECT a FROM ec1p
unlogged.quoted_default|CREATE UNLOGGED TABLE uq1(a text DEFAULT 'it''s', b int GENERATED ALWAYS AS (1)); INSERT INTO uq1 DEFAULT VALUES; SELECT a, b FROM uq1
noinherit.not_null|CREATE TABLE nn1p(a int NOT NULL NO INHERIT, b int NOT NULL); CREATE TABLE nn1c() INHERITS (nn1p); SELECT column_name, is_nullable FROM information_schema.columns WHERE table_name='nn1c' ORDER BY ordinal_position
only.with_tableoid|CREATE TABLE ot1p(a int); CREATE TABLE ot1c(b int) INHERITS (ot1p); INSERT INTO ot1p VALUES (1); INSERT INTO ot1c VALUES (2, 2); SELECT relname, x.* FROM ONLY ot1p x, pg_class WHERE x.tableoid = pg_class.oid; SELECT count(*) FROM ot1c c LEFT JOIN ONLY ot1p p ON p.a = c.a
