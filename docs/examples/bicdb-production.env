# Safe production defaults for a 100GB greenfield database deployment.
# Secret values are not stored here; the names below must be backed by the
# host secret manager, systemd credentials, or container secret injection.
BICDB_DB_PATH=/var/lib/bicdb/database
BICDB_HOST=0.0.0.0
BICDB_PORT=5433
BICDB_PROFILE=production-server
BICDB_AUTH_METHOD=scram-sha-256
BICDB_MAX_CONNECTIONS=1000
BICDB_MAX_ACTIVE_QUERIES=32
BICDB_MAX_QUEUED_QUERIES=128
BICDB_MAX_ACTIVE_READS=32
BICDB_MAX_QUEUED_READS=128
BICDB_MAX_ACTIVE_WRITES=16
BICDB_MAX_QUEUED_WRITES=64
BICDB_IDLE_TIMEOUT_SECONDS=300
BICDB_SHUTDOWN_GRACE_SECONDS=30
BICDB_QUERY_TIMEOUT_MS=30000
BICDB_OVERLOAD_TIMEOUT_MS=5000
BICDB_WRITE_TIMEOUT_MS=30000
BICDB_MAX_RESULT_ROWS=100000
BICDB_MAX_REQUEST_BYTES=10485760
BICDB_PER_CONNECTION_MEMORY_LIMIT=16777216
BICDB_TLS_CERT=/etc/bicdb/tls/server.pem
BICDB_TLS_KEY=/etc/bicdb/tls/server-key.pem
BICDB_SLOW_QUERY_LOG=/var/log/bicdb/slow-query.jsonl
BICDB_SLOW_QUERY_THRESHOLD_MS=1000
BICDB_DB_KEY_ENV=BICDB_DB_KEY
BICDB_BACKUP_KEY_ENV=BICDB_BACKUP_KEY
BICDB_PROTECTED_DATA_EVIDENCE=/var/lib/bicdb/evidence/protected-data-release-gate.json
BICDB_DEPENDENCY_EVIDENCE=/var/lib/bicdb/evidence/dependency-audit.json
