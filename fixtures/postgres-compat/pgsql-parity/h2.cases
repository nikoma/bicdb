priv.analyze_denied|drop role if exists h7u6; create role h7u6; create table h7t6 (a int); set role h7u6; analyze h7t6
priv.pg_stats_filtered|drop role if exists h7u7; create role h7u7; create table h7t7 (a int); insert into h7t7 select g from generate_series(1, 50) g; analyze h7t7; set role h7u7; select count(*) from pg_stats where tablename = 'h7t7'
priv.pg_stats_visible_with_select|drop role if exists h7u8; create role h7u8; create table h7t8 (a int, b int); insert into h7t8 select g, g from generate_series(1, 50) g; analyze h7t8; grant select (a) on h7t8 to h7u8; set role h7u8; select attname from pg_stats where tablename = 'h7t8' order by 1
priv.aclitem_text|drop role if exists h7u9; create role h7u9; create table h7t9 (a int); grant select, insert on h7t9 to h7u9; select relacl::text from pg_class where relname = 'h7t9'
priv.aclitem_array_type|drop role if exists h7u10; create role h7u10; create domain h7d10 as int; revoke usage on domain h7d10 from public; grant usage on domain h7d10 to h7u10; select typacl::text from pg_type where typname = 'h7d10'
priv.granted_by_self|drop role if exists h7u11; drop role if exists h7u12; create role h7u11; create role h7u12; create table h7t11 (a int); alter table h7t11 owner to h7u11; set role h7u11; grant select on h7t11 to h7u12 granted by h7u11; reset role; select has_table_privilege('h7u12', 'h7t11', 'SELECT')
