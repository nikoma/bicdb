<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.bicdb.examples</groupId>
  <artifactId>oracle-jdbc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>BicDB Oracle preview JDBC adapter</name>
  <description>Explicit Oracle preview submission over PostgreSQL JDBC.</description>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license></licenses>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.8</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/../..</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include></includes></resource>
    </resources>
    <plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
      <configuration><archive><manifestEntries>
        <Bundle-ManifestVersion>2</Bundle-ManifestVersion>
        <Bundle-SymbolicName>org.bicdb.jdbc.oracle</Bundle-SymbolicName>
        <Bundle-Version>0.1.0</Bundle-Version>
        <Export-Package>org.bicdb.jdbc.oracle;version="0.1.0"</Export-Package>
        <Require-Bundle>org.postgresql.jdbc;bundle-version="[42.7.8,42.7.9)"</Require-Bundle>
        <Import-Package>javax.sql.rowset.serial</Import-Package>
      </manifestEntries></archive></configuration>
    </plugin>
  </plugins></build>
</project>
