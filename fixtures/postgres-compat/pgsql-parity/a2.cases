pgcrypto.digest_hmac|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT encode(digest('abc','sha256'),'hex'), encode(digest('abc'::bytea,'md5'),'hex'), encode(digest('abc','sha1'),'hex'), encode(digest('abc','sha512'),'hex'), encode(digest('abc','sha224'),'hex'), encode(digest('abc','sha384'),'hex'); SELECT encode(hmac('data','key','sha256'),'hex'), encode(hmac('data'::bytea,'key'::bytea,'md5'),'hex')
pgcrypto.random|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT length(gen_random_bytes(16)), length(gen_random_uuid()::text), pg_typeof(gen_random_bytes(4))
pgcrypto.crypt_known_bf|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('secret', '$2a$06$Q9a1mKpJ.ZZRYlG4RJ7PEOwVtWyg/eVpXYHdxXGxzqhr1Xh0GjU4q') = '$2a$06$Q9a1mKpJ.ZZRYlG4RJ7PEOwVtWyg/eVpXYHdxXGxzqhr1Xh0GjU4q'
pgcrypto.crypt_md5_salt|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('secret', '$1$saltsalt$'), crypt('secret', '$1$abc$'), crypt('', '$1$x$')
pgcrypto.crypt_bf_salt|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('secret', '$2a$06$abcdefghijklmnopqrstuu'), crypt('password', '$2a$10$1234567890123456789012')
pgcrypto.crypt_des_xdes|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('secret', 'ab'), crypt('password', '_J9..rsalt'), crypt('verylongpassword', '_J9..abcd')
pgcrypto.gen_salt_shapes|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT length(gen_salt('bf')), left(gen_salt('bf'),7), left(gen_salt('bf', 8),7), length(gen_salt('md5')), left(gen_salt('md5'),3), length(gen_salt('des')), length(gen_salt('xdes')), left(gen_salt('xdes'),5)
pgcrypto.roundtrip|CREATE EXTENSION IF NOT EXISTS pgcrypto; CREATE TABLE pw(h text); INSERT INTO pw VALUES (crypt('s3cret', gen_salt('bf', 4))), (crypt('s3cret', gen_salt('md5'))), (crypt('s3cret', gen_salt('xdes'))), (crypt('s3cret', gen_salt('des'))); SELECT h = crypt('s3cret', h), h = crypt('wrong', h) FROM pw
pgcrypto.gen_salt_bad|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT gen_salt('nope')
pgcrypto.bf_bad_rounds|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT gen_salt('bf', 3)
pgcrypto.encode_decode|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT encode(digest('x','sha256'),'base64'), decode(encode(gen_random_bytes(0),'hex'),'hex')
pgcrypto.crypt_variants|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('U*U', '$2a$05$CCCCCCCCCCCCCCCCCCCCC.'), crypt('U*U', '$2y$05$CCCCCCCCCCCCCCCCCCCCC.'), crypt('', '$2a$05$CCCCCCCCCCCCCCCCCCCCC.'), crypt('password', '$1$saltsaltextra$'), crypt('pässwörd', '$1$abc$'), crypt('test', 'aZ'), crypt('test', 'aZextra')
pgcrypto.crypt_bad_setting|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('x', '$9$abc')
pgcrypto.crypt_2b|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('U*U', '$2b$05$CCCCCCCCCCCCCCCCCCCCC.')
pgcrypto.crypt_2x|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt('U*U', '$2x$05$CCCCCCCCCCCCCCCCCCCCC.')
pgcrypto.gen_salt_sha|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT left(gen_salt('sha256crypt'), 3), length(gen_salt('sha512crypt'))
pgcrypto.gen_salt_rounds_errors|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT gen_salt('xdes', 2)
pgcrypto.gen_salt_md5_rounds|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT length(gen_salt('md5', 1000)), left(gen_salt('md5', 1000), 3)
pgcrypto.null_args|CREATE EXTENSION IF NOT EXISTS pgcrypto; SELECT crypt(NULL, 'ab') IS NULL, crypt('a', NULL) IS NULL, gen_salt(NULL) IS NULL
excl.inline_range|CREATE TABLE ex1(r int4range, EXCLUDE USING gist (r WITH &&)); INSERT INTO ex1 VALUES ('[1,5)'); INSERT INTO ex1 VALUES ('[5,9)'); SELECT count(*) FROM ex1; SELECT conname, contype FROM pg_constraint WHERE conrelid='ex1'::regclass
excl.inline_range_violation|CREATE TABLE ex2(r int4range, EXCLUDE USING gist (r WITH &&)); INSERT INTO ex2 VALUES ('[1,5)'); INSERT INTO ex2 VALUES ('[3,7)')
excl.named_with_equality|CREATE EXTENSION IF NOT EXISTS btree_gist; CREATE TABLE ex3(room int, during tsrange, CONSTRAINT ex3_no_overlap EXCLUDE USING gist (room WITH =, during WITH &&)); INSERT INTO ex3 VALUES (1, '[2024-01-01 10:00, 2024-01-01 11:00)'), (2, '[2024-01-01 10:00, 2024-01-01 11:00)'); INSERT INTO ex3 VALUES (1, '[2024-01-01 10:30, 2024-01-01 12:00)')
excl.same_transaction|CREATE TABLE ex4(r int4range, EXCLUDE USING gist (r WITH &&)); BEGIN; INSERT INTO ex4 VALUES ('[1,5)'); INSERT INTO ex4 VALUES ('[2,3)'); COMMIT
excl.update_shift|CREATE TABLE ex5(id int PRIMARY KEY, r int4range, EXCLUDE USING gist (r WITH &&)); INSERT INTO ex5 VALUES (1,'[1,3)'),(2,'[5,7)'); UPDATE ex5 SET r='[2,4)' WHERE id=1; UPDATE ex5 SET r='[3,6)' WHERE id=1
excl.where_predicate|CREATE TABLE ex6(r int4range, active boolean, EXCLUDE USING gist (r WITH &&) WHERE (active)); INSERT INTO ex6 VALUES ('[1,5)', true), ('[1,5)', false); SELECT count(*) FROM ex6; INSERT INTO ex6 VALUES ('[2,3)', true)
excl.catalog_def|CREATE TABLE ex7(r int4range, CONSTRAINT ex7_r_excl EXCLUDE USING gist (r WITH &&)); SELECT conname, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid='ex7'::regclass
excl.alter_add|CREATE TABLE ex9(r int4range); INSERT INTO ex9 VALUES ('[1,5)'),('[5,6)'); ALTER TABLE ex9 ADD CONSTRAINT ex9_x EXCLUDE USING gist (r WITH &&); INSERT INTO ex9 VALUES ('[0,2)')
unlogged.create|CREATE UNLOGGED TABLE ul1(id int PRIMARY KEY, v text); INSERT INTO ul1 VALUES (1,'a'); SELECT relpersistence FROM pg_class WHERE relname='ul1'; SELECT v FROM ul1
unlogged.set_logged|CREATE UNLOGGED TABLE ul2(id int); ALTER TABLE ul2 SET LOGGED; SELECT relpersistence FROM pg_class WHERE relname='ul2'; ALTER TABLE ul2 SET UNLOGGED; SELECT relpersistence FROM pg_class WHERE relname='ul2'
unlogged.plain_is_permanent|CREATE TABLE ul3(id int); SELECT relpersistence FROM pg_class WHERE relname='ul3'
unlogged.if_not_exists|CREATE TABLE ul4(id int); CREATE UNLOGGED TABLE IF NOT EXISTS ul4(id int); SELECT relpersistence FROM pg_class WHERE relname='ul4'
virtual.explicit|CREATE TABLE vg1(a int, b int GENERATED ALWAYS AS (a * 2) VIRTUAL); INSERT INTO vg1(a) VALUES (3); UPDATE vg1 SET a = 5; SELECT a, b FROM vg1; SELECT attname, attgenerated FROM pg_attribute WHERE attrelid='vg1'::regclass AND attnum > 0 ORDER BY attnum; SELECT column_name, is_generated FROM information_schema.columns WHERE table_name='vg1' ORDER BY ordinal_position
virtual.default_kind|CREATE TABLE vg2(a int, b text GENERATED ALWAYS AS ('x' || a)); INSERT INTO vg2(a) VALUES (1); SELECT b FROM vg2; SELECT attgenerated FROM pg_attribute WHERE attrelid='vg2'::regclass AND attname='b'
virtual.insert_rejected|CREATE TABLE vg3(a int, b int GENERATED ALWAYS AS (a + 1) VIRTUAL); INSERT INTO vg3 VALUES (1, 2)
virtual.add_column|CREATE TABLE vg4(a int); INSERT INTO vg4 VALUES (2); ALTER TABLE vg4 ADD COLUMN b int GENERATED ALWAYS AS (a * 10) VIRTUAL; SELECT a, b FROM vg4; SELECT attgenerated FROM pg_attribute WHERE attrelid='vg4'::regclass AND attname='b'
virtual.index_refused|CREATE TABLE vg5(a int, b int GENERATED ALWAYS AS (a + 1) VIRTUAL); CREATE INDEX vg5_b ON vg5 (b)
virtual.stored_still_stored|CREATE TABLE vg6(a int, b int GENERATED ALWAYS AS (a + 1) STORED); SELECT attgenerated FROM pg_attribute WHERE attrelid='vg6'::regclass AND attname='b'
virtual.string_untouched|CREATE TABLE vg7(a text DEFAULT 'GENERATED ALWAYS AS (1) VIRTUAL', b int GENERATED ALWAYS AS (length(a)) VIRTUAL); INSERT INTO vg7 DEFAULT VALUES; SELECT a, b FROM vg7
