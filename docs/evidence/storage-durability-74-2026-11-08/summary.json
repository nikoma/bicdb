{
 "fix": "#74 frame-log torn-tail repair and mid-file damage refusal",
 "merge_commit": "d0cf59b3",
 "remaining_risks": [
  "torn writes/damage produced by file edits after kill, not by real power loss or media errors",
  "salvage_frame_log and operator procedure not exercised",
  "event log, audit outbox, compressed/encrypted frames not covered",
  "plain-SIGKILL recovery of server_paged stress stores unreliable at this revision (3 of 300 trials here)"
 ],
 "observations": [
  "a refused open appends incarnations.log (53/89) and on paged stores runs page recovery and a checkpoint first (store.pages changed 41/44), including when transactions.log is the damaged file",
  "event log never held a frame in this workload",
  "verifier does not read frame logs"
 ],
 "production_qualification": false,
