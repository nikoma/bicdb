join.using|CREATE TABLE lhs(k int,j int); CREATE TABLE rhs(k int,n int,j int); INSERT INTO lhs SELECT i,i%2 FROM generate_series(1,10000) s(i); INSERT INTO rhs SELECT i,i,0 FROM generate_series(1,10000) s(i); INSERT INTO rhs VALUES (2,2,0),(NULL,0,0); INSERT INTO lhs VALUES (NULL,0); SELECT count(*) FROM lhs l JOIN rhs r USING(k); SELECT count(*) FROM lhs l JOIN rhs r USING(k,j); SELECT count(*) FROM lhs l LEFT JOIN rhs r USING(k,j) WHERE r.n IS NULL;
